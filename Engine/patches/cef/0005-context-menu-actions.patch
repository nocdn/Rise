+namespace {
+
+// The frame a client names, if it's this process's and still there.
+content::RenderFrameHost* FrameHost(CefRefPtr<CefFrame> frame) {
+  auto impl = frame ? static_cast<CefFrameHostImpl*>(frame.get()) : nullptr;
+  return impl ? impl->GetRenderFrameHost() : nullptr;
+}
+
+}  // namespace
+
+void CefBrowserHostBase::CopyImageAt(CefRefPtr<CefFrame> frame, int x, int y) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  if (auto* host = FrameHost(frame)) {
+    host->CopyImageAt(x, y);
+  }
 }
 
+void CefBrowserHostBase::InspectElementAt(CefRefPtr<CefFrame> frame,
+                                          int x,
+                                          int y) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  auto contents = GetWebContents();
+  auto* host = FrameHost(frame);
+  if (contents && host) {
+    content::DevToolsAgentHost::GetOrCreateFor(contents)->InspectElement(host,
+                                                                       x, y);
+  }
+}
+
+void CefBrowserHostBase::LookUpSelection(CefRefPtr<CefFrame> frame) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return;
+  }
+  auto* host = FrameHost(frame);
+  auto* view = host ? host->GetRenderWidgetHost()->GetView() : nullptr;
+  if (view) {
+    view->ShowDefinitionForSelection();
+  }
+}
