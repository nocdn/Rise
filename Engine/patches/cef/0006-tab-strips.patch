+// The client window's tabs, as the client reports them; what extensions ask of
+// them goes to the client.
+class EmbedderTabList : public TabListInterface {
+ public:
+  EmbedderTabList(BrowserWindowInterface* window,
+                  CefRefPtr<CefTabStripDelegate> delegate)
+      : window_(window), delegate_(delegate) {}
+  ~EmbedderTabList() override {
+    for (TabListInterfaceObserver& observer : observers_) {
+      observer.OnTabListDestroyed(*this);
+    }
+  }
+
+  // Takes the client's tabs, telling observers what changed: tabs removed,
+  // added and moved, then which is in front.
+  void SetTabs(const std::vector<content::WebContents*>& contents,
+               int pinned_count,
+               int active_index) {
+    std::set<content::WebContents*> kept(contents.begin(), contents.end());
+    // Tabs gone.
+    for (size_t i = 0; i < tabs_.size();) {
+      if (kept.count(tabs_[i]->GetContents())) {
+        ++i;
+        continue;
+      }
+      std::unique_ptr<EmbedderTab> tab = std::move(tabs_[i]);
+      tabs_.erase(tabs_.begin() + i);
+      if (active_ == tab.get()) {
+        active_ = nullptr;
+      }
+      for (TabListInterfaceObserver& observer : observers_) {
+        observer.OnTabRemoved(*this, tab.get(), TabRemovedReason::kDeleted);
+      }
+    }
+    // The order now, with new tabs made.
+    std::vector<EmbedderTab*> before;
+    for (auto& tab : tabs_) {
+      before.push_back(tab.get());
+    }
+    std::vector<std::unique_ptr<EmbedderTab>> ordered;
+    std::vector<std::pair<EmbedderTab*, int>> added;
+    for (size_t i = 0; i < contents.size(); ++i) {
+      auto it = std::ranges::find_if(tabs_, [&](const auto& tab) {
+        return tab && tab->GetContents() == contents[i];
+      });
+      if (it != tabs_.end()) {
+        ordered.push_back(std::move(*it));
+      } else {
+        ordered.push_back(
+            std::make_unique<EmbedderTab>(window_, delegate_, contents[i]));
+        added.emplace_back(ordered.back().get(), static_cast<int>(i));
+      }
+    }
+    tabs_ = std::move(ordered);
+    for (auto& [tab, index] : added) {
+      for (TabListInterfaceObserver& observer : observers_) {
+        observer.OnTabAdded(*this, tab, index);
+      }
+    }
+    // Tabs that kept their place among the others but moved.
+    for (size_t from = 0; from < before.size(); ++from) {
+      int to = GetIndexOf(before[from]);
+      if (to >= 0 && to != static_cast<int>(from)) {
+        for (TabListInterfaceObserver& observer : observers_) {
+          observer.OnTabMoved(*this, before[from], static_cast<int>(from), to);
+        }
+      }
+    }
+    for (size_t i = 0; i < tabs_.size(); ++i) {
+      tabs_[i]->SetPinned(static_cast<int>(i) < pinned_count);
+    }
+    EmbedderTab* active =
+        active_index >= 0 && active_index < static_cast<int>(tabs_.size())
+            ? tabs_[active_index].get()
+            : nullptr;
+    if (active != active_) {
+      if (active_) {
+        active_->SetActivated(false);
+      }
+      active_ = active;
+      if (active_) {
+        active_->SetActivated(true);
+      }
+      // Observers hear of a tab coming forward; none at all, as while the
+      // client's selected tab is still being made, isn't a change for them.
+      if (active_) {
+        for (TabListInterfaceObserver& observer : observers_) {
+          observer.OnActiveTabChanged(*this, active_);
+        }
+      }
+      active_tab_changed_.Notify(window_);
+    }
+  }
+
+  void SetWindowActive(bool active) {
+    for (TabListInterfaceObserver& observer : observers_) {
+      observer.OnTabListActiveChanged(*this, active);
+    }
+  }
+
+  base::CallbackListSubscription RegisterActiveTabDidChange(
+      BrowserWindowInterface::ActiveTabChangeCallback callback) {
+    return active_tab_changed_.Add(std::move(callback));
+  }
+
+  // TabListInterface:
+  void AddTabListInterfaceObserver(TabListInterfaceObserver* observer) override {
+    observers_.AddObserver(observer);
+  }
+  void RemoveTabListInterfaceObserver(
+      TabListInterfaceObserver* observer) override {
+    observers_.RemoveObserver(observer);
+  }
+  int GetTabCount() const override { return static_cast<int>(tabs_.size()); }
+  int GetActiveIndex() const override { return GetIndexOf(active_); }
+  tabs::TabInterface* GetActiveTab() override { return active_; }
+  void ActivateTab(tabs::TabHandle tab) override {
+    if (auto browser = BrowserFor(tab)) {
+      delegate_->ActivateTab(browser);
+    }
+  }
+  tabs::TabInterface* OpenTab(const GURL& url,
+                              int index,
+                              bool foreground) override {
+    // The client makes the tab, and tells us of it, before returning.
+    auto contents = ContentsOf(delegate_->OpenTab(url.spec(), index, foreground));
+    return contents ? FindTab(contents) : nullptr;
+  }
+  void SetOpenerForTab(tabs::TabHandle target, tabs::TabHandle opener) override {
+  }
+  tabs::TabInterface* GetOpenerForTab(tabs::TabHandle target) override {
+    return nullptr;
+  }
+  tabs::TabInterface* InsertWebContentsAt(
+      int index,
+      std::unique_ptr<content::WebContents> web_contents,
+      bool should_pin,
+      std::optional<tab_groups::TabGroupId> group) override {
+    return nullptr;
+  }
+  content::WebContents* DiscardTab(tabs::TabHandle tab) override {
+    return nullptr;
+  }
+  tabs::TabInterface* DuplicateTab(tabs::TabHandle tab) override {
+    tabs::TabInterface* original = tab.Get();
+    if (!original) {
+      return nullptr;
+    }
+    return OpenTab(original->GetURL(), GetIndexOfTab(tab) + 1, true);
+  }
+  tabs::TabInterface* GetTab(int index) override {
+    return index >= 0 && index < GetTabCount() ? tabs_[index].get() : nullptr;
+  }
+  int GetIndexOfTab(tabs::TabHandle tab) override {
+    return GetIndexOf(tab.Get());
+  }
+  void HighlightTabs(tabs::TabHandle tab_to_activate,
+                     const std::set<tabs::TabHandle>& tabs) override {
+    ActivateTab(tab_to_activate);
+  }
+  void MoveTab(tabs::TabHandle tab, int index) override {
+    if (auto browser = BrowserFor(tab)) {
+      delegate_->MoveTab(browser, index);
+    }
+  }
+  void CloseTab(tabs::TabHandle tab) override {
+    if (auto browser = BrowserFor(tab)) {
+      delegate_->CloseTab(browser);
+    }
+  }
+  std::unique_ptr<content::WebContents> DetachWebContents(
+      tabs::TabHandle tab) override {
+    return nullptr;
+  }
+  std::vector<tabs::TabInterface*> GetAllTabs() override {
+    std::vector<tabs::TabInterface*> all;
+    for (auto& tab : tabs_) {
+      all.push_back(tab.get());
+    }
+    return all;
+  }
+  void PinTab(tabs::TabHandle tab) override {
+    if (auto browser = BrowserFor(tab)) {
+      delegate_->SetTabPinned(browser, true);
+    }
+  }
+  void UnpinTab(tabs::TabHandle tab) override {
+    if (auto browser = BrowserFor(tab)) {
+      delegate_->SetTabPinned(browser, false);
+    }
+  }
+  bool ContainsTabGroup(tab_groups::TabGroupId group_id) override {
+    return false;
+  }
+  std::vector<tab_groups::TabGroupId> ListTabGroups() override { return {}; }
+  std::set<split_tabs::SplitTabId> ListSplits() override { return {}; }
+  std::optional<tab_groups::TabGroupVisualData> GetTabGroupVisualData(
+      tab_groups::TabGroupId group_id) override {
+    return std::nullopt;
+  }
+  gfx::Range GetTabGroupTabIndices(tab_groups::TabGroupId group_id) override {
+    return gfx::Range();
+  }
+  std::optional<tab_groups::TabGroupId> CreateTabGroup(
+      const std::vector<tabs::TabHandle>& tabs) override {
+    return std::nullopt;
+  }
+  std::optional<split_tabs::SplitTabId> CreateSplit(
+      const std::vector<tabs::TabHandle>& tabs) override {
+    return std::nullopt;
+  }
+  void SetTabGroupVisualData(
+      tab_groups::TabGroupId group_id,
+      const tab_groups::TabGroupVisualData& visual_data) override {}
+  std::optional<tab_groups::TabGroupId> AddTabsToGroup(
+      std::optional<tab_groups::TabGroupId> group_id,
+      const std::set<tabs::TabHandle>& tabs) override {
+    return std::nullopt;
+  }
+  void Ungroup(const std::set<tabs::TabHandle>& tabs) override {}
+  void Unsplit(split_tabs::SplitTabId split_id) override {}
+  void MoveGroupTo(tab_groups::TabGroupId group_id, int index) override {}
+  void MoveTabToWindow(tabs::TabHandle tab,
+                       SessionID destination_window_id,
+                       int destination_index) override {}
+  bool MoveTabGroupToWindow(tab_groups::TabGroupId group_id,
+                            SessionID destination_window_id,
+                            int destination_index) override {
+    return false;
+  }
+  bool IsThisTabListEditable() override { return true; }
+  bool IsClosingAllTabs() override { return false; }
+
+ private:
+  int GetIndexOf(const tabs::TabInterface* tab) const {
+    for (size_t i = 0; i < tabs_.size(); ++i) {
+      if (tabs_[i].get() == tab) {
+        return static_cast<int>(i);
+      }
+    }
+    return -1;
+  }
+  EmbedderTab* FindTab(content::WebContents* contents) {
+    for (auto& tab : tabs_) {
+      if (tab->GetContents() == contents) {
+        return tab.get();
+      }
+    }
+    return nullptr;
+  }
+  CefRefPtr<CefBrowser> BrowserFor(tabs::TabHandle handle) {
+    tabs::TabInterface* tab = handle.Get();
+    return tab && GetIndexOf(tab) >= 0 ? BrowserOf(tab->GetContents())
+                                       : nullptr;
+  }
+
+  raw_ptr<BrowserWindowInterface> window_;
+  CefRefPtr<CefTabStripDelegate> delegate_;
+  std::vector<std::unique_ptr<EmbedderTab>> tabs_;
+  raw_ptr<EmbedderTab> active_ = nullptr;
+  base::ObserverList<TabListInterfaceObserver> observers_;
+  base::RepeatingCallbackList<void(BrowserWindowInterface*)>
+      active_tab_changed_;
+};
+
+// The client window as a browser window that only the extension APIs see,
+// through extensions::EmbedderBrowserWindows.
+class EmbedderBrowserWindow : public BrowserWindowInterface {
+ public:
+  EmbedderBrowserWindow(Profile* profile,
+                        CefRefPtr<CefTabStripDelegate> delegate)
+      : profile_(profile),
+        delegate_(delegate),
+        session_id_(SessionID::NewUnique()),
+        base_window_(delegate),
+        tab_list_(this, delegate),
+        tab_list_holder_(user_data_host_, tab_list_),
+        features_(std::make_unique<BrowserWindowFeatures>()) {
+    window_controller_ =
+        std::make_unique<extensions::BrowserExtensionWindowController>(this);
+    window_helper_ =
+        std::make_unique<extensions::ExtensionBrowserWindowHelper>(this,
+                                                                   profile);
+    extensions::EmbedderBrowserWindows::Get().SetTabLookup(
+        base::BindRepeating([](content::WebContents* contents)
+                                -> tabs::TabInterface* {
+          auto& tabs = TabsByContents();
+          auto it = tabs.find(contents);
+          return it != tabs.end() ? it->second : nullptr;
+        }));
+    extensions::EmbedderBrowserWindows::Get().Add(this);
+  }
+  ~EmbedderBrowserWindow() override {
+    closing_ = true;
+    extensions::EmbedderBrowserWindows::Get().Remove(this);
+    did_close_.Notify(this);
+    tab_list_.SetTabs({}, 0, -1);
+    window_helper_.reset();
+    window_controller_.reset();
+  }
+
+  EmbedderTabList& tab_list() { return tab_list_; }
+
+  void SetActive(bool active) {
+    if (active == active_) {
+      return;
+    }
+    active_ = active;
+    base_window_.set_active(active);
+    if (active) {
+      extensions::EmbedderBrowserWindows::Get().Activated(this);
+      did_become_active_.Notify(this);
+    } else {
+      did_become_inactive_.Notify(this);
+    }
+    tab_list_.SetWindowActive(active);
+  }
+  void SetBounds(const gfx::Rect& bounds) { base_window_.set_bounds(bounds); }
+
+  // content::PageNavigator:
+  content::WebContents* OpenURL(
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    tabs::TabInterface* tab = tab_list_.OpenTab(
+        params.url, -1,
+        params.disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB);
+    return tab ? tab->GetContents() : nullptr;
+  }
+
+  // BrowserWindowInterface:
+  ui::UnownedUserDataHost& GetUnownedUserDataHost() override {
+    return user_data_host_;
+  }
+  const ui::UnownedUserDataHost& GetUnownedUserDataHost() const override {
+    return user_data_host_;
+  }
+  ui::BaseWindow* GetWindow() override { return &base_window_; }
+  const ui::BaseWindow* GetWindow() const override { return &base_window_; }
+  Profile* GetProfile() override { return profile_; }
+  const Profile* GetProfile() const override { return profile_; }
+  const SessionID& GetSessionID() const override { return session_id_; }
+  bool IsDeleteScheduled() const override { return closing_; }
+  base::CallbackListSubscription RegisterBrowserDidClose(
+      BrowserDidCloseCallback callback) override {
+    return did_close_.Add(std::move(callback));
+  }
+  Type GetType() const override { return TYPE_NORMAL; }
+  base::WeakPtr<BrowserWindowInterface> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+  void OpenGURL(const GURL& gurl, WindowOpenDisposition disposition) override {
+    tab_list_.OpenTab(gurl, -1,
+                      disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  }
+  TabStripModel* GetTabStripModel() override { return nullptr; }
+  const TabStripModel* GetTabStripModel() const override { return nullptr; }
+  bool IsTabStripVisible() override { return true; }
+  base::CallbackListSubscription RegisterBrowserCloseCancelled(
+      BrowserCloseCancelledCallback callback) override {
+    return {};
+  }
+  base::CallbackListSubscription RegisterActiveTabDidChange(
+      ActiveTabChangeCallback callback) override {
+    return tab_list_.RegisterActiveTabDidChange(std::move(callback));
+  }
+  tabs::TabInterface* GetActiveTabInterface() override {
+    return tab_list_.GetActiveTab();
+  }
+  BrowserWindowFeatures& GetFeatures() override { return *features_; }
+  const BrowserWindowFeatures& GetFeatures() const override {
+    return *features_;
+  }
+  web_modal::WebContentsModalDialogHost*
+  GetWebContentsModalDialogHostForWindow() override {
+    return nullptr;
+  }
+  web_modal::WebContentsModalDialogHost* GetWebContentsModalDialogHostForTab(
+      tabs::TabInterface* tab_interface) override {
+    return nullptr;
+  }
+  bool IsActive() const override { return active_; }
+  base::CallbackListSubscription RegisterDidBecomeActive(
+      DidBecomeActiveCallback callback) override {
+    return did_become_active_.Add(std::move(callback));
+  }
+  base::CallbackListSubscription RegisterDidBecomeInactive(
+      DidBecomeInactiveCallback callback) override {
+    return did_become_inactive_.Add(std::move(callback));
+  }
+  bool IsNormalBrowser() const override { return true; }
+  std::vector<tabs::TabInterface*> GetAllTabInterfaces() override {
+    return tab_list_.GetAllTabs();
+  }
+  bool IsTabModalPopup() const override { return false; }
+  void SetIsTabModalPopup(
+      bool is_tab_modal_popup,
+      base::PassKey<internal::ScopedBrowserShower>) override {}
+  bool CreatedBySessionRestore() const override { return false; }
+  DesktopBrowserWindowCapabilities* capabilities() override { return nullptr; }
+  const DesktopBrowserWindowCapabilities* capabilities() const override {
+    return nullptr;
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  CefRefPtr<CefTabStripDelegate> delegate_;
+  const SessionID session_id_;
+  bool active_ = false;
+  bool closing_ = false;
+  ui::UnownedUserDataHost user_data_host_;
+  EmbedderBaseWindow base_window_;
+  EmbedderTabList tab_list_;
+  ui::ScopedUnownedUserData<TabListInterface> tab_list_holder_;
+  std::unique_ptr<BrowserWindowFeatures> features_;
+  std::unique_ptr<extensions::BrowserExtensionWindowController>
+      window_controller_;
+  std::unique_ptr<extensions::ExtensionBrowserWindowHelper> window_helper_;
+  base::RepeatingCallbackList<void(BrowserWindowInterface*)> did_close_;
+  base::RepeatingCallbackList<void(BrowserWindowInterface*)>
+      did_become_active_;
+  base::RepeatingCallbackList<void(BrowserWindowInterface*)>
+      did_become_inactive_;
+  base::WeakPtrFactory<EmbedderBrowserWindow> weak_factory_{this};
+};
+
+// static
+CefRefPtr<CefTabStrip> CefTabStrip::Create(
+    CefRefPtr<CefTabStripDelegate> delegate) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return nullptr;
+  }
+  if (!delegate) {
+    return nullptr;
+  }
+  return new CefTabStripImpl(delegate);
+}
+
+CefTabStripImpl::CefTabStripImpl(CefRefPtr<CefTabStripDelegate> delegate) {
+  Profile* profile =
+      CefRequestContextImpl::GetProfile(CefRequestContext::GetGlobalContext());
+  if (profile) {
+    window_ = std::make_unique<EmbedderBrowserWindow>(profile, delegate);
+  }
+}
+
+CefTabStripImpl::~CefTabStripImpl() = default;
+
+int CefTabStripImpl::GetWindowId() {
+  return window_ ? window_->GetSessionID().id() : -1;
+}
+
+void CefTabStripImpl::SetTabs(const std::vector<CefRefPtr<CefBrowser>>& tabs,
+                              int pinned_count,
+                              int active_index) {
+  if (!window_ || !CEF_CURRENTLY_ON_UIT()) {
+    return;
+  }
+  std::vector<content::WebContents*> contents;
+  int active = -1;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    if (auto* tab_contents = ContentsOf(tabs[i])) {
+      if (static_cast<int>(i) == active_index) {
+        active = static_cast<int>(contents.size());
+      }
+      contents.push_back(tab_contents);
+    }
+  }
+  window_->tab_list().SetTabs(contents, pinned_count, active);
+}
+
+void CefTabStripImpl::SetActive(bool active) {
+  if (window_ && CEF_CURRENTLY_ON_UIT()) {
+    window_->SetActive(active);
+  }
+}
+
+void CefTabStripImpl::SetBounds(const CefRect& bounds) {
+  if (window_ && CEF_CURRENTLY_ON_UIT()) {
+    window_->SetBounds(
+        gfx::Rect(bounds.x, bounds.y, bounds.width, bounds.height));
+  }
+}
+
+void CefTabStripImpl::Close() {
+  if (CEF_CURRENTLY_ON_UIT()) {
+    window_.reset();
+  }
+}
