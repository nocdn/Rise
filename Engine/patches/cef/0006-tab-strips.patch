+///
+/// Carries out what extensions ask of a client window that holds Alloy style
+/// browsers as its tabs. The methods of this class are called on the browser
+/// process UI thread.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefTabStripDelegate : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Open |url| in a new tab at |index| (-1 for the end), in front if
+  /// |active|. Return the browser made for it, which must already exist (made
+  /// with CefBrowserHost::CreateBrowserSync) and be in the tab strip, or
+  /// nullptr not to open one.
+  ///
+  /*--cef()--*/
+  virtual CefRefPtr<CefBrowser> OpenTab(const CefString& url,
+                                        int index,
+                                        bool active) = 0;
+
+  ///
+  /// Bring |browser|'s tab to the front.
+  ///
+  /*--cef()--*/
+  virtual void ActivateTab(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// Close |browser|'s tab.
+  ///
+  /*--cef()--*/
+  virtual void CloseTab(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// Move |browser|'s tab to |index|.
+  ///
+  /*--cef()--*/
+  virtual void MoveTab(CefRefPtr<CefBrowser> browser, int index) {}
+
+  ///
+  /// Pin or unpin |browser|'s tab.
+  ///
+  /*--cef()--*/
+  virtual void SetTabPinned(CefRefPtr<CefBrowser> browser, bool pinned) {}
+
+  ///
+  /// Bring the window to the front.
+  ///
+  /*--cef()--*/
+  virtual void ActivateWindow() {}
+};
+
+///
+/// A client window holding Alloy style browsers as its tabs, which Chrome
+/// extensions see as a browser window, with those tabs, through the tabs and
+/// windows APIs. The methods of this class must be called on the browser
+/// process UI thread.
+///
+/*--cef(source=library,added=experimental)--*/
+class CefTabStrip : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Creates a window for the global request context's extensions.
+  ///
+  /*--cef()--*/
+  static CefRefPtr<CefTabStrip> Create(CefRefPtr<CefTabStripDelegate> delegate);
+
+  ///
+  /// The window's id, as extensions see it.
+  ///
+  /*--cef()--*/
+  virtual int GetWindowId() = 0;
+
+  ///
+  /// The window's tabs, in order: the first |pinned_count| are pinned, and
+  /// the one at |active_index| is in front (-1 for none).
+  ///
+  /*--cef()--*/
+  virtual void SetTabs(const std::vector<CefRefPtr<CefBrowser>>& tabs,
+                       int pinned_count,
+                       int active_index) = 0;
+
+  ///
+  /// Whether the window is the active one.
+  ///
+  /*--cef()--*/
+  virtual void SetActive(bool active) = 0;
+
+  ///
+  /// The window's bounds on screen.
+  ///
+  /*--cef()--*/
+  virtual void SetBounds(const CefRect& bounds) = 0;
+
+  ///
+  /// Removes the window, as when it's closed.
+  ///
+  /*--cef()--*/
+  virtual void Close() = 0;
+};
+
+#endif  // CEF_INCLUDE_CEF_TAB_STRIP_H_
