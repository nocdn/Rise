+class CefTabStripImpl : public CefTabStrip {
+ public:
+  explicit CefTabStripImpl(CefRefPtr<CefTabStripDelegate> delegate);
+  ~CefTabStripImpl() override;
+
+  CefTabStripImpl(const CefTabStripImpl&) = delete;
+  CefTabStripImpl& operator=(const CefTabStripImpl&) = delete;
+
+  // CefTabStrip methods.
+  int GetWindowId() override;
+  void SetTabs(const std::vector<CefRefPtr<CefBrowser>>& tabs,
+               int pinned_count,
+               int active_index) override;
+  void SetActive(bool active) override;
+  void SetBounds(const CefRect& bounds) override;
+  void Close() override;
+
+ private:
+  std::unique_ptr<EmbedderBrowserWindow> window_;
+
+  IMPLEMENT_REFCOUNTING_DELETE_ON_UIT(CefTabStripImpl);
+};
