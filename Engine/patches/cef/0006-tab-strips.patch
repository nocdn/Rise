+// One of the client window's tabs: an Alloy style browser's WebContents.
+class EmbedderTab : public tabs::TabInterface {
+ public:
+  EmbedderTab(BrowserWindowInterface* window,
+              CefRefPtr<CefTabStripDelegate> delegate,
+              content::WebContents* contents)
+      : window_(window), delegate_(delegate), contents_(contents) {
+    TabsByContents()[contents] = this;
+    // The tabs API reports the window a tab is in from the tab's session data.
+    if (auto* helper = sessions::SessionTabHelper::FromWebContents(contents)) {
+      helper->SetWindowID(window->GetSessionID());
+    }
+  }
+  ~EmbedderTab() override {
+    auto& tabs = TabsByContents();
+    auto it = tabs.find(contents_);
+    if (it != tabs.end() && it->second == this) {
+      tabs.erase(it);
+    }
+  }
+
+  void SetPinned(bool pinned) {
+    if (pinned == pinned_) {
+      return;
+    }
+    pinned_ = pinned;
+    pinned_state_changed_.Notify(this, pinned);
+  }
+  void SetActivated(bool active) {
+    if (active == active_) {
+      return;
+    }
+    if (!active) {
+      will_deactivate_.Notify(this);
+    }
+    active_ = active;
+    if (active) {
+      last_active_ = base::Time::Now();
+      did_activate_.Notify(this);
+    }
+  }
+
+  // tabs::TabInterface:
+  base::WeakPtr<tabs::TabInterface> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+  content::WebContents* GetContents() const override { return contents_; }
+  void LoadIfNeeded() override {}
+  std::u16string GetTitle() const override { return contents_->GetTitle(); }
+  GURL GetURL() const override { return contents_->GetVisibleURL(); }
+  base::Time GetLastActiveTime() const override { return last_active_; }
+  Profile* GetProfile() const override {
+    return Profile::FromBrowserContext(contents_->GetBrowserContext());
+  }
+  void Close() override {
+    if (auto browser = BrowserOf(contents_)) {
+      delegate_->CloseTab(browser);
+    }
+  }
+  base::CallbackListSubscription RegisterWillDiscardContents(
+      WillDiscardContentsCallback callback) override {
+    return {};
+  }
+  bool IsActivated() const override { return active_; }
+  base::CallbackListSubscription RegisterDidActivate(
+      DidActivateCallback callback) override {
+    return did_activate_.Add(std::move(callback));
+  }
+  base::CallbackListSubscription RegisterWillDeactivate(
+      WillDeactivateCallback callback) override {
+    return will_deactivate_.Add(std::move(callback));
+  }
+  bool IsVisible() const override { return active_; }
+  bool IsSelected() const override { return active_; }
+  base::CallbackListSubscription RegisterDidBecomeVisible(
+      DidBecomeVisibleCallback callback) override {
+    return {};
+  }
+  base::CallbackListSubscription RegisterWillBecomeHidden(
+      WillBecomeHiddenCallback callback) override {
+    return {};
+  }
+  base::CallbackListSubscription RegisterWillDetach(
+      WillDetach callback) override {
+    return {};
+  }
+  base::CallbackListSubscription RegisterDidInsert(
+      DidInsertCallback callback) override {
+    return {};
+  }
+  base::CallbackListSubscription RegisterPinnedStateChanged(
+      PinnedStateChangedCallback callback) override {
+    return pinned_state_changed_.Add(std::move(callback));
+  }
+  base::CallbackListSubscription RegisterGroupChanged(
+      GroupChangedCallback callback) override {
+    return {};
+  }
+  base::CallbackListSubscription RegisterBlockedStateChanged(
+      BlockedStateChangedCallback callback) override {
+    return {};
+  }
+  bool CanShowModalUI() const override { return true; }
+  std::unique_ptr<tabs::ScopedTabModalUI> ShowModalUI() override {
+    return std::make_unique<tabs::ScopedTabModalUI>();
+  }
+  base::CallbackListSubscription RegisterModalUIChanged(
+      TabInterfaceCallback callback) override {
+    return {};
+  }
+  bool IsInNormalWindow() const override { return true; }
+  BrowserWindowInterface* GetBrowserWindowInterface() override {
+    return window_;
+  }
+  const BrowserWindowInterface* GetBrowserWindowInterface() const override {
+    return window_;
+  }
+  tabs::TabFeatures* GetTabFeatures() override { return nullptr; }
+  const tabs::TabFeatures* GetTabFeatures() const override { return nullptr; }
+  bool IsPinned() const override { return pinned_; }
+  bool IsBlocked() const override { return false; }
+  bool IsSplit() const override { return false; }
+  std::optional<tab_groups::TabGroupId> GetGroup() const override {
+    return std::nullopt;
+  }
+  std::optional<split_tabs::SplitTabId> GetSplit() const override {
+    return std::nullopt;
+  }
+  tabs::TabCollection* GetParentCollection(
+      base::PassKey<tabs::TabCollection>) const override {
+    return nullptr;
+  }
+  const tabs::TabCollection* GetParentCollection() const override {
+    return nullptr;
+  }
+  void OnReparented(tabs::TabCollection* parent,
+                    base::PassKey<tabs::TabCollection>) override {}
+  void OnAncestorChanged(base::PassKey<tabs::TabCollection>) override {}
+  ui::UnownedUserDataHost& GetUnownedUserDataHost() override {
+    return user_data_host_;
+  }
+  const ui::UnownedUserDataHost& GetUnownedUserDataHost() const override {
+    return user_data_host_;
+  }
+
+ private:
+  raw_ptr<BrowserWindowInterface> window_;
+  CefRefPtr<CefTabStripDelegate> delegate_;
+  raw_ptr<content::WebContents> contents_;
+  bool pinned_ = false;
+  bool active_ = false;
+  base::Time last_active_;
+  ui::UnownedUserDataHost user_data_host_;
+  base::RepeatingCallbackList<void(tabs::TabInterface*)> did_activate_;
+  base::RepeatingCallbackList<void(tabs::TabInterface*)> will_deactivate_;
+  base::RepeatingCallbackList<void(tabs::TabInterface*, bool)>
+      pinned_state_changed_;
+  base::WeakPtrFactory<EmbedderTab> weak_factory_{this};
+};
