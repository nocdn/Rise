+// Every embedder window's tab, by what it shows, for the extension APIs.
+std::map<content::WebContents*, EmbedderTab*>& TabsByContents() {
+  static base::NoDestructor<std::map<content::WebContents*, EmbedderTab*>>
+      tabs;
+  return *tabs;
+}
+
+content::WebContents* ContentsOf(CefRefPtr<CefBrowser> browser) {
+  auto host = browser ? CefBrowserHostBase::FromBrowser(browser) : nullptr;
+  return host ? host->GetWebContents() : nullptr;
+}
+
+CefRefPtr<CefBrowser> BrowserOf(content::WebContents* contents) {
+  auto host = CefBrowserHostBase::GetBrowserForContents(contents);
+  return host ? host->GetBrowser() : nullptr;
+}
