+#ifndef CEF_INCLUDE_CEF_EXTENSION_ACTION_H_
+#define CEF_INCLUDE_CEF_EXTENSION_ACTION_H_
+#pragma once
+
+#include "include/cef_base.h"
+#include "include/cef_browser.h"
+#include "include/cef_image.h"
+
+///
+/// A Chrome extension's toolbar button, for the client to draw. Values for a
+/// tab take |browser|, the browser showing it; nullptr gives the button's
+/// defaults. The methods of this class must be called on the browser process
+/// UI thread.
+///
+/*--cef(source=library,added=experimental)--*/
+class CefExtensionAction : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// The extension's id.
+  ///
+  /*--cef()--*/
+  virtual CefString GetExtensionId() = 0;
+
+  ///
+  /// The extension's name.
+  ///
+  /*--cef()--*/
+  virtual CefString GetName() = 0;
+
+  ///
+  /// The button's tooltip.
+  ///
+  /*--cef(optional_param=browser)--*/
+  virtual CefString GetTitle(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// The text of the button's badge; empty for none.
+  ///
+  /*--cef(optional_param=browser)--*/
+  virtual CefString GetBadgeText(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// The badge's background color.
+  ///
+  /*--cef(optional_param=browser)--*/
+  virtual cef_color_t GetBadgeColor(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// The button's icon, which may still be loading (the observer hears when
+  /// it's done); nullptr if there's none yet.
+  ///
+  /*--cef(optional_param=browser)--*/
+  virtual CefRefPtr<CefImage> GetIcon(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// Whether the button works in this tab.
+  ///
+  /*--cef(optional_param=browser)--*/
+  virtual bool IsEnabled(CefRefPtr<CefBrowser> browser) = 0;
+
+  ///
+  /// Clicks the button for |browser|'s tab, giving the extension that tab if
+  /// it asks for the active tab. Returns the address of the popup for the
+  /// client to show, or an empty string if the extension handled the click.
+  ///
+  /*--cef()--*/
+  virtual CefString Execute(CefRefPtr<CefBrowser> browser) = 0;
+};
+
+///
+/// Hears that extensions' toolbar buttons were added, removed or changed. The
+/// methods of this class are called on the browser process UI thread.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefExtensionActionsObserver : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Something about the buttons changed: ask for them again.
+  ///
+  /*--cef()--*/
+  virtual void OnExtensionActionsChanged() = 0;
+};
+
+#endif  // CEF_INCLUDE_CEF_EXTENSION_ACTION_H_
