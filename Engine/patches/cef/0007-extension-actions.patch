+
+#include "cef/libcef/browser/extension_action_impl.h"
+
+#include <set>
+
+#include "base/scoped_multi_source_observation.h"
+#include "base/scoped_observation.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/image_impl.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "chrome/browser/extensions/extension_action_dispatcher.h"
+#include "chrome/browser/extensions/extension_action_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_icon_image.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace cef_extension_actions {
+
+namespace {
+
+// Extensions a person installed, which have toolbar buttons in Chrome.
+const extensions::Extension* ToolbarExtension(Profile* profile,
+                                              const std::string& id) {
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  const extensions::Extension* extension =
+      registry ? registry->enabled_extensions().GetByID(id) : nullptr;
+  if (!extension || !extension->is_extension() ||
+      extensions::Manifest::IsComponentLocation(extension->location())) {
+    return nullptr;
+  }
+  return extension;
+}
+
+content::WebContents* ContentsOf(CefRefPtr<CefBrowser> browser) {
+  auto host = browser ? CefBrowserHostBase::FromBrowser(browser) : nullptr;
+  return host ? host->GetWebContents() : nullptr;
+}
+
+int TabIdOf(CefRefPtr<CefBrowser> browser) {
+  content::WebContents* contents = ContentsOf(browser);
+  return contents ? sessions::SessionTabHelper::IdForTab(contents).id()
+                  : extensions::ExtensionAction::kDefaultTabId;
+}
+
+cef_color_t ToCefColor(SkColor color) {
+  return CefColorSetARGB(SkColorGetA(color), SkColorGetR(color),
+                         SkColorGetG(color), SkColorGetB(color));
+}
+
+class ExtensionActionImpl : public CefExtensionAction {
+ public:
+  ExtensionActionImpl(Profile* profile, const std::string& id)
+      : profile_(profile), id_(id) {}
+
+  ExtensionActionImpl(const ExtensionActionImpl&) = delete;
+  ExtensionActionImpl& operator=(const ExtensionActionImpl&) = delete;
+
+  CefString GetExtensionId() override { return id_; }
+  CefString GetName() override {
+    const extensions::Extension* extension = Extension();
+    return extension ? extension->name() : std::string();
+  }
+  CefString GetTitle(CefRefPtr<CefBrowser> browser) override {
+    auto* action = Action();
+    return action ? action->GetTitle(TabIdOf(browser)) : std::string();
+  }
+  CefString GetBadgeText(CefRefPtr<CefBrowser> browser) override {
+    auto* action = Action();
+    return action ? action->GetDisplayBadgeText(TabIdOf(browser))
+                  : std::string();
+  }
+  cef_color_t GetBadgeColor(CefRefPtr<CefBrowser> browser) override {
+    auto* action = Action();
+    return action ? ToCefColor(action->GetBadgeBackgroundColor(TabIdOf(browser)))
+                  : 0;
+  }
+  CefRefPtr<CefImage> GetIcon(CefRefPtr<CefBrowser> browser) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      return nullptr;
+    }
+    auto* action = Action();
+    if (!action) {
+      return nullptr;
+    }
+    gfx::ImageSkia image;
+    gfx::Image set = action->GetExplicitlySetIcon(TabIdOf(browser));
+    if (!set.IsEmpty()) {
+      image = *set.ToImageSkia();
+    } else if (auto* icon = action->default_icon_image()) {
+      image = icon->image_skia();
+    }
+    if (image.isNull()) {
+      return nullptr;
+    }
+    // Asking for each scale loads it, if it isn't yet.
+    image.GetRepresentation(1.0f);
+    image.GetRepresentation(2.0f);
+    return new CefImageImpl(image);
+  }
+  bool IsEnabled(CefRefPtr<CefBrowser> browser) override {
+    auto* action = Action();
+    return action && action->GetIsVisible(TabIdOf(browser));
+  }
+  CefString Execute(CefRefPtr<CefBrowser> browser) override {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      return std::string();
+    }
+    const extensions::Extension* extension = Extension();
+    auto* action = Action();
+    content::WebContents* contents = ContentsOf(browser);
+    auto* runner =
+        contents ? extensions::ExtensionActionRunner::GetForWebContents(contents)
+                 : nullptr;
+    if (!extension || !action || !runner) {
+      return std::string();
+    }
+    if (runner->RunAction(extension, /*grant_tab_permissions=*/true) !=
+        extensions::ExtensionAction::ShowAction::kShowPopup) {
+      return std::string();
+    }
+    return action->GetPopupUrl(TabIdOf(browser)).spec();
+  }
+
+ private:
+  const extensions::Extension* Extension() {
+    return CEF_CURRENTLY_ON_UIT() ? ToolbarExtension(profile_, id_) : nullptr;
+  }
+  extensions::ExtensionAction* Action() {
+    const extensions::Extension* extension = Extension();
+    return extension ? extensions::ExtensionActionManager::Get(profile_)
+                           ->GetExtensionAction(*extension)
+                     : nullptr;
+  }
+
+  raw_ptr<Profile> profile_;
+  const std::string id_;
+
+  IMPLEMENT_REFCOUNTING_DELETE_ON_UIT(ExtensionActionImpl);
+};
+
+// Tells the client of extensions coming and going, their buttons changing and
+// their icons loading.
+class Registration : public CefRegistration,
+                     public extensions::ExtensionRegistryObserver,
+                     public extensions::ExtensionActionDispatcher::Observer,
+                     public extensions::IconImage::Observer {
+ public:
+  Registration(Profile* profile,
+               CefRefPtr<CefExtensionActionsObserver> observer)
+      : profile_(profile), observer_(observer) {
+    registry_observation_.Observe(extensions::ExtensionRegistry::Get(profile));
+    if (auto* dispatcher = extensions::ExtensionActionDispatcher::Get(profile)) {
+      dispatcher->AddObserver(this);
+      dispatcher_ = dispatcher;
+    }
+    WatchIcons();
+  }
+  ~Registration() override {
+    if (dispatcher_) {
+      dispatcher_->RemoveObserver(this);
+    }
+  }
+
+  Registration(const Registration&) = delete;
+  Registration& operator=(const Registration&) = delete;
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const extensions::Extension* extension) override {
+    Changed();
+  }
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override {
+    Changed();
+  }
+  void OnShutdown(extensions::ExtensionRegistry* registry) override {
+    icon_observations_.RemoveAllObservations();
+    registry_observation_.Reset();
+  }
+
+  // extensions::ExtensionActionDispatcher::Observer:
+  void OnExtensionActionUpdated(
+      extensions::ExtensionAction* extension_action,
+      content::WebContents* web_contents,
+      content::BrowserContext* browser_context) override {
+    Changed();
+  }
+  void OnShuttingDown() override {
+    if (dispatcher_) {
+      dispatcher_->RemoveObserver(this);
+      dispatcher_ = nullptr;
+    }
+  }
+
+  // extensions::IconImage::Observer:
+  void OnExtensionIconImageChanged(extensions::IconImage* image) override {
+    observer_->OnExtensionActionsChanged();
+  }
+  void OnExtensionIconImageDestroyed(extensions::IconImage* image) override {
+    if (icon_observations_.IsObservingSource(image)) {
+      icon_observations_.RemoveObservation(image);
+    }
+  }
+
+ private:
+  void Changed() {
+    WatchIcons();
+    observer_->OnExtensionActionsChanged();
+  }
+  void WatchIcons() {
+    auto* registry = extensions::ExtensionRegistry::Get(profile_);
+    if (!registry) {
+      return;
+    }
+    for (const auto& extension : registry->enabled_extensions()) {
+      if (!ToolbarExtension(profile_, extension->id())) {
+        continue;
+      }
+      auto* action = extensions::ExtensionActionManager::Get(profile_)
+                         ->GetExtensionAction(*extension);
+      auto* icon = action ? action->default_icon_image() : nullptr;
+      if (icon && !icon_observations_.IsObservingSource(icon)) {
+        icon_observations_.AddObservation(icon);
+      }
+    }
+  }
+
+  raw_ptr<Profile> profile_;
+  CefRefPtr<CefExtensionActionsObserver> observer_;
+  raw_ptr<extensions::ExtensionActionDispatcher> dispatcher_ = nullptr;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+  base::ScopedMultiSourceObservation<extensions::IconImage,
+                                     extensions::IconImage::Observer>
+      icon_observations_{this};
+
+  IMPLEMENT_REFCOUNTING_DELETE_ON_UIT(Registration);
+};
+
+}  // namespace
+
+std::vector<CefRefPtr<CefExtensionAction>> GetActions(Profile* profile) {
+  std::vector<CefRefPtr<CefExtensionAction>> actions;
+  auto* registry = profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  if (!registry) {
+    return actions;
+  }
+  for (const auto& extension : registry->enabled_extensions()) {
+    if (!ToolbarExtension(profile, extension->id()) ||
+        !extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(
+            *extension)) {
+      continue;
+    }
+    actions.push_back(new ExtensionActionImpl(profile, extension->id()));
+  }
+  return actions;
+}
+
+CefRefPtr<CefRegistration> AddObserver(
+    Profile* profile,
+    CefRefPtr<CefExtensionActionsObserver> observer) {
+  if (!profile || !observer) {
+    return nullptr;
+  }
+  return new Registration(profile, observer);
+}
+
+}  // namespace cef_extension_actions
