+bool CefBrowserHostBase::AttachDevToolsFrontend(
+    CefRefPtr<CefBrowserHost> frontend) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    DCHECK(false) << "called on invalid thread";
+    return false;
+  }
+  auto inspected = GetWebContents();
+  auto frontend_host = frontend ? static_cast<CefBrowserHostBase*>(frontend.get())
+                                : nullptr;
+  auto frontend_contents =
+      frontend_host ? frontend_host->GetWebContents() : nullptr;
+  // The front end's bindings come with its page, made as it commits.
+  auto bindings = frontend_contents
+                      ? DevToolsUIBindings::ForWebContents(frontend_contents)
+                      : nullptr;
+  if (!inspected || !bindings || frontend_contents == inspected) {
+    return false;
+  }
+  bindings->AttachTo(content::DevToolsAgentHost::GetOrCreateFor(inspected));
+  return true;
 }
 
