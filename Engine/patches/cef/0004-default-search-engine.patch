+namespace {
+
+// The default search engine chosen in the profile's settings, if any.
+const TemplateURL* DefaultSearchProvider(Profile* profile,
+                                         TemplateURLService** service) {
+  *service = profile ? TemplateURLServiceFactory::GetForProfile(profile)
+                     : nullptr;
+  if (!*service) {
+    return nullptr;
+  }
+  if (!(*service)->loaded()) {
+    (*service)->Load();
+  }
+  return (*service)->GetDefaultSearchProvider();
+}
+
+}  // namespace
+
+CefString CefRequestContextImpl::GetDefaultSearchURL(const CefString& terms) {
+  if (!VerifyBrowserContext()) {
+    return CefString();
+  }
+  TemplateURLService* service = nullptr;
+  const TemplateURL* provider =
+      DefaultSearchProvider(browser_context()->AsProfile(), &service);
+  if (!provider) {
+    return CefString();
+  }
+  const GURL url(provider->url_ref().ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(terms.ToString16()),
+      service->search_terms_data()));
+  return url.is_valid() ? url.spec() : std::string();
+}
+
+CefString CefRequestContextImpl::GetDefaultSearchName() {
+  if (!VerifyBrowserContext()) {
+    return CefString();
+  }
+  TemplateURLService* service = nullptr;
+  const TemplateURL* provider =
+      DefaultSearchProvider(browser_context()->AsProfile(), &service);
+  return provider ? CefString(provider->short_name()) : CefString();
+}
