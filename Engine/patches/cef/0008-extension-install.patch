+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cef/libcef/browser/image_impl.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "chrome/browser/extensions/extension_install_prompt.h"
+#include "chrome/browser/extensions/extension_install_prompt_show_params.h"
+#include "chrome/browser/extensions/webstore_install_with_prompt.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/install_prompt_data.h"
+#include "extensions/common/extension.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace cef_extension_install {
+
+namespace {
+
+CefRefPtr<CefExtensionInstallHandler>& Handler() {
+  static base::NoDestructor<CefRefPtr<CefExtensionInstallHandler>> handler;
+  return *handler;
+}
+
+// The person's answer, given once; an unanswered prompt counts as cancelled.
+class PromptCallback : public CefCallback {
+ public:
+  explicit PromptCallback(ExtensionInstallPrompt::DoneCallback done)
+      : done_(std::move(done)) {}
+  ~PromptCallback() override {
+    if (done_) {
+      std::move(done_).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+          ExtensionInstallPrompt::Result::USER_CANCELED));
+    }
+  }
+
+  PromptCallback(const PromptCallback&) = delete;
+  PromptCallback& operator=(const PromptCallback&) = delete;
+
+  void Continue() override {
+    Answer(ExtensionInstallPrompt::Result::ACCEPTED);
+  }
+  void Cancel() override {
+    Answer(ExtensionInstallPrompt::Result::USER_CANCELED);
+  }
+
+ private:
+  void Answer(ExtensionInstallPrompt::Result result) {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT,
+                    base::BindOnce(&PromptCallback::Answer, this, result));
+      return;
+    }
+    if (done_) {
+      std::move(done_).Run(ExtensionInstallPrompt::DoneCallbackPayload(result));
+    }
+  }
+
+  ExtensionInstallPrompt::DoneCallback done_;
+
+  IMPLEMENT_REFCOUNTING_DELETE_ON_UIT(PromptCallback);
+};
+
+void ShowPrompt(std::unique_ptr<ExtensionInstallPromptShowParams> show_params,
+                ExtensionInstallPrompt::DoneCallback done,
+                std::unique_ptr<extensions::InstallPromptData> prompt) {
+  CefRefPtr<CefExtensionInstallHandler> handler = Handler();
+  if (!handler || !prompt) {
+    std::move(done).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+        ExtensionInstallPrompt::Result::ABORTED));
+    return;
+  }
+  std::vector<CefString> permissions;
+  for (size_t i = 0; i < prompt->GetPermissionCount(); ++i) {
+    permissions.push_back(prompt->GetPermission(i));
+  }
+  CefRefPtr<CefImage> icon;
+  if (!prompt->icon().IsEmpty()) {
+    icon = new CefImageImpl(*prompt->icon().ToImageSkia());
+  }
+  const extensions::Extension* extension = prompt->extension();
+  handler->OnInstallPrompt(extension ? extension->id() : std::string(),
+                           prompt->GetDialogTitle(), icon, permissions,
+                           prompt->GetAcceptButtonLabel(),
+                           new PromptCallback(std::move(done)));
+}
+
+// Chrome's install from the store, without its post-install bubble, which
+// needs a Chrome window.
+class WebStoreInstall : public extensions::WebstoreInstallWithPrompt {
+ public:
+  WebStoreInstall(const std::string& id, Profile* profile, Callback callback)
+      : WebstoreInstallWithPrompt(id,
+                                  profile,
+                                  gfx::NativeWindow(),
+                                  std::move(callback)) {
+    set_show_post_install_ui(false);
+  }
+
+ private:
+  ~WebStoreInstall() override = default;
+};
+
+}  // namespace
+
+void SetHandler(CefRefPtr<CefExtensionInstallHandler> handler) {
+  Handler() = handler;
+  ExtensionInstallPrompt::SetEmbedderShowDialogCallback(
+      handler ? base::BindRepeating(&ShowPrompt)
+              : ExtensionInstallPrompt::ShowDialogCallback());
+}
+
+void InstallFromWebStore(Profile* profile,
+                         const CefString& extension_id,
+                         CefRefPtr<CefExtensionInstallCallback> callback) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return;
+  }
+  const std::string id = extension_id;
+  auto install = base::MakeRefCounted<WebStoreInstall>(
+      id, profile,
+      base::BindOnce(
+          [](CefRefPtr<CefExtensionInstallCallback> callback, std::string id,
+             bool success, const std::string& error,
+             extensions::webstore_install::Result result) {
+            if (callback) {
+              callback->OnInstallFinished(id, success, error);
+            }
+          },
+          callback, id));
+  install->BeginInstall();
+}
+
+}  // namespace cef_extension_install
