+#ifndef CEF_INCLUDE_CEF_EXTENSION_INSTALL_H_
+#define CEF_INCLUDE_CEF_EXTENSION_INSTALL_H_
+#pragma once
+
+#include <vector>
+
+#include "include/cef_base.h"
+#include "include/cef_callback.h"
+#include "include/cef_image.h"
+
+///
+/// Asks the person before a Chrome extension is installed, or enabled again
+/// with more permissions, in place of Chrome's dialog. The methods of this
+/// class are called on the browser process UI thread.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefExtensionInstallHandler : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// Show the person |title| (such as "Add uBlock Origin Lite?"), the
+  /// extension's |icon| and what it will be able to do (|permissions|), with
+  /// a button reading |accept_label|; then call |callback|'s Continue() to go
+  /// ahead or Cancel() not to.
+  ///
+  /*--cef(optional_param=icon)--*/
+  virtual void OnInstallPrompt(const CefString& extension_id,
+                               const CefString& title,
+                               CefRefPtr<CefImage> icon,
+                               const std::vector<CefString>& permissions,
+                               const CefString& accept_label,
+                               CefRefPtr<CefCallback> callback) = 0;
+};
+
+///
+/// Hears how an install from the Chrome Web Store ended. The methods of this
+/// class are called on the browser process UI thread.
+///
+/*--cef(source=client,added=experimental)--*/
+class CefExtensionInstallCallback : public virtual CefBaseRefCounted {
+ public:
+  ///
+  /// The install of |extension_id| ended: |success|, or with |error|.
+  ///
+  /*--cef(optional_param=error)--*/
+  virtual void OnInstallFinished(const CefString& extension_id,
+                                 bool success,
+                                 const CefString& error) = 0;
+};
+
+#endif  // CEF_INCLUDE_CEF_EXTENSION_INSTALL_H_
