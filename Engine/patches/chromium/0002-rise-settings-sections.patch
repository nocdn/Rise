+/**
+ * Rise shows Chrome's settings in its own pages, as rise://settings. Sections for parts of Chrome
+ * that Rise's pages don't use, or that Rise does its own way, are left out: signing in to Google,
+ * autofill and passwords, extensions, startup pages, performance, AI features, Safety Check,
+ * downloads, and the parts of Appearance for Chrome's own window (theme, toolbar, tab strip,
+ * side panel, mode, quitting and split view). Fonts, page zoom and Tab to links stay.
+ */
+function risePageVisibility(): PageVisibility {
+  return {
+    a11y: true,
+    ai: false,
+    appearance: {
+      browserUi: false,
+      setTheme: false,
+      homeButton: false,
+      hoverCard: false,
+      bookmarksBar: false,
+      pageZoom: true,
+      sidePanel: false,
+    },
+    autofill: false,
+    defaultBrowser: true,
+    downloads: false,
+    extensions: false,
+    languages: true,
+    onStartup: false,
+    people: false,
+    performance: false,
+    privacy: {
+      searchPrediction: false,
+      networkPrediction: true,
+    },
+    reset: true,
+    safetyHub: false,
+    system: true,
+    yourSavedInfo: false,
+  };
+}
+
 /**
  * Dictionary defining page visibility.
  */
