new file mode 100644
--- /dev/null
+++ b/chrome/browser/extensions/embedder_browser_windows.cc
@@ -0,0 +1,105 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/embedder_browser_windows.h"
+
+#include <algorithm>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace extensions {
+
+EmbedderBrowserWindows::EmbedderBrowserWindows() = default;
+EmbedderBrowserWindows::~EmbedderBrowserWindows() = default;
+
+// static
+EmbedderBrowserWindows& EmbedderBrowserWindows::Get() {
+  static base::NoDestructor<EmbedderBrowserWindows> instance;
+  return *instance;
+}
+
+void EmbedderBrowserWindows::Add(BrowserWindowInterface* window) {
+  CHECK(!Contains(window));
+  windows_.push_back(window);
+  for (Observer& observer : observers_) {
+    observer.OnEmbedderWindowAdded(window);
+  }
+}
+
+void EmbedderBrowserWindows::Remove(BrowserWindowInterface* window) {
+  std::erase(windows_, window);
+}
+
+void EmbedderBrowserWindows::Activated(BrowserWindowInterface* window) {
+  auto it = std::ranges::find(windows_, window);
+  if (it == windows_.end()) {
+    return;
+  }
+  std::rotate(windows_.begin(), it, it + 1);
+  for (Observer& observer : observers_) {
+    observer.OnEmbedderWindowActivated(window);
+  }
+}
+
+bool EmbedderBrowserWindows::Contains(
+    const BrowserWindowInterface* window) const {
+  return std::ranges::find(windows_, window) != windows_.end();
+}
+
+std::vector<BrowserWindowInterface*> EmbedderBrowserWindows::GetWindows()
+    const {
+  return std::vector<BrowserWindowInterface*>(windows_.begin(),
+                                              windows_.end());
+}
+
+void EmbedderBrowserWindows::SetTabLookup(TabLookup lookup) {
+  tab_lookup_ = std::move(lookup);
+}
+
+tabs::TabInterface* EmbedderBrowserWindows::FindTab(
+    content::WebContents* contents) const {
+  return contents && tab_lookup_ ? tab_lookup_.Run(contents) : nullptr;
+}
+
+void EmbedderBrowserWindows::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void EmbedderBrowserWindows::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::vector<BrowserWindowInterface*> GetAllBrowserWindows() {
+  std::vector<BrowserWindowInterface*> windows = GetAllBrowserWindowInterfaces();
+  for (BrowserWindowInterface* window :
+       EmbedderBrowserWindows::Get().GetWindows()) {
+    windows.push_back(window);
+  }
+  return windows;
+}
+
+void ForEachBrowserWindowOrderedByActivation(
+    base::FunctionRef<bool(BrowserWindowInterface*)> on_browser) {
+  // An embedder's windows are its app's, which have Chrome's own windows, if
+  // any, behind them.
+  for (BrowserWindowInterface* window :
+       EmbedderBrowserWindows::Get().GetWindows()) {
+    if (!on_browser(window)) {
+      return;
+    }
+  }
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(on_browser);
+}
+
+tabs::TabInterface* MaybeGetTabFromContents(content::WebContents* contents) {
+  if (tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents)) {
+    return tab;
+  }
+  return EmbedderBrowserWindows::Get().FindTab(contents);
+}
+
+}  // namespace extensions
