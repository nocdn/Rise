@@ -0,0 +1,90 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_EMBEDDER_BROWSER_WINDOWS_H_
+#define CHROME_BROWSER_EXTENSIONS_EMBEDDER_BROWSER_WINDOWS_H_
+
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/functional/function_ref.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "extensions/buildflags/buildflags.h"
+
+static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace extensions {
+
+// Browser windows an embedder makes itself, holding tabs of its own rather than
+// a Browser's tab strip, such as CEF's for Alloy style browsers. The extension
+// APIs see them alongside Chrome's own windows; the rest of Chrome doesn't.
+class EmbedderBrowserWindows {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnEmbedderWindowAdded(BrowserWindowInterface* window) {}
+    virtual void OnEmbedderWindowActivated(BrowserWindowInterface* window) {}
+  };
+
+  // Finds the embedder window's tab showing a WebContents, if any.
+  using TabLookup =
+      base::RepeatingCallback<tabs::TabInterface*(content::WebContents*)>;
+
+  static EmbedderBrowserWindows& Get();
+
+  EmbedderBrowserWindows(const EmbedderBrowserWindows&) = delete;
+  EmbedderBrowserWindows& operator=(const EmbedderBrowserWindows&) = delete;
+
+  void Add(BrowserWindowInterface* window);
+  void Remove(BrowserWindowInterface* window);
+  // Moves `window` to the front of the activation order.
+  void Activated(BrowserWindowInterface* window);
+  bool Contains(const BrowserWindowInterface* window) const;
+  // Most recently activated first.
+  std::vector<BrowserWindowInterface*> GetWindows() const;
+
+  void SetTabLookup(TabLookup lookup);
+  tabs::TabInterface* FindTab(content::WebContents* contents) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  EmbedderBrowserWindows();
+  ~EmbedderBrowserWindows();
+  friend class base::NoDestructor<EmbedderBrowserWindows>;
+
+  std::vector<raw_ptr<BrowserWindowInterface>> windows_;
+  TabLookup tab_lookup_;
+  base::ObserverList<Observer> observers_;
+};
+
+// Chrome's browser windows and the embedder's, for the extension APIs, in
+// creation order.
+std::vector<BrowserWindowInterface*> GetAllBrowserWindows();
+
+// As ForEachCurrentBrowserWindowInterfaceOrderedByActivation(), with the
+// embedder's windows too.
+void ForEachBrowserWindowOrderedByActivation(
+    base::FunctionRef<bool(BrowserWindowInterface*)> on_browser);
+
+// The tab, Chrome's or the embedder's, showing `contents`; null if none does.
+tabs::TabInterface* MaybeGetTabFromContents(content::WebContents* contents);
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_EMBEDDER_BROWSER_WINDOWS_H_
