+// Rise's install prompt, in place of Chrome's dialog.
+void (^g_install_prompt)(NSString*, NSImage*, NSArray<NSString*>*, NSString*,
+                         void (^)(BOOL)) = nil;
+
+void ShowInstallPrompt(
+    std::unique_ptr<ExtensionInstallPromptShowParams> show_params,
+    ExtensionInstallPrompt::DoneCallback done,
+    std::unique_ptr<extensions::InstallPromptData> prompt) {
+  if (!g_install_prompt || !prompt) {
+    std::move(done).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+        ExtensionInstallPrompt::Result::ABORTED));
+    return;
+  }
+  NSMutableArray<NSString*>* permissions = [NSMutableArray array];
+  for (size_t i = 0; i < prompt->GetPermissionCount(); ++i) {
+    [permissions addObject:base::SysUTF16ToNSString(prompt->GetPermission(i))];
+  }
+  NSImage* icon =
+      prompt->icon().IsEmpty() ? nil : ToNSImage(*prompt->icon().ToImageSkia());
+  // Answered once; unanswered, it's cancelled.
+  auto waiting =
+      std::make_shared<ExtensionInstallPrompt::DoneCallback>(std::move(done));
+  g_install_prompt(base::SysUTF16ToNSString(prompt->GetDialogTitle()), icon,
+                   permissions,
+                   base::SysUTF16ToNSString(prompt->GetAcceptButtonLabel()),
+                   ^(BOOL accept) {
+                     if (*waiting) {
+                       std::move(*waiting).Run(
+                           ExtensionInstallPrompt::DoneCallbackPayload(
+                               accept ? ExtensionInstallPrompt::Result::ACCEPTED
+                                      : ExtensionInstallPrompt::Result::
+                                            USER_CANCELED));
+                     }
+                   });
+}
