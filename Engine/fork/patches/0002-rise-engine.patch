+// What a download does, told to Rise's.
+class DownloadWatcher : public download::DownloadItem::Observer {
+ public:
+  DownloadWatcher(RCDownload* download, download::DownloadItem* item)
+      : download_(download) {
+    observation_.Observe(item);
+  }
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    [download_ updateFrom:item];
+  }
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    observation_.Reset();
+    [download_ itemGone];
+  }
+
+ private:
+  __weak RCDownload* download_;
+  base::ScopedObservation<download::DownloadItem,
+                          download::DownloadItem::Observer>
+      observation_{this};
+};
+
+// Downloads under way, kept until they end.
+NSMutableSet<RCDownload*>* LiveDownloads() {
+  static NSMutableSet* downloads = [NSMutableSet set];
+  return downloads;
+}
+
+}  // namespace
+
+@implementation RCDownload {
+  raw_ptr<download::DownloadItem> _item;
+  std::unique_ptr<DownloadWatcher> _watcher;
+  NSURL* _url;
+  RCDownloadState _state;
+  int64_t _receivedBytes;
+  int64_t _totalBytes;
+  BOOL _cancelled;
+}
+@synthesize onUpdate = _onUpdate;
+
+- (instancetype)initWithItem:(download::DownloadItem*)item {
+  if (!(self = [super init])) {
+    return nil;
+  }
+  _item = item;
+  _watcher = std::make_unique<DownloadWatcher>(self, item);
+  [LiveDownloads() addObject:self];
+  [self read:item];
+  return self;
+}
+
+- (void)read:(download::DownloadItem*)item {
+  _url = ToNSURL(item->GetURL()) ?: _url;
+  _receivedBytes = item->GetReceivedBytes();
+  _totalBytes = item->GetTotalBytes() > 0 ? item->GetTotalBytes() : -1;
+  switch (item->GetState()) {
+    case download::DownloadItem::COMPLETE:
+      _state = RCDownloadStateFinished;
+      break;
+    case download::DownloadItem::CANCELLED:
+      _state = _cancelled ? RCDownloadStateCancelled : RCDownloadStateFailed;
+      break;
+    case download::DownloadItem::INTERRUPTED:
+      _state = RCDownloadStateFailed;
+      break;
+    default:
+      _state = item->IsPaused() ? RCDownloadStatePaused
+                                : RCDownloadStateDownloading;
+  }
+}
+
+- (void)updateFrom:(download::DownloadItem*)item {
+  [self read:item];
+  if (_onUpdate) {
+    _onUpdate(self);
+  }
+  if (_state == RCDownloadStateFinished || _state == RCDownloadStateCancelled ||
+      _state == RCDownloadStateFailed) {
+    [self forget];
+  }
+}
+
+- (void)itemGone {
+  _item = nullptr;
+  if (_state == RCDownloadStateDownloading || _state == RCDownloadStatePaused) {
+    _state = RCDownloadStateFailed;
+    if (_onUpdate) {
+      _onUpdate(self);
+    }
+  }
+  [self forget];
+}
+
+// No longer followed: it ended, or Rise didn't take it.
+- (void)forget {
+  _watcher.reset();
+  _item = nullptr;
+  [LiveDownloads() removeObject:self];
+}
+
+- (NSURL*)url {
+  return _url ?: [NSURL URLWithString:@"about:blank"];
+}
+- (RCDownloadState)state {
+  return _state;
+}
+- (int64_t)receivedBytes {
+  return _receivedBytes;
+}
+- (int64_t)totalBytes {
+  return _totalBytes;
+}
+- (void)pause {
+  if (_item) {
+    _item->Pause();
+  }
+}
+- (void)resume {
+  if (_item) {
+    _item->Resume(/*user_resume=*/true);
+  }
+}
+- (void)cancel {
+  if (_item) {
+    _cancelled = YES;
+    _item->Cancel(/*user_cancel=*/true);
+  }
+}
+@end
