+- (void)removeUserScriptsWithPrefix:(NSString*)prefix {
+  NSIndexSet* matching = [_scripts
+      indexesOfObjectsPassingTest:^BOOL(NSDictionary* script, NSUInteger, BOOL*) {
+        return [script[@"source"] hasPrefix:prefix];
+      }];
+  if (!matching.count) {
+    return;
+  }
+  [_scripts removeObjectsAtIndexes:matching];
+  [self sendScripts:nil];
+}
