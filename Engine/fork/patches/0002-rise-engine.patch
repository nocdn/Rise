+@implementation RCBrowserView {
+  raw_ptr<content::WebContents> _contents;
+  std::unique_ptr<TabObserver> _observer;
+  NSURL* _pendingURL;
+  BOOL _closed;
+  // Rise's scripts for the page's documents, in order: source, world (none
+  // for the page's own), mainFrameOnly, and handlers as [name, replies].
+  NSMutableArray<NSDictionary*>* _scripts;
+  // Rise's message handlers, by name: world and replies.
+  NSMutableDictionary<NSString*, NSDictionary*>* _handlers;
+}
+
+@synthesize delegate = _delegate;
+@synthesize scriptsDisabled = _scriptsDisabled;
+@synthesize extensionPopup = _extensionPopup;
+@synthesize covered = _covered;
