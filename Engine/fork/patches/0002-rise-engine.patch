+- (void)browserStarted {
+  BrowserWindowInterface* browser = WaitingBrowser();
+  if (_closed || _contents || !browser) {
+    return;
+  }
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(content::WebContents::CreateParams(
+          browser->GetProfile()));
+  _contents = contents.get();
+  // A tab of the Browser: Chrome's tab helpers, extensions and the rest see it
+  // as one.
+  browser->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                                 /*foreground=*/false);
+  _observer = std::make_unique<TabObserver>(self, _contents);
+  [Views() setObject:self forKey:[NSValue valueWithPointer:_contents]];
+  _contents->SetPageBaseBackgroundColor(
+      skia::NSDeviceColorToSkColor([_pageBackgroundColor
+          colorUsingColorSpace:NSColorSpace.deviceRGBColorSpace]));
+  NSView* page = _contents->GetNativeView().GetNativeNSView();
+  page.frame = self.bounds;
+  page.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [self addSubview:page];
+  if (_zoom != 1) {
+    self.zoom = _zoom;
+  }
+  if (_pendingURL) {
+    NSURL* url = _pendingURL;
+    _pendingURL = nil;
+    [self loadURL:url];
+  }
+  [NSNotificationCenter.defaultCenter postNotificationName:kPageMadeNotification
+                                                    object:self];
+}
