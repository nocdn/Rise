+// The Browser a page is a tab of.
+BrowserWindowInterface* BrowserOf(content::WebContents* contents) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+// Moves `contents` into `to`'s tab strip at `index` (-1: the end), keeping its
+// page, as dragging a tab between Chrome's windows does. Returns where it went.
+int MoveTab(content::WebContents* contents,
+            BrowserWindowInterface* to,
+            int index,
+            bool pinned) {
+  TabStripModel* destination = to->GetTabStripModel();
+  int at = destination->GetIndexOfWebContents(contents);
+  if (at != TabStripModel::kNoTab) {
+    return at;
+  }
+  BrowserWindowInterface* from = BrowserOf(contents);
+  if (!from) {
+    return TabStripModel::kNoTab;
+  }
+  TabStripModel* source = from->GetTabStripModel();
+  std::unique_ptr<tabs::TabModel> tab =
+      source->DetachTabAtForInsertion(source->GetIndexOfWebContents(contents));
+  if (index < 0 || index > destination->count()) {
+    index = destination->count();
+  }
+  return destination->InsertDetachedTabAt(
+      index, std::move(tab),
+      pinned ? AddTabTypes::ADD_PINNED : AddTabTypes::ADD_NONE);
+}
