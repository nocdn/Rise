+// What a saved history starts with, to tell it from another engine's.
+const char kHistoryFormat[] = "rise-fork-history-1";
+
+- (NSData*)navigationState {
+  if (!_contents) {
+    return nil;
+  }
+  content::NavigationController& controller = _contents->GetController();
+  int count = controller.GetEntryCount();
+  if (!count || controller.GetLastCommittedEntry()->IsInitialEntry()) {
+    return nil;
+  }
+  // Chrome's own session format for each entry, scroll positions and forms
+  // included.
+  base::Pickle pickle;
+  pickle.WriteString(kHistoryFormat);
+  pickle.WriteInt(controller.GetLastCommittedEntryIndex());
+  pickle.WriteInt(count);
+  for (int i = 0; i < count; i++) {
+    sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+        i, controller.GetEntryAtIndex(i))
+        .WriteToPickle(/*max_size=*/1 << 20, &pickle);
+  }
+  base::span<const uint8_t> bytes = pickle.AsBytes();
+  return [NSData dataWithBytes:bytes.data() length:bytes.size()];
+}
+
+- (BOOL)restore:(NSData*)state {
+  content::NavigationController& controller = _contents->GetController();
+  if (!state.length || (controller.GetEntryCount() &&
+                        !controller.GetLastCommittedEntry()->IsInitialEntry())) {
+    return NO;
+  }
+  std::string saved(static_cast<const char*>(state.bytes), state.length);
+  base::Pickle pickle = base::Pickle::WithUnownedBuffer(base::as_byte_span(saved));
+  base::PickleIterator iterator(pickle);
+  std::string format;
+  int index = 0, count = 0;
+  if (!iterator.ReadString(&format) || format != kHistoryFormat ||
+      !iterator.ReadInt(&index) || !iterator.ReadInt(&count) || count <= 0 ||
+      index < 0 || index >= count) {
+    return NO;
+  }
+  std::vector<sessions::SerializedNavigationEntry> navigations(count);
+  for (sessions::SerializedNavigationEntry& navigation : navigations) {
+    if (!navigation.ReadFromPickle(&iterator)) {
+      return NO;
+    }
+  }
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          navigations, _contents->GetBrowserContext());
+  if (entries.size() != navigations.size()) {
+    return NO;
+  }
+  controller.Restore(index, content::RestoreType::kRestored, &entries);
+  controller.LoadIfNecessary();
+  return YES;
+}
