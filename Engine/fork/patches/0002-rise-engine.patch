+@implementation RCActionsObservation {
+  std::unique_ptr<ActionsWatcher> _watcher;
+}
+- (instancetype)initWithChanged:(void (^)(void))changed {
+  if ((self = [super init]) && RiseProfile()) {
+    void (^onMain)(void) = ^{
+      dispatch_async(dispatch_get_main_queue(), changed);
+    };
+    _watcher = std::make_unique<ActionsWatcher>(RiseProfile(), onMain);
+  }
+  return self;
+}
+@end
+
+@implementation RCExtensionAction {
+  NSString* _extensionID;
+}
+- (instancetype)initWithExtension:(const extensions::Extension*)extension {
+  if ((self = [super init])) {
+    _extensionID = base::SysUTF8ToNSString(extension->id());
+    _name = base::SysUTF8ToNSString(extension->name());
+  }
+  return self;
+}
+@synthesize name = _name;
+- (NSString*)extensionID {
+  return _extensionID;
+}
+- (extensions::ExtensionAction*)action {
+  return ActionOf(RiseProfile(), base::SysNSStringToUTF8(_extensionID));
+}
+- (NSString*)titleForTab:(RCBrowserView*)tab {
+  extensions::ExtensionAction* action = [self action];
+  return action ? base::SysUTF8ToNSString(action->GetTitle(TabIdOf(tab))) : @"";
+}
+- (NSString*)badgeTextForTab:(RCBrowserView*)tab {
+  extensions::ExtensionAction* action = [self action];
+  return action ? base::SysUTF8ToNSString(action->GetDisplayBadgeText(TabIdOf(tab)))
+                : @"";
+}
+- (NSColor*)badgeColorForTab:(RCBrowserView*)tab {
+  extensions::ExtensionAction* action = [self action];
+  SkColor color = action ? action->GetBadgeBackgroundColor(TabIdOf(tab)) : 0;
+  return [NSColor colorWithSRGBRed:SkColorGetR(color) / 255.0
+                             green:SkColorGetG(color) / 255.0
+                              blue:SkColorGetB(color) / 255.0
+                             alpha:SkColorGetA(color) / 255.0];
+}
+- (NSImage*)iconForTab:(RCBrowserView*)tab {
+  extensions::ExtensionAction* action = [self action];
+  if (!action) {
+    return nil;
+  }
+  gfx::Image set = action->GetExplicitlySetIcon(TabIdOf(tab));
+  if (!set.IsEmpty()) {
+    return ToNSImage(*set.ToImageSkia());
+  }
+  extensions::IconImage* icon = action->default_icon_image();
+  return icon ? ToNSImage(icon->image_skia()) : nil;
+}
+- (BOOL)isEnabledForTab:(RCBrowserView*)tab {
+  extensions::ExtensionAction* action = [self action];
+  return action && action->GetIsVisible(TabIdOf(tab));
+}
+// Clicked as Chrome's toolbar does, granting the tab if the extension asks
+// for the active one: its popup's address, or nil if it took the click.
+- (NSURL*)clickInTab:(RCBrowserView*)tab {
+  Profile* profile = RiseProfile();
+  const extensions::Extension* extension =
+      ToolbarExtension(profile, base::SysNSStringToUTF8(_extensionID));
+  extensions::ExtensionAction* action = [self action];
+  content::WebContents* contents = [tab contents];
+  auto* runner =
+      contents ? extensions::ExtensionActionRunner::GetForWebContents(contents)
+               : nullptr;
+  if (!extension || !action || !runner ||
+      runner->RunAction(extension, /*grant_tab_permissions=*/true) !=
+          extensions::ExtensionAction::ShowAction::kShowPopup) {
+    return nil;
+  }
+  return ToNSURL(action->GetPopupUrl(TabIdOf(tab)));
+}
+@end
+
+@interface RCExtensionShortcut ()
+- (instancetype)initWithExtension:(const extensions::Extension*)extension
+                          command:(const std::string&)command
+                     clicksButton:(BOOL)clicksButton;
+@end
+
+@implementation RCExtensionShortcut {
+  NSString* _extensionID;
+  std::string _command;
+  BOOL _clicksButton;
+}
+- (instancetype)initWithExtension:(const extensions::Extension*)extension
+                          command:(const std::string&)command
+                     clicksButton:(BOOL)clicksButton {
+  if ((self = [super init])) {
+    _extensionID = base::SysUTF8ToNSString(extension->id());
+    _command = command;
+    _clicksButton = clicksButton;
+  }
+  return self;
+}
+- (NSString*)extensionID {
+  return _extensionID;
+}
+- (BOOL)clicksButton {
+  return _clicksButton;
+}
+// As Chrome's window runs one: the extension may act on the tab in front, and
+// hears its command with it.
+- (void)runInTab:(RCBrowserView*)tab {
+  Profile* profile = RiseProfile();
+  const extensions::Extension* extension =
+      ToolbarExtension(profile, base::SysNSStringToUTF8(_extensionID));
+  if (!extension || _clicksButton) {
+    return;
+  }
+  base::ListValue args;
+  args.Append(_command);
+  base::Value tab_value;
+  if (content::WebContents* contents = [tab contents]) {
+    if (auto* granter =
+            extensions::ActiveTabPermissionGranter::FromWebContents(contents)) {
+      granter->GrantIfRequested(extension);
+    }
+    tab_value = base::Value(
+        extensions::ExtensionTabUtil::CreateTabObject(
+            contents,
+            extensions::ExtensionTabUtil::GetScrubTabBehavior(
+                extension, extensions::mojom::ContextType::kPrivilegedExtension,
+                contents),
+            extension)
+            .ToValue());
+  }
+  args.Append(std::move(tab_value));
+  auto event = std::make_unique<extensions::Event>(
+      extensions::events::COMMANDS_ON_COMMAND, "commands.onCommand",
+      std::move(args), profile);
+  event->user_gesture = extensions::EventRouter::UserGestureState::kEnabled;
+  extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+      extension->id(), std::move(event));
+}
+@end
+
+@implementation RCExtensions
++ (RCExtensionShortcut*)shortcutForEvent:(NSEvent*)event {
+  Profile* profile = RiseProfile();
+  if (!profile || event.type != NSEventTypeKeyDown) {
+    return nil;
+  }
+  ui::Accelerator pressed(ui::KeyboardCodeFromNSEvent(event),
+                          ui::EventFlagsFromModifiers(event.modifierFlags));
+  auto* commands = extensions::CommandService::Get(profile);
+  for (const auto& extension :
+       extensions::ExtensionRegistry::Get(profile)->enabled_extensions()) {
+    if (!ToolbarExtension(profile, extension->id())) {
+      continue;
+    }
+    extensions::Command command;
+    bool active = false;
+    const extensions::ActionInfo* action =
+        extensions::ActionInfo::GetExtensionActionInfo(extension.get());
+    if (action &&
+        commands->GetExtensionActionCommand(
+            extension->id(), action->type,
+            extensions::CommandService::ACTIVE, &command, &active) &&
+        active && command.accelerator() == pressed) {
+      return [[RCExtensionShortcut alloc] initWithExtension:extension.get()
+                                                    command:command.command_name()
+                                               clicksButton:YES];
+    }
+    ui::CommandMap named;
+    commands->GetNamedCommands(extension->id(),
+                               extensions::CommandService::ACTIVE,
+                               extensions::CommandService::REGULAR, &named);
+    for (const auto& [name, shortcut] : named) {
+      if (shortcut.accelerator() == pressed) {
+        return [[RCExtensionShortcut alloc] initWithExtension:extension.get()
+                                                      command:name
+                                                 clicksButton:NO];
+      }
+    }
+  }
+  return nil;
+}
++ (NSArray<RCExtensionAction*>*)actions {
+  Profile* profile = RiseProfile();
+  auto* registry = profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  NSMutableArray<RCExtensionAction*>* actions = [NSMutableArray array];
+  if (!registry) {
+    return actions;
+  }
+  for (const auto& extension : registry->enabled_extensions()) {
+    if (ActionOf(profile, extension->id())) {
+      [actions addObject:[[RCExtensionAction alloc]
+                             initWithExtension:extension.get()]];
+    }
+  }
+  return actions;
+}
++ (id)observeActions:(void (^)(void))changed {
+  return [[RCActionsObservation alloc] initWithChanged:changed];
+}
++ (void)installFromWebStore:(NSString*)extensionID
+                 completion:(void (^)(BOOL, NSString*))completion {
+  Profile* profile = RiseProfile();
+  if (!profile) {
+    if (completion) {
+      completion(NO, @"Chromium isn't running");
+    }
+    return;
+  }
+  auto install = base::MakeRefCounted<WebStoreInstall>(
+      base::SysNSStringToUTF8(extensionID), profile,
+      base::BindOnce(
+          [](void (^completion)(BOOL, NSString*), bool success,
+             const std::string& error,
+             extensions::webstore_install::Result result) {
+            if (completion) {
+              completion(success,
+                         error.empty() ? nil : base::SysUTF8ToNSString(error));
+            }
+          },
+          completion));
+  install->BeginInstall();
+}
++ (void)setUninstallPrompt:(void (^)(NSString*, NSImage*, NSString*,
+                                     void (^)(BOOL)))prompt {
+  if (!prompt) {
+    extensions::ExtensionUninstallDialog::SetEmbedderShowCallback({});
+    return;
+  }
+  extensions::ExtensionUninstallDialog::SetEmbedderShowCallback(
+      base::BindRepeating(
+          [](void (^prompt)(NSString*, NSImage*, NSString*, void (^)(BOOL)),
+             gfx::NativeWindow parent, const std::u16string& title,
+             const gfx::ImageSkia& icon, const std::u16string& accept_label,
+             base::OnceCallback<void(bool)> done) {
+            // Answered once; unanswered, it's cancelled.
+            auto waiting =
+                std::make_shared<base::OnceCallback<void(bool)>>(std::move(done));
+            prompt(base::SysUTF16ToNSString(title), ToNSImage(icon),
+                   base::SysUTF16ToNSString(accept_label), ^(BOOL accept) {
+                     if (*waiting) {
+                       std::move(*waiting).Run(accept);
+                     }
+                   });
+          },
+          prompt));
+}
++ (void)setInstallPrompt:(void (^)(NSString*, NSImage*, NSArray<NSString*>*,
+                                   NSString*, void (^)(BOOL)))prompt {
+  g_install_prompt = prompt;
+  ExtensionInstallPrompt::SetEmbedderShowDialogCallback(
+      prompt ? base::BindRepeating(&ShowInstallPrompt)
+             : ExtensionInstallPrompt::ShowDialogCallback());
+}
+@end
