+// Takes `contents` as its page, a tab of the waiting Browser until its window
+// takes it.
+- (void)adopt:(std::unique_ptr<content::WebContents>)contents {
+  BrowserWindowInterface* browser = WaitingBrowser();
+  if (!browser) {
+    return;
+  }
+  _contents = contents.get();
+  // Its dialogs and file choosers are Rise's sheets and panels.
+  EmbedderTabHooks::Attach(_contents, std::make_unique<RiseTabHooks>(self));
+  // A tab of the Browser: Chrome's tab helpers, extensions and the rest see it
+  // as one.
+  browser->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                                 /*foreground=*/false);
+  [self tookContents];
