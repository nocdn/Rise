+}  // namespace
+
+@interface RCBrowserView ()
+- (void)browserStarted;
+- (void)contentsChanged;
+- (void)willNavigate:(RCNavigationKind)kind;
+- (void)finishedLoad;
+- (void)crashed;
+@end
+
+namespace {
+
+// What a tab does, told to its Rise view.
+class TabObserver : public content::WebContentsObserver {
+ public:
+  TabObserver(RCBrowserView* view, content::WebContents* contents)
+      : WebContentsObserver(contents), view_(view) {}
+
+  void TitleWasSet(content::NavigationEntry* entry) override { Changed(); }
+  void DidStartLoading() override { Changed(); }
+  void DidStopLoading() override { Changed(); }
+  void LoadProgressChanged(double progress) override { Changed(); }
+  void NavigationEntryCommitted(
+      const content::LoadCommittedDetails& details) override {
+    Changed();
+  }
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame() ||
+        navigation->IsSameDocument()) {
+      return;
+    }
+    RCNavigationKind kind = RCNavigationKindNewPage;
+    if (navigation->GetReloadType() != content::ReloadType::NONE) {
+      kind = RCNavigationKindReload;
+    } else if (navigation->GetPageTransition() &
+               ui::PAGE_TRANSITION_FORWARD_BACK) {
+      kind = RCNavigationKindHistory;
+    }
+    [view_ willNavigate:kind];
+  }
+  void DidFinishLoad(content::RenderFrameHost* frame,
+                     const GURL& validated_url) override {
+    if (frame->IsInPrimaryMainFrame()) {
+      [view_ finishedLoad];
+    }
+  }
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    [view_ crashed];
+  }
+
+ private:
+  void Changed() { [view_ contentsChanged]; }
+  __weak RCBrowserView* view_;
+};
+
+}  // namespace
+
+namespace rise {
+
+void BrowserStarted() {
+  g_started = true;
+  NSArray* waiting = g_waiting_for_start;
+  g_waiting_for_start = nil;
+  // On the next turn, with the main loop running, as AppKit would.
+  dispatch_async(dispatch_get_main_queue(), ^{
+    for (void (^block)(void) in waiting) {
+      block();
+    }
+    if ([g_rise_delegate respondsToSelector:@selector
+                         (applicationDidFinishLaunching:)]) {
+      [g_rise_delegate
+          applicationDidFinishLaunching:
+              [NSNotification
+                  notificationWithName:NSApplicationDidFinishLaunchingNotification
+                                object:NSApp]];
+    }
+  });
+}
+
+}  // namespace rise
+
+// MARK: The app
+
+// Chrome's application class (see RC_APPLICATION_SUPERCLASS), so Chrome takes it
+// as its own, run by Chrome's main from Rise's.
+@implementation RCApplication {
+  BOOL _running;
+}
+
+- (void)setDelegate:(id<NSApplicationDelegate>)delegate {
+  // Chrome's AppController is the app's delegate, as Chrome needs; Rise's hears
+  // what it needs from the bridge.
+  if (delegate && ![NSStringFromClass([(id)delegate class])
+                      isEqualToString:@"AppController"]) {
+    g_rise_delegate = delegate;
+    return;
+  }
+  [super setDelegate:delegate];
+}
+
+- (void)run {
+  if (_running) {
+    // Chrome's main loop, now that Chrome has read its command line: what the
+    // app class does first, when Chrome makes the app itself.
+    cocoa_l10n_util::ApplyForcedRTL();
+    [super run];
+    return;
+  }
+  if (!g_start_requested) {
+    [super run];
+    return;
+  }
+  _running = YES;
+  NSArray<NSString*>* processArguments = NSProcessInfo.processInfo.arguments;
+  std::vector<std::string>& arguments = Arguments();
+  arguments.insert(arguments.begin(), processArguments.firstObject.UTF8String);
+  for (NSUInteger i = 1; i < processArguments.count; i++) {
+    arguments.push_back(processArguments[i].UTF8String);
+  }
+  std::vector<const char*> argv;
+  for (const std::string& argument : arguments) {
+    argv.push_back(argument.c_str());
+  }
+  exit(ChromeMain(static_cast<int>(argv.size()), argv.data()));
+}
+
+@end
+
+@implementation RCEngine
+
++ (BOOL)startWithCachePath:(NSString*)cachePath keychain:(BOOL)keychain {
+  g_start_requested = true;
+  std::vector<std::string>& arguments = Arguments();
+  arguments.push_back("--user-data-dir=" + base::SysNSStringToUTF8(cachePath));
+  arguments.push_back("--no-startup-window");
+  arguments.push_back("--no-first-run");
+  arguments.push_back("--no-default-browser-check");
+  if (!keychain) {
+    arguments.push_back("--use-mock-keychain");
+  }
+  return YES;
+}
+
++ (BOOL)isRunning {
+  return g_start_requested;
+}
+
++ (void)shutdown {}
+
++ (NSString*)defaultSearchName {
+  Profile* profile = RiseProfile();
+  TemplateURLService* service =
+      profile ? TemplateURLServiceFactory::GetForProfile(profile) : nullptr;
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  return engine ? base::SysUTF16ToNSString(engine->short_name()) : nil;
+}
+
++ (NSURL*)searchURLForTerms:(NSString*)terms {
+  Profile* profile = RiseProfile();
+  TemplateURLService* service =
+      profile ? TemplateURLServiceFactory::GetForProfile(profile) : nullptr;
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!engine) {
+    return nil;
+  }
+  TemplateURLRef::SearchTermsArgs search(base::SysNSStringToUTF16(terms));
+  return ToNSURL(GURL(engine->url_ref().ReplaceSearchTerms(
+      search, service->search_terms_data())));
+}
+
+@end
+
+// MARK: Pages
+
+// A crop of a page's live picture, shown elsewhere: the GPU process's layer,
+// hosted again (as Rise's CEF bridge does).
+@interface RCLiveLayer : CALayer <CALayerDelegate>
+- (instancetype)initWithPage:(RCBrowserView*)page rect:(NSRect)rect;
+@end
+
+@implementation RCLiveLayer {
+  __weak RCBrowserView* _page;
+  NSRect _rect;
+  CALayer* _content;
+  CALayer* _flip;
+  CALayer* _host;
+}
+- (instancetype)initWithPage:(RCBrowserView*)page rect:(NSRect)rect {
+  if (!(self = [super init])) {
+    return nil;
+  }
+  _page = page;
+  _rect = rect;
+  self.anchorPoint = CGPointZero;
+  self.bounds = CGRectMake(0, 0, rect.size.width, rect.size.height);
+  self.masksToBounds = YES;
+  _content = [CALayer layer];
+  _flip = [CALayer layer];
+  _host = [[NSClassFromString(@"CALayerHost") alloc] init];
+  for (CALayer* layer in @[ _content, _flip, _host ]) {
+    layer.anchorPoint = CGPointZero;
+    layer.delegate = (id<CALayerDelegate>)self;
+  }
+  [_flip addSublayer:_host];
+  [_content addSublayer:_flip];
+  [self addSublayer:_content];
+  [self setNeedsLayout];
+  return self;
+}
+- (id<CAAction>)actionForLayer:(CALayer*)layer forKey:(NSString*)event {
+  return (id<CAAction>)NSNull.null;
+}
+- (void)layoutSublayers {
+  [super layoutSublayers];
+  RCBrowserView* page = _page;
+  CALayer* original = page ? ContentHost(page.layer) : nil;
+  if (!original) {
+    return;
+  }
+  [_host setValue:[original valueForKey:@"contextId"] forKey:@"contextId"];
+  NSSize size = page.bounds.size;
+  CGFloat top = page.isFlipped ? NSMinY(_rect) : size.height - NSMaxY(_rect);
+  CGFloat y = self.contentsAreFlipped ? -top : NSHeight(_rect) + top - size.height;
+  _content.frame = CGRectMake(-NSMinX(_rect), y, size.width, size.height);
+  _flip.geometryFlipped = NO;
+  _flip.frame = _content.bounds;
+  if (_flip.contentsAreFlipped != original.superlayer.contentsAreFlipped) {
+    _flip.geometryFlipped = YES;
+  }
+}
+@end
+
+@implementation RCBrowserView {
+  raw_ptr<content::WebContents> _contents;
+  std::unique_ptr<TabObserver> _observer;
+  NSURL* _pendingURL;
+  BOOL _closed;
+}
+
+@synthesize delegate = _delegate;
+@synthesize scriptsDisabled = _scriptsDisabled;
+@synthesize extensionPopup = _extensionPopup;
+@synthesize covered = _covered;
+@synthesize zoom = _zoom;
+@synthesize pageBackgroundColor = _pageBackgroundColor;
+@synthesize prefersDark = _prefersDark;
+
+- (instancetype)initWithFrame:(NSRect)frame URL:(NSURL*)url {
+  if (!(self = [super initWithFrame:frame])) {
+    return nil;
+  }
+  _pendingURL = url;
+  _zoom = 1;
+  _pageBackgroundColor = NSColor.whiteColor;
+  self.wantsLayer = YES;
+  // Made on the next turn, so what Rise sets on the new view first, such as
+  // its theme's colour for before the page draws, is what Chromium starts with.
+  __weak RCBrowserView* weakSelf = self;
+  void (^make)(void) = ^{
+    [weakSelf browserStarted];
+  };
+  if (g_started) {
+    dispatch_async(dispatch_get_main_queue(), make);
+  } else {
+    if (!g_waiting_for_start) {
+      g_waiting_for_start = [NSMutableArray array];
+    }
+    [g_waiting_for_start addObject:make];
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self close];
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (void)browserStarted {
+  BrowserWindowInterface* browser = SharedBrowser();
+  if (_closed || _contents || !browser) {
+    return;
+  }
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(content::WebContents::CreateParams(
+          browser->GetProfile()));
+  _contents = contents.get();
+  // A tab of the Browser: Chrome's tab helpers, extensions and the rest see it
+  // as one.
+  browser->GetTabStripModel()->AppendWebContents(std::move(contents),
+                                                 /*foreground=*/false);
+  _observer = std::make_unique<TabObserver>(self, _contents);
+  _contents->SetPageBaseBackgroundColor(
+      skia::NSDeviceColorToSkColor([_pageBackgroundColor
+          colorUsingColorSpace:NSColorSpace.deviceRGBColorSpace]));
+  NSView* page = _contents->GetNativeView().GetNativeNSView();
+  page.frame = self.bounds;
+  page.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [self addSubview:page];
+  if (_zoom != 1) {
+    self.zoom = _zoom;
+  }
+  if (_pendingURL) {
+    NSURL* url = _pendingURL;
+    _pendingURL = nil;
+    [self loadURL:url];
+  }
+}
+
+- (void)contentsChanged {
+  if ([_delegate respondsToSelector:@selector(browserViewDidChange:)]) {
+    [_delegate browserViewDidChange:self];
+  }
+}
+- (void)willNavigate:(RCNavigationKind)kind {
+  if ([_delegate respondsToSelector:@selector(browserView:willNavigate:)]) {
+    [_delegate browserView:self willNavigate:kind];
+  }
+}
+- (void)finishedLoad {
+  if ([_delegate respondsToSelector:@selector(browserViewDidFinishLoad:)]) {
+    [_delegate browserViewDidFinishLoad:self];
+  }
+}
+- (void)crashed {
+  if ([_delegate respondsToSelector:@selector(browserViewDidCrash:)]) {
+    [_delegate browserViewDidCrash:self];
+  }
+}
+
+- (NSURL*)URL {
+  return _contents ? ToNSURL(_contents->GetVisibleURL()) : _pendingURL;
+}
+- (NSString*)title {
+  return _contents ? base::SysUTF16ToNSString(_contents->GetTitle()) : nil;
+}
+- (BOOL)isLoading {
+  return _contents ? _contents->IsLoading() : _pendingURL != nil;
+}
+- (BOOL)canGoBack {
+  return _contents && _contents->GetController().CanGoBack();
+}
+- (BOOL)canGoForward {
+  return _contents && _contents->GetController().CanGoForward();
+}
+- (double)progress {
+  return _contents ? _contents->GetLoadProgress() : 0;
+}
+- (BOOL)audible {
+  return _contents && _contents->IsCurrentlyAudible();
+}
+- (BOOL)fullscreen {
+  return NO;
+}
+- (void)exitFullscreen {}
+- (NSData*)navigationState {
+  return nil;
+}
+- (void)restoreNavigationState:(NSData*)state fallback:(NSURL*)fallback {
+  [self loadURL:fallback];
+}
+- (NSURL*)hoveredURL {
+  return nil;
+}
+
+- (void)setZoom:(double)zoom {
+  _zoom = zoom;
+  if (_contents) {
+    content::HostZoomMap::SetZoomLevel(_contents,
+                                       blink::ZoomFactorToZoomLevel(zoom));
+  }
+}
+
+- (void)setPageBackgroundColor:(NSColor*)color {
+  _pageBackgroundColor = color.copy;
+  if (_contents) {
+    _contents->SetPageBaseBackgroundColor(skia::NSDeviceColorToSkColor(
+        [color colorUsingColorSpace:NSColorSpace.deviceRGBColorSpace]));
+  }
+}
+
+- (void)loadURL:(NSURL*)url {
+  if (!_contents) {
+    _pendingURL = url;
+    return;
+  }
+  content::NavigationController::LoadURLParams params(
+      GURL(base::SysNSStringToUTF8(url.absoluteString)));
+  params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  _contents->GetController().LoadURLWithParams(params);
+}
+- (void)goBack {
+  if (_contents && _contents->GetController().CanGoBack()) {
+    _contents->GetController().GoBack();
+  }
