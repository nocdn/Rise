 #include "base/check_is_test.h"
 
+#include <set>
+#include <string>
+#include <utility>
+
 #include "base/base_export.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
 
 namespace {
 bool g_this_is_a_test = false;
+bool g_embedder_takes_test_paths = false;
 }
 
 namespace base::internal {
 bool get_is_test_impl() {
   return g_this_is_a_test;
 }
+
+bool get_embedder_takes_test_path(const char* file, int line) {
+  if (!g_embedder_takes_test_paths) {
+    return false;
+  }
+  // Each place once, for the embedder to see which of tests' paths it takes.
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::set<std::pair<std::string, int>>> seen;
+  base::AutoLock hold(*lock);
+  if (seen->emplace(file, line).second) {
+    LOG(WARNING) << "Embedder takes the test path at " << file << ":" << line;
+  }
+  return true;
+}
 }  // namespace base::internal
 
+namespace base {
+void SetEmbedderTakesTestPaths() {
+  g_embedder_takes_test_paths = true;
+}
+}  // namespace base
+
