+// An extension a person installed, which has a toolbar button in Chrome.
+const extensions::Extension* ToolbarExtension(Profile* profile,
+                                              const std::string& id) {
+  auto* registry = profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  const extensions::Extension* extension =
+      registry ? registry->enabled_extensions().GetByID(id) : nullptr;
+  if (!extension || !extension->is_extension() ||
+      extensions::Manifest::IsComponentLocation(extension->location())) {
+    return nullptr;
+  }
+  return extension;
+}
+
+extensions::ExtensionAction* ActionOf(Profile* profile, const std::string& id) {
+  const extensions::Extension* extension = ToolbarExtension(profile, id);
+  return extension ? extensions::ExtensionActionManager::Get(profile)
+                         ->GetExtensionAction(*extension)
+                   : nullptr;
+}
+
+// What an extension's button shows for a tab, by Chrome's number for the tab.
+int TabIdOf(RCBrowserView* tab) {
+  content::WebContents* contents = [tab contents];
+  return contents ? sessions::SessionTabHelper::IdForTab(contents).id()
+                  : extensions::ExtensionAction::kDefaultTabId;
+}
