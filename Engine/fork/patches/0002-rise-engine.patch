--- /dev/null
+++ b/chrome/common/rise/rise_frame.mojom
@@ -0,0 +1,46 @@
+// Copyright 2026 The Rise Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module rise.mojom;
+
+import "mojo/public/mojom/base/values.mojom";
+
+// A handler Rise's script can post to, as riseHandlers.<name>.postMessage().
+struct Handler {
+  string name;
+  // Whether postMessage() returns a promise of Rise's reply.
+  bool replies;
+};
+
+// One of Rise's scripts, run as each document starts, before the page's own.
+struct Script {
+  string source;
+  // 0 for the page's own world; otherwise one of Rise's, which the page's
+  // scripts can't see, named `world_name`.
+  int32 world_id;
+  string world_name;
+  bool main_frame_only;
+  // Given to the script as `riseHandlers`; nothing else sees them.
+  array<Handler> handlers;
+};
+
+// Rise's agent in a frame, in the page's process. The browser sends a frame
+// its scripts before each navigation in it commits, so its documents never
+// start without them.
+interface RiseFrame {
+  // The scripts for the frame's documents from the next one on, and where
+  // their messages go.
+  SetScripts(array<Script> scripts,
+             pending_associated_remote<RiseFrameHost>? host);
+  // One more, run in the current document too if it has started.
+  AddScript(Script script);
+};
+
+// Rise, in the browser, for one frame: what its scripts post.
+interface RiseFrameHost {
+  PostMessage(string handler, int32 world_id, mojo_base.mojom.Value body);
+  PostMessageWithReply(string handler, int32 world_id,
+                       mojo_base.mojom.Value body)
+      => (mojo_base.mojom.Value reply, string? error);
+};
