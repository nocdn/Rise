+class EmbedderTabHooks : public base::SupportsUserData::Data {
+ public:
+  static EmbedderTabHooks* FromWebContents(content::WebContents* contents);
+  static void Attach(content::WebContents* contents,
+                     std::unique_ptr<EmbedderTabHooks> hooks);
+
+  // The tab's page dialogs; null leaves them to Chrome.
+  virtual content::JavaScriptDialogManager* GetJavaScriptDialogManager();
+  // Whether the embedder shows the file chooser the page asks for.
+  virtual bool RunFileChooser(content::RenderFrameHost* frame,
+                              scoped_refptr<content::FileSelectListener> listener,
+                              const blink::mojom::FileChooserParams& params);
+  // A page opening `params` elsewhere than itself (a new tab or window): where
+  // it goes.
+  enum class OpenURLResult {
+    kChrome,  // Chrome opens it, as for its own windows.
+    kOpened,  // The embedder opened it.
+    kHere,    // The page opens it itself instead.
+  };
+  virtual OpenURLResult OpenURL(const content::OpenURLParams& params);
+  // A window the page opened itself, as by window.open(): whether the
+  // embedder took `contents` (or let it go; Chrome otherwise adds it).
+  virtual bool AddNewContents(std::unique_ptr<content::WebContents>& contents,
+                              const GURL& target_url,
+                              WindowOpenDisposition disposition,
+                              const blink::mojom::WindowFeatures& features,
+                              bool user_gesture);
+  // Whether the embedder shows the page's element full screen itself, in its
+  // own window, and if so whether it does now.
+  virtual bool HandlesFullscreen();
+  virtual void SetFullscreen(bool fullscreen);
+  virtual bool IsFullscreen();
+  // Whether the embedder asks itself before opening `url` in another app.
+  virtual bool OpenInOtherApp(const GURL& url);
+  // Whether the embedder shows a page whose process ended itself, instead of
+  // Chrome's sad tab.
+  virtual bool ShowsCrashedPages();
+  // Whether the embedder says where `download`, from the tab, goes, in its own
+  // downloads list: `done` with the path, or nothing not to download it.
+  using DownloadPathCallback =
+      base::OnceCallback<void(std::optional<base::FilePath>)>;
+  virtual bool ChooseDownloadPath(download::DownloadItem* download,
+                                  const base::FilePath& suggested,
+                                  DownloadPathCallback done);
+};
+
+#endif  // CHROME_BROWSER_UI_BROWSER_WEB_CONTENTS_DELEGATE_EMBEDDER_TAB_HOOKS_H_
