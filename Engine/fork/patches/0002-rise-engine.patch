+// Rise's agent in a frame, in the page's process.
+mojo::AssociatedRemote<rise::mojom::RiseFrame> AgentOf(
+    content::RenderFrameHost* frame) {
+  mojo::AssociatedRemote<rise::mojom::RiseFrame> agent;
+  frame->GetRemoteAssociatedInterfaces()->GetInterface(&agent);
+  return agent;
+}
