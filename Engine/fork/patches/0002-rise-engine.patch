+// alert(), confirm(), prompt() and leaving or reloading a page with changes
+// it hasn't saved, asked in Rise's sheets, one at a time.
+class RiseDialogs : public content::JavaScriptDialogManager {
+ public:
+  explicit RiseDialogs(RCBrowserView* view) : view_(view) {}
+
+  void RunJavaScriptDialog(content::WebContents* contents,
+                           content::RenderFrameHost* frame,
+                           content::JavaScriptDialogType type,
+                           const std::u16string& message,
+                           const std::u16string& default_text,
+                           DialogClosedCallback callback,
+                           bool* did_suppress_message) override {
+    RCDialogKind kind = type == content::JAVASCRIPT_DIALOG_TYPE_ALERT
+                            ? RCDialogKindAlert
+                        : type == content::JAVASCRIPT_DIALOG_TYPE_CONFIRM
+                            ? RCDialogKindConfirm
+                            : RCDialogKindPrompt;
+    GURL origin =
+        frame ? frame->GetLastCommittedOrigin().GetURL() : GURL();
+    if (!Show(kind, message, default_text, ToNSURL(origin), std::move(callback),
+              /*unshown=*/false)) {
+      *did_suppress_message = true;
+    }
+  }
+  void RunBeforeUnloadDialog(content::WebContents* contents,
+                             content::RenderFrameHost* frame,
+                             bool is_reload,
+                             DialogClosedCallback callback) override {
+    // Pages can't word it themselves any more.
+    Show(is_reload ? RCDialogKindReload : RCDialogKindLeave, u"", u"", nil,
+         std::move(callback), /*unshown=*/true);
+  }
+  bool HandleJavaScriptDialog(content::WebContents* contents,
+                              bool accept,
+                              const std::u16string* prompt_override) override {
+    if (!callback_) {
+      return false;
+    }
+    [view_ cancelDialog];
+    std::move(callback_).Run(accept, prompt_override ? *prompt_override : u"");
+    return true;
+  }
+  // As when the page navigates away: Rise closes its sheet unanswered.
+  void CancelDialogs(content::WebContents* contents, bool reset_state) override {
+    if (!callback_) {
+      return;
+    }
+    callback_.Reset();
+    [view_ cancelDialog];
+  }
+
+ private:
+  // False if it couldn't be shown, answered with `unshown` (for leaving a
+  // page, yes).
+  bool Show(RCDialogKind kind,
+            const std::u16string& message,
+            const std::u16string& default_text,
+            NSURL* origin,
+            DialogClosedCallback callback,
+            bool unshown) {
+    RCBrowserView* view = view_;
+    if (!view || callback_) {
+      std::move(callback).Run(unshown, u"");
+      return false;
+    }
+    callback_ = std::move(callback);
+    int asked = ++asked_;
+    base::WeakPtr<RiseDialogs> weak = weak_factory_.GetWeakPtr();
+    BOOL shown = [view runDialog:kind
+                         message:base::SysUTF16ToNSString(message)
+                     defaultText:base::SysUTF16ToNSString(default_text)
+                          origin:origin
+                      completion:^(BOOL accepted, NSString* text) {
+                        if (weak && weak->asked_ == asked && weak->callback_) {
+                          std::move(weak->callback_)
+                              .Run(accepted,
+                                   base::SysNSStringToUTF16(text ?: @""));
+                        }
+                      }];
+    if (!shown) {
+      std::move(callback_).Run(unshown, u"");
+      return false;
+    }
+    return true;
+  }
+
+  __weak RCBrowserView* view_;
+  DialogClosedCallback callback_;
+  int asked_ = 0;
+  base::WeakPtrFactory<RiseDialogs> weak_factory_{this};
+};
