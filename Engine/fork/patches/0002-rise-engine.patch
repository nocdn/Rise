+@interface RCTabStrip ()
+// Chrome is closing the window's Browser itself, to quit.
+- (void)browserClosing:(BrowserWindowInterface*)browser;
+@end
+
+namespace {
+
+bool g_start_requested = false;
+bool g_started = false;
+std::vector<std::string>& Arguments() {
+  static base::NoDestructor<std::vector<std::string>> arguments;
+  return *arguments;
+}
+// Rise's app delegate, until Chrome's AppController is in place and the
+// browser has started; then it hears that the app finished launching.
+id<NSApplicationDelegate> g_rise_delegate = nil;
+NSMutableArray<void (^)(void)>* g_waiting_for_start = nil;
+
+Profile* RiseProfile() {
+  return g_started ? ProfileManager::GetLastUsedProfile() : nullptr;
+}
+
+// A Browser whose window is Rise's: Chrome makes the Browser, and no window of
+// its own. `delegate` answers for the Rise window; null for the one holding
+// pages that aren't tabs.
+BrowserWindowInterface* MakeBrowser(RiseBrowserWindow::Delegate* delegate) {
+  // None once Chrome is closing its windows to quit.
+  if (!RiseProfile() || browser_shutdown::IsTryingToQuit()) {
+    return nullptr;
+  }
+  BrowserWindowCreateParams params(RiseProfile(), /*from_user_gesture=*/false);
+  auto* window = new RiseBrowserWindow();
+  window->set_delegate(delegate);
+  params.window = window;
+  params.embedder_window = true;
+  // Rise restores its own windows.
+  params.omit_from_session_restore = true;
+  return CreateBrowserWindow(std::move(params));
+}
+
+// Where Rise's pages wait while they aren't any window's tabs: new pages until
+// their window takes them, and a Peek, its standby page, DevTools and the like.
+BrowserWindowInterface* g_waiting_browser = nullptr;
+BrowserWindowInterface* WaitingBrowser() {
+  if (!g_waiting_browser) {
+    g_waiting_browser = MakeBrowser(nullptr);
+  }
+  return g_waiting_browser;
+}
+
+// Rise saves what it has before Chrome closes its pages to quit, as when
+// AppKit quits it: once, whichever comes first.
+void RiseWillTerminate() {
+  static bool told = false;
+  if (told) {
+    return;
+  }
+  told = true;
+  if ([g_rise_delegate respondsToSelector:@selector(applicationWillTerminate:)]) {
+    [g_rise_delegate
+        applicationWillTerminate:
+            [NSNotification
+                notificationWithName:NSApplicationWillTerminateNotification
+                              object:NSApp]];
+  }
+}
+
+// The Browser a page is a tab of.
+BrowserWindowInterface* BrowserOf(content::WebContents* contents) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+// Moves `contents` into `to`'s tab strip at `index` (-1: the end), keeping its
+// page, as dragging a tab between Chrome's windows does. Returns where it went.
+int MoveTab(content::WebContents* contents,
+            BrowserWindowInterface* to,
+            int index,
+            bool pinned) {
+  TabStripModel* destination = to->GetTabStripModel();
+  int at = destination->GetIndexOfWebContents(contents);
+  if (at != TabStripModel::kNoTab) {
+    return at;
+  }
+  BrowserWindowInterface* from = BrowserOf(contents);
+  if (!from) {
+    return TabStripModel::kNoTab;
+  }
+  TabStripModel* source = from->GetTabStripModel();
+  std::unique_ptr<tabs::TabModel> tab =
+      source->DetachTabAtForInsertion(source->GetIndexOfWebContents(contents));
+  if (index < 0 || index > destination->count()) {
+    index = destination->count();
+  }
+  return destination->InsertDetachedTabAt(
+      index, std::move(tab),
+      pinned ? AddTabTypes::ADD_PINNED : AddTabTypes::ADD_NONE);
+}
+
+// Where Chrome's dialogs for a page go: over the page, below its top, in the
+// window Rise shows it in (or the window in front, while it's in none). Chrome
+// only makes a dialog a child of its own windows, so the host makes it one of
+// Rise's, to move with it.
+class PageDialogHost : public web_modal::WebContentsModalDialogHost {
+ public:
+  explicit PageDialogHost(NSView* page) : page_(page) {}
+  ~PageDialogHost() override {
+    observers_.Notify(&web_modal::ModalDialogHostObserver::OnHostDestroying);
+  }
+
+  void NotifyPositionRequiresUpdate() override {
+    observers_.Notify(
+        &web_modal::ModalDialogHostObserver::OnPositionRequiresUpdate);
+    AttachDialogs(0);
+  }
+  gfx::NativeView GetHostView() const override {
+    NSView* content = Content();
+    return gfx::NativeView(content);
+  }
+  gfx::Point GetDialogPosition(const gfx::Size& size) override {
+    NSView* content = Content();
+    NSView* page = page_;
+    NSRect area = page && page.window == content.window
+                      ? [page convertRect:page.bounds toView:content]
+                      : content.bounds;
+    CGFloat top = content.isFlipped ? NSMinY(area)
+                                    : NSHeight(content.bounds) - NSMaxY(area);
+    return gfx::Point(NSMinX(area) + (NSWidth(area) - size.width()) / 2, top);
+  }
+  gfx::Size GetMaximumDialogSize() override {
+    NSView* page = page_;
+    NSSize size = page.window ? page.bounds.size : Content().bounds.size;
+    return gfx::Size(size.width, size.height);
+  }
+  bool ShouldActivateDialog() const override {
+    return Content().window.isKeyWindow;
+  }
+  void AddObserver(web_modal::ModalDialogHostObserver* observer) override {
+    observers_.AddObserver(observer);
+    // A dialog being shown, whose window is ready on the next turn.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PageDialogHost::AttachDialogs,
+                                  weak_factory_.GetWeakPtr(), 20));
+  }
+  void RemoveObserver(web_modal::ModalDialogHostObserver* observer) override {
+    observers_.RemoveObserver(observer);
+  }
+
+ private:
+  NSView* Content() const {
+    NSView* page = page_;
+    NSWindow* window = page.window;
+    if (!window) {
+      window = NSApp.keyWindow ?: NSApp.mainWindow ?: NSApp.orderedWindows.firstObject;
+    }
+    return window.contentView;
+  }
+
+  // Chrome's dialog windows that are no one's children yet, once they show
+  // (trying for a second): made children of the page's window, over the page.
+  void AttachDialogs(int tries = 20) {
+    NSWindow* parent = Content().window;
+    if (!dialogs_) {
+      dialogs_ = [NSHashTable weakObjectsHashTable];
+    }
+    Class dialog = NSClassFromString(@"NativeWidgetMacNSWindow");
+    bool waiting = false;
+    for (NSWindow* window in NSApp.windows) {
+      if (window == parent || ![window isKindOfClass:dialog] ||
+          window.parentWindow || [dialogs_ containsObject:window]) {
+        continue;
+      }
+      if (!window.visible) {
+        waiting = true;
+        continue;
+      }
+      [parent addChildWindow:window ordered:NSWindowAbove];
+      [dialogs_ addObject:window];
+    }
+    for (NSWindow* window in dialogs_) {
+      Place(window);
+    }
+    if (waiting && tries > 0) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&PageDialogHost::AttachDialogs,
+                         weak_factory_.GetWeakPtr(), tries - 1),
+          base::Milliseconds(50));
+    }
+  }
+
+  // Puts `window` where Chrome's dialogs go over the page.
+  void Place(NSWindow* window) {
+    NSView* content = Content();
+    if (!content.window || window.parentWindow != content.window) {
+      return;
+    }
+    NSSize size = window.frame.size;
+    gfx::Point at = GetDialogPosition(gfx::Size(size.width, size.height));
+    NSPoint top_left = NSMakePoint(
+        at.x(), content.isFlipped ? at.y() : NSHeight(content.bounds) - at.y());
+    NSPoint screen = [content.window
+        convertPointToScreen:[content convertPoint:top_left toView:nil]];
+    [window setFrameOrigin:NSMakePoint(screen.x, screen.y - size.height)];
+  }
+
+  __weak NSView* page_;
+  base::ObserverList<web_modal::ModalDialogHostObserver> observers_;
+  NSHashTable<NSWindow*>* dialogs_ = nil;
+  base::WeakPtrFactory<PageDialogHost> weak_factory_{this};
+};
+
+// Chrome's dialogs for a whole window that Rise placed, which Chrome may move
+// again, centred on nothing.
+NSHashTable<NSWindow*>* WindowDialogs() {
+  static NSHashTable* dialogs = [NSHashTable weakObjectsHashTable];
+  return dialogs;
+}
+
+// Over its window, as a sheet shows, centred below its top.
+void PlaceWindowDialog(NSWindow* window) {
+  NSWindow* parent = window.parentWindow;
+  if (!parent) {
+    return;
+  }
+  NSRect frame = window.frame;
+  NSRect over = [parent convertRectToScreen:parent.contentLayoutRect];
+  NSPoint origin = NSMakePoint(NSMidX(over) - NSWidth(frame) / 2,
+                               NSMaxY(over) - 40 - NSHeight(frame));
+  if (!NSEqualPoints(origin, frame.origin)) {
+    [window setFrameOrigin:origin];
+  }
+}
+
+// Chrome's own windows over one of Rise's (a page's dialog, a device chooser)
+// become its children, as they are of Chrome's windows, so they move with it.
+// A page's picture-in-picture window floats on its own, as in Chrome.
+void AttachChromeWindow(NSWindow* window) {
+  static Class chrome_window = NSClassFromString(@"NativeWidgetMacNSWindow");
+  static Class floating = NSClassFromString(@"NativeWidgetMacFramelessNSWindow");
+  if (!window.visible || window.parentWindow ||
+      ![window isKindOfClass:chrome_window] ||
+      [window isKindOfClass:floating]) {
+    return;
+  }
+  NSPoint middle = NSMakePoint(NSMidX(window.frame), NSMidY(window.frame));
+  NSWindow* front = nil;
+  for (NSWindow* rise in NSApp.orderedWindows) {
+    if (rise == window || !rise.visible ||
+        [rise isKindOfClass:chrome_window] || rise.parentWindow) {
+      continue;
+    }
+    if (NSPointInRect(middle, rise.frame)) {
+      [rise addChildWindow:window ordered:NSWindowAbove];
+      return;
+    }
+    front = front ?: rise;
+  }
+  // A dialog for a whole window (removing an extension, say), which Chrome
+  // places over its own windows only: over the window in front, as a sheet
+  // shows, centred below its top.
+  if (front) {
+    [front addChildWindow:window ordered:NSWindowAbove];
+    [WindowDialogs() addObject:window];
+    PlaceWindowDialog(window);
+  }
+}
+
+void WatchChromeWindows() {
+  [NSNotificationCenter.defaultCenter
+      addObserverForName:NSWindowDidChangeOcclusionStateNotification
+                  object:nil
+                   queue:NSOperationQueue.mainQueue
+              usingBlock:^(NSNotification* notification) {
+                AttachChromeWindow(notification.object);
+              }];
+  [NSNotificationCenter.defaultCenter
+      addObserverForName:NSWindowDidMoveNotification
+                  object:nil
+                   queue:NSOperationQueue.mainQueue
+              usingBlock:^(NSNotification* notification) {
+                NSWindow* window = notification.object;
+                NSWindow* parent = window.parentWindow;
+                if (parent && [WindowDialogs() containsObject:window] &&
+                    !NSPointInRect(NSMakePoint(NSMidX(window.frame),
+                                               NSMidY(window.frame)),
+                                   parent.frame)) {
+                  PlaceWindowDialog(window);
+                }
+              }];
+}
