+// What Rise shows itself for a page, in its own interface.
+class RiseTabHooks : public EmbedderTabHooks {
+ public:
+  explicit RiseTabHooks(RCBrowserView* view)
+      : view_(view), dialogs_(view) {}
+
+  content::JavaScriptDialogManager* GetJavaScriptDialogManager() override {
+    return &dialogs_;
+  }
+
+  // Rise loads a crashed page again itself.
+  bool ShowsCrashedPages() override { return true; }
+
+  // Links to new tabs and windows open where Rise puts them; others open
+  // in the page itself.
+  OpenURLResult OpenURL(const content::OpenURLParams& params) override {
+    RCOpenDisposition disposition;
+    switch (params.disposition) {
+      case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+        disposition = RCOpenDispositionBackgroundTab;
+        break;
+      case WindowOpenDisposition::NEW_WINDOW:
+        disposition = RCOpenDispositionWindow;
+        break;
+      case WindowOpenDisposition::NEW_POPUP:
+        disposition = RCOpenDispositionPopup;
+        break;
+      case WindowOpenDisposition::SAVE_TO_DISK:
+      case WindowOpenDisposition::IGNORE_ACTION:
+        return OpenURLResult::kChrome;
+      default:
+        disposition = RCOpenDispositionForegroundTab;
+    }
+    NSURL* url = ToNSURL(params.url);
+    return url && [view_ openURL:url
+                     disposition:disposition
+                     userGesture:params.user_gesture]
+               ? OpenURLResult::kOpened
+               : OpenURLResult::kHere;
+  }
+
+  // A window the page opens itself, keeping it as its opener: Rise puts it
+  // somewhere, or it opens as a link to a new tab would.
+  bool AddNewContents(std::unique_ptr<content::WebContents>& contents,
+                      const GURL& target_url,
+                      WindowOpenDisposition disposition,
+                      const blink::mojom::WindowFeatures& features,
+                      bool user_gesture) override {
+    RCBrowserView* view = view_;
+    if (!view) {
+      return true;
+    }
+    RCBrowserView* popup =
+        [[RCBrowserView alloc] initWithFrame:view.bounds
+                              openedContents:contents.release()];
+    popup.pageBackgroundColor = view.pageBackgroundColor;
+    NSURL* url = ToNSURL(target_url);
+    if ([view adoptPopup:popup url:url userGesture:user_gesture]) {
+      return true;
+    }
+    [popup close];
+    if (url) {
+      [view openURL:url
+          disposition:RCOpenDispositionForegroundTab
+          userGesture:user_gesture];
+    }
+    return true;
+  }
+
+  // The page's element full screen fills its place in Rise's window.
+  bool HandlesFullscreen() override { return true; }
+  void SetFullscreen(bool fullscreen) override {
+    [view_ updateFullscreen:fullscreen];
+  }
+  bool IsFullscreen() override { return view_.fullscreen; }
+
+  bool OpenInOtherApp(const GURL& url) override {
+    NSURL* address = ToNSURL(url);
+    return address && [view_ openInOtherApp:address];
+  }
+
+  // Files the page saves go where Rise says, into its own downloads list.
+  bool ChooseDownloadPath(download::DownloadItem* item,
+                          const base::FilePath& suggested,
+                          DownloadPathCallback done) override {
+    RCBrowserView* view = view_;
+    if (![view takesDownloads]) {
+      return false;
+    }
+    NSURL* destination = [view
+        destinationForDownload:item
+                 suggestedName:base::SysUTF8ToNSString(suggested.BaseName().value())];
+    std::move(done).Run(
+        destination ? std::optional<base::FilePath>(base::FilePath(
+                          destination.path.fileSystemRepresentation))
+                    : std::nullopt);
+    return true;
+  }
+
+  // <input type=file> and the File System Access pickers open Rise's panels.
+  bool RunFileChooser(content::RenderFrameHost* frame,
+                      scoped_refptr<content::FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params) override {
+    using Mode = blink::mojom::FileChooserParams::Mode;
+    RCBrowserView* view = view_;
+    if (!view) {
+      return false;
+    }
+    Mode mode = params.mode;
+    RCFileChooserMode chooser =
+        mode == Mode::kOpenMultiple ? RCFileChooserModeOpenMultiple
+        : mode == Mode::kUploadFolder || mode == Mode::kOpenDirectory
+            ? RCFileChooserModeOpenFolder
+        : mode == Mode::kSave ? RCFileChooserModeSave
+                              : RCFileChooserModeOpen;
+    // The kinds of file it takes, as extensions: ".png", or those of a type,
+    // such as image/*.
+    NSMutableOrderedSet<NSString*>* extensions = [NSMutableOrderedSet orderedSet];
+    for (const std::u16string& type : params.accept_types) {
+      std::string accept = base::ToLowerASCII(base::UTF16ToUTF8(type));
+      std::vector<base::FilePath::StringType> found;
+      if (accept.starts_with(".")) {
+        found.push_back(accept.substr(1));
+      } else {
+        net::GetExtensionsForMimeType(accept, &found);
+      }
+      for (const base::FilePath::StringType& extension : found) {
+        [extensions addObject:base::SysUTF8ToNSString(extension)];
+      }
+    }
+    return [view chooseFiles:chooser
+                       title:base::SysUTF16ToNSString(params.title)
+                 defaultPath:base::SysUTF8ToNSString(params.default_file_name.value())
+                  extensions:extensions.array
+                  completion:^(NSArray<NSURL*>* urls) {
+                    if (!urls.count) {
+                      listener->FileSelectionCanceled();
+                      return;
+                    }
+                    std::vector<base::FilePath> paths;
+                    for (NSURL* url in urls) {
+                      paths.emplace_back(url.path.fileSystemRepresentation);
+                    }
+                    if (mode != Mode::kUploadFolder) {
+                      listener->FileSelected(FileInfos(paths), base::FilePath(),
+                                             mode);
+                      return;
+                    }
+                    // A folder to upload gives the page every file in it.
+                    base::ThreadPool::PostTaskAndReplyWithResult(
+                        FROM_HERE,
+                        {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+                        base::BindOnce(
+                            [](base::FilePath folder) {
+                              std::vector<base::FilePath> files;
+                              base::FileEnumerator each(
+                                  folder, /*recursive=*/true,
+                                  base::FileEnumerator::FILES);
+                              for (base::FilePath file = each.Next();
+                                   !file.empty(); file = each.Next()) {
+                                files.push_back(file);
+                              }
+                              return files;
+                            },
+                            paths[0]),
+                        base::BindOnce(
+                            [](scoped_refptr<content::FileSelectListener> listener,
+                               base::FilePath folder,
+                               std::vector<base::FilePath> files) {
+                              listener->FileSelected(FileInfos(files), folder,
+                                                     Mode::kUploadFolder);
+                            },
+                            listener, paths[0]));
+                  }];
+  }
+
+ private:
+  __weak RCBrowserView* view_;
+  RiseDialogs dialogs_;
+};
