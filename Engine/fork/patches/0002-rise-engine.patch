+// What a page takes as soon as it's the view's.
+- (void)tookContents {
+  // Its permission requests are asked in Rise's prompt.
+  if (auto* permissions =
+          permissions::PermissionRequestManager::FromWebContents(_contents)) {
+    permissions->set_view_factory_for_testing(
+        base::BindRepeating(&MakePermissionPrompt));
+  }
+  _observer = std::make_unique<TabObserver>(self, _contents);
+  [Views() setObject:self forKey:[NSValue valueWithPointer:_contents]];
+  _contents->SetPageBaseBackgroundColor(
+      skia::NSDeviceColorToSkColor([_pageBackgroundColor
+          colorUsingColorSpace:NSColorSpace.deviceRGBColorSpace]));
+  NSView* page = _contents->GetNativeView().GetNativeNSView();
+  page.frame = self.bounds;
+  page.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [self addSubview:page];
+  if (_zoom != 1) {
+    self.zoom = _zoom;
+  }
+  if (_pendingState || _pendingURL) {
+    NSData* state = _pendingState;
+    NSURL* url = _pendingURL;
+    _pendingState = nil;
+    _pendingURL = nil;
+    if (!state || ![self restore:state]) {
+      [self loadURL:url];
+    }
+  }
+  // A DevTools front end: its page makes Chrome's bindings as it starts
+  // loading, which then take the page it inspects, as for Chrome's own window.
+  RCBrowserView* inspected = _inspected;
+  if (DevToolsUIBindings* bindings =
+          inspected && [inspected contents]
+              ? DevToolsUIBindings::ForWebContents(_contents)
+              : nullptr) {
+    bindings->SetDelegate(new DevToolsFrontend(self));
+    bindings->AttachTo(
+        content::DevToolsAgentHost::GetOrCreateFor([inspected contents]));
+  }
+  [NSNotificationCenter.defaultCenter postNotificationName:kPageMadeNotification
+                                                    object:self];
+}
