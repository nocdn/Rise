+namespace {
+
+// Rise's ad-blocking engine (Engine/adblock), which Rise's app holds and hands
+// over as it starts (Sources/RiseFork): the framework keeps Chrome's own Rust.
+struct AdBlockEngine {
+  bool (*load)() = nullptr;
+  bool (*blocks)(const char* url, const char* source, const char* kind) =
+      nullptr;
+  char* (*hidden)(const char* url, const char* classes, const char* ids) =
+      nullptr;
+  void (*free_string)(char* value) = nullptr;
+};
+AdBlockEngine g_ad_block;
+std::atomic<bool> g_ad_block_enabled{true};
+
+// The engine's name for what a request fetches; null for a page itself, which,
+// as on WebKit, is never blocked.
+const char* AdBlockKind(network::mojom::RequestDestination destination) {
+  using Destination = network::mojom::RequestDestination;
+  switch (destination) {
+    case Destination::kDocument:
+      return nullptr;
+    case Destination::kIframe:
+    case Destination::kFrame:
+    case Destination::kFencedframe:
+      return "sub_frame";
+    case Destination::kStyle:
+      return "stylesheet";
+    case Destination::kScript:
+    case Destination::kWorker:
+    case Destination::kSharedWorker:
+    case Destination::kServiceWorker:
+      return "script";
+    case Destination::kImage:
+      return "image";
+    case Destination::kFont:
+      return "font";
+    case Destination::kObject:
+    case Destination::kEmbed:
+      return "object";
+    case Destination::kAudio:
+    case Destination::kVideo:
+    case Destination::kTrack:
+      return "media";
+    case Destination::kEmpty:
+      return "xmlhttprequest";
+    case Destination::kReport:
+      return "csp_report";
+    default:
+      return "other";
+  }
+}
+
+// In front of Chrome's URL loader factory for a page or worker: what the
+// lists block fails as blocked, the rest goes on untouched.
+class AdBlockingFactory : public network::mojom::URLLoaderFactory {
+ public:
+  static void Start(content::RenderFrameHost* frame,
+                    const url::Origin& initiator,
+                    network::URLLoaderFactoryBuilder& builder) {
+    auto [receiver, target] = builder.Append();
+    new AdBlockingFactory(frame, initiator, std::move(receiver),
+                          std::move(target));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override {
+    if (Blocks(request)) {
+      mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+          ->OnComplete(
+              network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    target_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                  request, std::move(client),
+                                  traffic_annotation);
+  }
+  void Clone(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) override {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+ private:
+  AdBlockingFactory(
+      content::RenderFrameHost* frame,
+      const url::Origin& initiator,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target)
+      : frame_(frame ? frame->GetGlobalId()
+                     : content::GlobalRenderFrameHostId()),
+        initiator_(initiator),
+        target_(std::move(target)) {
+    receivers_.Add(this, std::move(receiver));
+    receivers_.set_disconnect_handler(base::BindRepeating(
+        &AdBlockingFactory::OnDisconnect, base::Unretained(this)));
+    target_.set_disconnect_handler(base::BindOnce(
+        &AdBlockingFactory::OnTargetGone, base::Unretained(this)));
+  }
+
+  bool Blocks(const network::ResourceRequest& request) {
+    const char* kind = AdBlockKind(request.destination);
+    if (!kind || !g_ad_block.blocks || !g_ad_block_enabled) {
+      return false;
+    }
+    // Rules name sites by the page the person is on, as WebKit's do.
+    std::string source;
+    if (content::RenderFrameHost* frame =
+            content::RenderFrameHost::FromID(frame_)) {
+      source = frame->GetOutermostMainFrame()->GetLastCommittedURL().spec();
+    }
+    if (source.empty() || source == "about:blank") {
+      source = request.request_initiator
+                   ? request.request_initiator->GetURL().spec()
+                   : initiator_.GetURL().spec();
+    }
+    if (source.empty() || !request.url.SchemeIsHTTPOrHTTPS()) {
+      return false;
+    }
+    return g_ad_block.blocks(request.url.spec().c_str(), source.c_str(), kind);
+  }
+
+  void OnDisconnect() {
+    if (receivers_.empty()) {
+      delete this;
+    }
+  }
+  void OnTargetGone() { delete this; }
+
+  content::GlobalRenderFrameHostId frame_;
+  url::Origin initiator_;
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> receivers_;
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+};
+
+}  // namespace
+
+void InstallAdBlocking() {
+  SetEmbedderURLLoaderFactoryFilter(base::BindRepeating(&AdBlockingFactory::Start));
+}
+
+// Given by Rise's app as it starts.
+extern "C" RC_EXPORT void RCAdBlockUseEngine(
+    bool (*load)(),
+    bool (*blocks)(const char*, const char*, const char*),
+    char* (*hidden)(const char*, const char*, const char*),
+    void (*free_string)(char*)) {
+  g_ad_block = {load, blocks, hidden, free_string};
+}
+
+@implementation RCAdBlock
++ (BOOL)available {
+  return g_ad_block.blocks != nullptr;
+}
++ (BOOL)enabled {
+  return g_ad_block_enabled;
+}
++ (void)setEnabled:(BOOL)enabled {
+  g_ad_block_enabled = enabled;
+}
++ (void)load {
+  if (bool (*load)() = g_ad_block.load) {
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      load();
+    });
+  }
+}
++ (NSArray<NSString*>*)hiddenSelectorsForURL:(NSURL*)url
+                                     classes:(NSArray<NSString*>*)classes
+                                         ids:(NSArray<NSString*>*)ids {
+  if (!g_ad_block.hidden || !g_ad_block_enabled || !url.absoluteString) {
+    return @[];
+  }
+  NSString* (^json)(NSArray*) = ^NSString*(NSArray* names) {
+    NSData* data = names ? [NSJSONSerialization dataWithJSONObject:names
+                                                           options:0
+                                                             error:nil]
+                         : nil;
+    return data ? [[NSString alloc] initWithData:data
+                                        encoding:NSUTF8StringEncoding]
+                : nil;
+  };
+  NSString* classList = json(classes);
+  NSString* idList = json(ids);
+  char* result = g_ad_block.hidden(url.absoluteString.UTF8String,
+                                   classList.UTF8String, idList.UTF8String);
+  if (!result) {
+    return @[];
+  }
+  NSData* data = [NSData dataWithBytes:result length:strlen(result)];
+  g_ad_block.free_string(result);
+  NSArray* selectors = [NSJSONSerialization JSONObjectWithData:data
+                                                       options:0
+                                                         error:nil];
+  return [selectors isKindOfClass:NSArray.class] ? selectors : @[];
+}
+@end
