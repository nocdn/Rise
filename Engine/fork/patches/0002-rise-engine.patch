+- (void)snapshotWithCompletion:(void (^)(NSImage*))completion {
+  content::RenderWidgetHostView* view =
+      _contents ? _contents->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    completion(nil);
+    return;
+  }
+  NSSize size = self.bounds.size;
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Seconds(5),
+      base::BindOnce(
+          [](void (^completion)(NSImage*), NSSize size,
+             const content::CopyFromSurfaceResult& result) {
+            NSImage* image =
+                result.has_value() ? skia::SkBitmapToNSImage(result->bitmap)
+                                   : nil;
+            if (image && size.width > 0 && size.height > 0) {
+              image.size = size;
+            }
+            completion(image);
+          },
+          completion, size));
+}
