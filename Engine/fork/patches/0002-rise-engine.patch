+extern "C" int ChromeMain(int argc, const char** argv);
+
+namespace {
+
+bool g_start_requested = false;
+bool g_started = false;
+std::vector<std::string>& Arguments() {
+  static base::NoDestructor<std::vector<std::string>> arguments;
+  return *arguments;
+}
+// Rise's app delegate, until Chrome's AppController is in place and the
+// browser has started; then it hears that the app finished launching.
+id<NSApplicationDelegate> g_rise_delegate = nil;
+NSMutableArray<void (^)(void)>* g_waiting_for_start = nil;
+
+Profile* RiseProfile() {
+  return g_started ? ProfileManager::GetLastUsedProfile() : nullptr;
+}
+
+// Every Rise page so far is a tab in one Browser, whose window is Rise's. Stage
+// 1 gives each Rise window its own (RCTabStrip).
+BrowserWindowInterface* SharedBrowser() {
+  static BrowserWindowInterface* browser = nullptr;
+  if (!browser && RiseProfile()) {
+    BrowserWindowCreateParams params(RiseProfile(), /*from_user_gesture=*/false);
+    // A window of Rise's: Chrome makes the Browser, not a window of its own.
+    params.window = new RiseBrowserWindow();
+    params.embedder_window = true;
+    browser = CreateBrowserWindow(std::move(params));
+  }
+  return browser;
+}
+
+NSURL* ToNSURL(const GURL& url) {
+  return url.is_valid() ? [NSURL URLWithString:base::SysUTF8ToNSString(url.spec())]
+                        : nil;
+}
+
+// Chromium's values, as Foundation's, through JSON.
+id ToObject(const base::Value& value) {
+  std::optional<std::string> json = base::WriteJson(value);
+  if (!json) {
+    return nil;
+  }
+  NSData* data = [base::SysUTF8ToNSString(*json) dataUsingEncoding:NSUTF8StringEncoding];
+  return [NSJSONSerialization JSONObjectWithData:data
+                                         options:NSJSONReadingFragmentsAllowed
+                                           error:nil];
+}
+
+NSString* ToJSON(id object) {
+  if (!object) {
+    return @"null";
+  }
+  NSData* data = [NSJSONSerialization dataWithJSONObject:object
+                                                 options:NSJSONWritingFragmentsAllowed
+                                                   error:nil];
+  return data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding]
+              : @"null";
+}
+
+// A world of Rise's own for each name: the page's scripts can't see it.
+int32_t WorldID(NSString* world) {
+  static NSMutableDictionary<NSString*, NSNumber*>* ids =
+      [NSMutableDictionary dictionary];
+  if (!world.length) {
+    return content::ISOLATED_WORLD_ID_GLOBAL;
+  }
+  NSNumber* known = ids[world];
+  if (!known) {
+    known = @(1000 + (int)ids.count);
+    ids[world] = known;
+  }
+  return known.intValue;
+}
+
+// The layer Chromium shows its GPU process's frames through, in the page's
+// layers.
+CALayer* ContentHost(CALayer* layer) {
+  if ([NSStringFromClass(layer.class) isEqualToString:@"CALayerHost"]) {
+    return layer;
+  }
+  for (CALayer* sublayer in layer.sublayers) {
+    if (CALayer* host = ContentHost(sublayer)) {
+      return host;
+    }
+  }
+  return nil;
+}
