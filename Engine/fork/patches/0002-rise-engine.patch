+// Under something else, such as a Peek or a notice: Chromium's mouse tracking
+// is set aside, so the page takes no hover and sets no cursor through it.
+- (void)setCovered:(BOOL)covered {
+  if (covered == _covered) {
+    return;
+  }
+  _covered = covered;
+  if (covered) {
+    _parkedAreas = [NSMapTable strongToStrongObjectsMapTable];
+    [self parkTrackingAreasIn:self];
+  } else {
+    for (NSView* view in _parkedAreas) {
+      for (NSTrackingArea* area in [_parkedAreas objectForKey:view]) {
