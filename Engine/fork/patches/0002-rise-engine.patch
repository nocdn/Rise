+// A page's request for camera, microphone or location, asked in Rise's own
+// prompt, which keeps its decisions itself: Chrome grants for the page only,
+// and keeps no denial, so it asks again next time and Rise answers.
+class RisePermissionPrompt : public permissions::PermissionPrompt {
+ public:
+  RisePermissionPrompt(content::WebContents* contents, Delegate* delegate)
+      : delegate_(delegate->GetWeakPtr()), view_(ViewOf(contents)) {
+    RCPermission asked = 0;
+    bool others = false;
+    for (const auto& request : delegate->Requests()) {
+      switch (request->request_type()) {
+        case permissions::RequestType::kCameraStream:
+          asked |= RCPermissionCamera;
+          break;
+        case permissions::RequestType::kMicStream:
+          asked |= RCPermissionMicrophone;
+          break;
+        case permissions::RequestType::kGeolocation:
+          asked |= RCPermissionLocation;
+          break;
+        default:
+          others = true;
+      }
+    }
+    base::WeakPtr<RisePermissionPrompt> weak = weak_factory_.GetWeakPtr();
+    void (^decide)(RCPermission) = ^(RCPermission allowed) {
+      // Decided on a later turn: the request manager takes this prompt as
+      // its view once it's made.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&RisePermissionPrompt::Decide, weak,
+                                    allowed == asked && !others));
+    };
+    // The rest stay denied.
+    if (others || !asked ||
+        ![view_ requestPermissions:asked
+                            origin:base::SysUTF8ToNSString(
+                                       url::Origin::Create(
+                                           delegate->GetRequestingOrigin())
+                                           .Serialize())
+                            decide:decide]) {
+      decide(0);
+    }
+  }
+  ~RisePermissionPrompt() override {
+    if (!decided_) {
+      [view_ withdrawPermissionRequest];
+    }
+  }
+
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override {
+    return kKeepPromptAlive;
+  }
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override {
+    return permissions::PermissionPromptDisposition::CUSTOM_MODAL_DIALOG;
+  }
+  bool IsAskPrompt() const override { return true; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return std::nullopt;
+  }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants()
+      const override {
+    return {};
+  }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override {
+    return std::nullopt;
+  }
+
+ private:
+  void Decide(bool allowed) {
+    Delegate* delegate = delegate_.get();
+    if (!delegate || decided_ || delegate->Requests().empty()) {
+      return;
+    }
+    decided_ = true;
+    // Location may come with a choice of how precisely; Rise's is precise.
+    bool options = delegate->Requests()[0]->GetContentSettingsType() ==
+                   ContentSettingsType::GEOLOCATION_WITH_OPTIONS;
+    PromptOptions prompt_options =
+        options ? PromptOptions(GeolocationPromptOptions{
+                      GeolocationAccuracy::kPrecise})
+                : PromptOptions(std::monostate());
+    if (allowed) {
+      delegate->AcceptThisTime(prompt_options);
+      return;
+    }
+    GURL origin = delegate->GetRequestingOrigin();
+    std::vector<ContentSettingsType> types;
+    for (const auto& request : delegate->Requests()) {
+      types.push_back(request->GetContentSettingsType());
+    }
+    content::WebContents* contents = delegate->GetAssociatedWebContents();
+    delegate->Deny(prompt_options);
+    if (!contents) {
+      return;
+    }
+    HostContentSettingsMap* settings =
+        HostContentSettingsMapFactory::GetForProfile(
+            contents->GetBrowserContext());
+    for (ContentSettingsType type : types) {
+      settings->SetContentSettingDefaultScope(origin, GURL(), type,
+                                              CONTENT_SETTING_DEFAULT);
+    }
+  }
+
+  base::WeakPtr<Delegate> delegate_;
+  __weak RCBrowserView* view_;
+  bool decided_ = false;
+  base::WeakPtrFactory<RisePermissionPrompt> weak_factory_{this};
+};
+
+std::unique_ptr<permissions::PermissionPrompt> MakePermissionPrompt(
+    content::WebContents* contents,
+    permissions::PermissionPrompt::Delegate* delegate) {
+  return std::make_unique<RisePermissionPrompt>(contents, delegate);
+}
