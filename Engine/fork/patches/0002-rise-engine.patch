+namespace {
+
+v8::Local<v8::String> V8String(v8::Isolate* isolate, const std::string& text) {
+  return v8::String::NewFromUtf8(isolate, text.data(),
+                                 v8::NewStringType::kNormal,
+                                 static_cast<int>(text.size()))
+      .ToLocalChecked();
+}
+
+// Gives one of Rise's worlds its name, as DevTools lists it, once a process.
+void NameWorld(int32_t world_id, const std::string& name) {
+  static base::NoDestructor<std::set<int32_t>> named;
+  if (!named->insert(world_id).second) {
+    return;
+  }
+  blink::WebIsolatedWorldInfo info;
+  info.human_readable_name = blink::WebString::FromUtf8(name);
+  info.stable_id = blink::WebString::FromUtf8("rise:" + name);
+  blink::SetIsolatedWorldInfo(world_id, info);
+}
+
+// riseHandlers.<name>.postMessage(body). Its data holds the handler's name,
+// whether it replies and the world, as own properties the page can't change.
+void PostMessage(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  if (!info.Data()->IsArray()) {
+    return;
+  }
+  v8::Local<v8::Array> data = info.Data().As<v8::Array>();
+  v8::Local<v8::Value> name, replies, world;
+  if (!data->Get(context, 0).ToLocal(&name) ||
+      !data->Get(context, 1).ToLocal(&replies) ||
+      !data->Get(context, 2).ToLocal(&world) || !name->IsString()) {
+    return;
+  }
+  blink::WebLocalFrame* web_frame =
+      blink::WebLocalFrame::FrameForContext(context);
+  content::RenderFrame* frame =
+      web_frame ? content::RenderFrame::FromWebFrame(web_frame) : nullptr;
+  RiseFrameAgent* agent = frame ? RiseFrameAgent::Get(frame) : nullptr;
+  if (!agent) {
+    return;
+  }
+  std::unique_ptr<base::Value> body = content::V8ValueConverter::Create()->FromV8Value(
+      info.Length() ? info[0] : v8::Undefined(isolate).As<v8::Value>(), context);
+  v8::Local<v8::Promise::Resolver> reply;
+  if (replies->IsTrue()) {
+    if (!v8::Promise::Resolver::New(context).ToLocal(&reply)) {
+      return;
+    }
+    info.GetReturnValue().Set(reply->GetPromise());
+  }
+  agent->Post(*v8::String::Utf8Value(isolate, name),
+              world->Int32Value(context).FromMaybe(0),
+              body ? std::move(*body) : base::Value(), context, reply);
+}
+
+}  // namespace
+
+RiseFrameAgent::Reply::Reply() = default;
+RiseFrameAgent::Reply::Reply(Reply&&) = default;
+RiseFrameAgent::Reply::~Reply() = default;
+
+RiseFrameAgent::RiseFrameAgent(content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame),
+      content::RenderFrameObserverTracker<RiseFrameAgent>(render_frame),
+      handlers_key_("__rise" + base::Uuid::GenerateRandomV4().AsLowercaseString()) {
+  // A frame made in this process, as by a page's script, starts with its
+  // parent's scripts, before the browser sends them.
+  blink::WebFrame* parent = render_frame->GetWebFrame()->Parent();
+  if (parent && parent->IsWebLocalFrame()) {
+    if (RiseFrameAgent* agent = Get(
+            content::RenderFrame::FromWebFrame(parent->ToWebLocalFrame()))) {
+      scripts_ = mojo::Clone(agent->scripts_);
+    }
+  }
+}
+
+RiseFrameAgent::~RiseFrameAgent() = default;
+
+bool RiseFrameAgent::OnAssociatedInterfaceRequestForFrame(
+    const std::string& interface_name,
+    mojo::ScopedInterfaceEndpointHandle* handle) {
+  if (interface_name != mojom::RiseFrame::Name_) {
+    return false;
+  }
+  receivers_.Add(this, mojo::PendingAssociatedReceiver<mojom::RiseFrame>(
+                           std::move(*handle)));
+  return true;
+}
+
+void RiseFrameAgent::DidCreateNewDocument() {
+  started_ = false;
+  // Replies to the document before go nowhere.
+  replies_.clear();
+}
+
+// static
+bool RiseFrameAgent::RunScriptsAtDocumentStart(
+    content::RenderFrame* render_frame) {
+  RiseFrameAgent* agent = Get(render_frame);
+  if (!agent) {
+    return true;
+  }
+  base::WeakPtr<RiseFrameAgent> alive = agent->weak_factory_.GetWeakPtr();
+  agent->DocumentStarted();
+  return !!alive;
+}
+
+void RiseFrameAgent::DocumentStarted() {
+  started_ = true;
+  std::vector<mojom::ScriptPtr> scripts = mojo::Clone(scripts_);
+  for (const mojom::ScriptPtr& script : scripts) {
+    Run(*script);
+  }
+}
+
+void RiseFrameAgent::OnDestruct() {
+  delete this;
+}
+
+void RiseFrameAgent::SetScripts(
+    std::vector<mojom::ScriptPtr> scripts,
+    mojo::PendingAssociatedRemote<mojom::RiseFrameHost> host) {
+  scripts_ = std::move(scripts);
+  if (!host) {
+    return;
+  }
+  host_.reset();
+  host_.Bind(std::move(host));
+  std::vector<base::OnceClosure> waiting = std::move(waiting_);
+  for (base::OnceClosure& send : waiting) {
+    std::move(send).Run();
+  }
+}
+
+void RiseFrameAgent::AddScript(mojom::ScriptPtr script) {
+  if (started_) {
+    Run(*script);
+  }
+  scripts_.push_back(std::move(script));
+}
+
+namespace {
+
+// The handlers a script may post to, as riseHandlers, in `context`.
+v8::Local<v8::Object> MakeHandlers(v8::Isolate* isolate,
+                                   v8::Local<v8::Context> context,
+                                   const mojom::Script& script) {
+  v8::Local<v8::Object> handlers = v8::Object::New(isolate);
+  for (const mojom::HandlerPtr& handler : script.handlers) {
+    v8::Local<v8::Array> data = v8::Array::New(isolate, 3);
+    v8::Local<v8::Function> post;
+    v8::Local<v8::Object> entry = v8::Object::New(isolate);
+    if (data->CreateDataProperty(context, 0, V8String(isolate, handler->name))
+            .IsNothing() ||
+        data->CreateDataProperty(context, 1,
+                                 v8::Boolean::New(isolate, handler->replies))
+            .IsNothing() ||
+        data->CreateDataProperty(context, 2,
+                                 v8::Integer::New(isolate, script.world_id))
+            .IsNothing() ||
+        !v8::Function::New(context, &PostMessage, data, 1).ToLocal(&post) ||
+        entry->CreateDataProperty(context, V8String(isolate, "postMessage"), post)
+            .IsNothing() ||
+        handlers->CreateDataProperty(context, V8String(isolate, handler->name),
+                                     entry)
+            .IsNothing()) {
+      continue;
+    }
+  }
+  return handlers;
+}
+
+}  // namespace
+
+void RiseFrameAgent::Run(const mojom::Script& script) {
+  content::RenderFrame* frame = render_frame();
+  if (script.main_frame_only &&
+      (!frame->IsMainFrame() || frame->IsInFencedFrameTree())) {
+    return;
+  }
+  blink::WebLocalFrame* web_frame = frame->GetWebFrame();
+  v8::Isolate* isolate = web_frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  if (script.world_id == 0) {
+    RunInPage(script);
+    return;
+  }
+  // In Rise's world, the script runs as the body of a function given its
+  // handlers, so they're its alone.
+  NameWorld(script.world_id, script.world_name);
+  v8::Local<v8::Value> function =
+      web_frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+          script.world_id,
+          blink::WebScriptSource(blink::WebString::FromUtf8(
+              "(function(riseHandlers) {\n" + script.source + "\n})")),
+          blink::BackForwardCacheAware::kAllow);
+  v8::Local<v8::Context> context =
+      web_frame->GetScriptContextFromWorldId(isolate, script.world_id);
+  if (function.IsEmpty() || !function->IsFunction() || context.IsEmpty()) {
+    return;
+  }
+  v8::Context::Scope context_scope(context);
+  v8::Local<v8::Value> argv[] = {MakeHandlers(isolate, context, script)};
+  std::ignore = web_frame->ExecuteMethodAndReturnValue(
+      function.As<v8::Function>(), v8::Undefined(isolate), 1, argv);
+}
+
+// In the page's own world, as the page's own scripts run (so that, say, its
+// import()s resolve against the page): the handlers wait on the window under a
+// name of the agent's own, which the script takes and deletes as it starts,
+// before any of the page's scripts could see them.
+void RiseFrameAgent::RunInPage(const mojom::Script& script) {
+  blink::WebLocalFrame* web_frame = render_frame()->GetWebFrame();
+  v8::Isolate* isolate = web_frame->GetAgentGroupScheduler()->Isolate();
+  v8::Local<v8::Context> context = web_frame->MainWorldScriptContext();
+  if (context.IsEmpty()) {
+    return;
+  }
+  v8::Context::Scope context_scope(context);
+  v8::Local<v8::String> key = V8String(isolate, handlers_key_);
+  if (context->Global()
+          ->DefineOwnProperty(context, key,
+                              MakeHandlers(isolate, context, script),
+                              v8::DontEnum)
+          .IsNothing()) {
+    return;
+  }
+  std::string take = "(() => { const handlers = globalThis['" + handlers_key_ +
+                     "']; delete globalThis['" + handlers_key_ +
+                     "']; return handlers; })()";
+  blink::WebScriptSource source(blink::WebString::FromUtf8(
+      "(function(riseHandlers) {\n" + script.source + "\n})(" + take + ")"));
+  web_frame->RequestExecuteScript(
+      /*world_id=*/0, base::span_from_ref(source),
+      blink::mojom::UserActivationOption::kDoNotActivate,
+      blink::mojom::EvaluationTiming::kSynchronous,
+      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
+      blink::WebScriptExecutionCallback(), blink::BackForwardCacheAware::kAllow,
+      blink::mojom::WantResultOption::kNoResult,
+      blink::mojom::PromiseResultOption::kDoNotWait, blink::WebString());
+  // Gone already, unless the script didn't run.
+  std::ignore = context->Global()->Delete(context, key);
+}
+
+void RiseFrameAgent::Post(const std::string& handler,
+                          int32_t world_id,
+                          base::Value body,
+                          v8::Local<v8::Context> context,
+                          v8::Local<v8::Promise::Resolver> reply) {
+  int id = 0;
+  if (!reply.IsEmpty()) {
+    id = ++next_reply_;
+    v8::Isolate* isolate = v8::Isolate::GetCurrent();
+    Reply& waiting = replies_[id];
+    waiting.context.Reset(isolate, context);
+    waiting.resolver.Reset(isolate, reply);
+  }
+  base::OnceClosure send = base::BindOnce(
+      [](base::WeakPtr<RiseFrameAgent> agent, std::string handler,
+         int32_t world_id, base::Value body, int id) {
+        if (!agent || !agent->host_) {
+          return;
+        }
+        if (!id) {
+          agent->host_->PostMessage(handler, world_id, std::move(body));
+          return;
+        }
+        agent->host_->PostMessageWithReply(
+            handler, world_id, std::move(body),
+            base::BindOnce(&RiseFrameAgent::Replied, agent, id));
+      },
+      weak_factory_.GetWeakPtr(), handler, world_id, std::move(body), id);
+  if (host_) {
+    std::move(send).Run();
+  } else {
+    waiting_.push_back(std::move(send));
+  }
+}
+
+void RiseFrameAgent::Replied(int id,
+                             base::Value reply,
+                             const std::optional<std::string>& error) {
+  auto it = replies_.find(id);
+  if (it == replies_.end()) {
+    return;
+  }
+  Reply waiting = std::move(it->second);
+  replies_.erase(it);
+  blink::WebLocalFrame* web_frame = render_frame()->GetWebFrame();
+  v8::Isolate* isolate = web_frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Context> context = waiting.context.Get(isolate);
+  // Only to the document that asked.
+  if (context.IsEmpty() ||
+      blink::WebLocalFrame::FrameForContext(context) != web_frame) {
+    return;
+  }
+  v8::Context::Scope context_scope(context);
+  v8::MicrotasksScope microtasks(context,
+                                 v8::MicrotasksScope::kRunMicrotasks);
+  v8::Local<v8::Promise::Resolver> resolver = waiting.resolver.Get(isolate);
+  if (error) {
+    std::ignore = resolver->Reject(
+        context, v8::Exception::Error(V8String(isolate, *error)));
+  } else {
+    std::ignore = resolver->Resolve(
+        context, content::V8ValueConverter::Create()->ToV8Value(reply, context));
+  }
+}
+
+}  // namespace rise
