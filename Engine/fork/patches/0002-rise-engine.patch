+// An extension's popup's page: not a tab, as Chrome's own popups aren't, sized
+// as Chrome sizes them, to what they show. What it opens goes to the window the
+// person is in.
+class PopupDelegate : public content::WebContentsDelegate,
+                      public content::WebContentsObserver {
+ public:
+  explicit PopupDelegate(RCBrowserView* view) : view_(view) {}
+
+  using content::WebContentsObserver::Observe;
+
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    // A main frame, made as the popup's page starts loading, before it's the
+    // page's.
+    if (!frame->GetParentOrOuterDocument() && frame->GetView()) {
+      frame->GetView()->EnableAutoResize(gfx::Size(25, 25),
+                                         gfx::Size(800, 600));
+    }
+  }
+  void ResizeDueToAutoResize(content::WebContents* source,
+                             const gfx::Size& size) override {
+    RCBrowserView* view = view_;
+    if ([view.delegate respondsToSelector:@selector(browserView:
+                                              didChangePreferredSize:)]) {
+      [view.delegate browserView:view
+          didChangePreferredSize:NSMakeSize(size.width(), size.height())];
+    }
+  }
+
+  void CloseContents(content::WebContents* source) override {
+    RCBrowserView* view = view_;
+    if ([view.delegate
+            respondsToSelector:@selector(browserViewDidRequestClose:)]) {
+      [view.delegate browserViewDidRequestClose:view];
+    }
+  }
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)> callback) override {
+    if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    BrowserWindowInterface* browser = LastActiveShownBrowser();
+    return browser ? browser->OpenURL(params, std::move(callback)) : nullptr;
+  }
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    BrowserWindowInterface* browser = LastActiveShownBrowser();
+    return browser ? BrowserWebContentsDelegate::From(browser)->AddNewContents(
+                         source, std::move(new_contents), target_url,
+                         disposition, features, user_gesture, was_blocked)
+                   : nullptr;
+  }
+
+ private:
+  __weak RCBrowserView* view_;
+};
