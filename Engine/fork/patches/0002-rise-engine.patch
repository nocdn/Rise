+  }
+  return [[RCLiveLayer alloc] initWithPage:self rect:rect];
+}
+
+- (void)snapshotWithCompletion:(void (^)(NSImage*))completion {
+  content::RenderWidgetHostView* view =
+      _contents ? _contents->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    completion(nil);
+    return;
+  }
+  NSSize size = self.bounds.size;
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Seconds(5),
+      base::BindOnce(
+          [](void (^completion)(NSImage*), NSSize size,
+             const content::CopyFromSurfaceResult& result) {
+            NSImage* image =
+                result.has_value() ? skia::SkBitmapToNSImage(result->bitmap)
+                                   : nil;
+            if (image && size.width > 0 && size.height > 0) {
+              image.size = size;
+            }
+            completion(image);
+          },
+          completion, size));
+}
+
+- (void)close {
+  if (_closed) {
+    return;
+  }
+  _closed = YES;
+  _observer.reset();
+  content::WebContents* contents = _contents;
+  _contents = nullptr;
+  BrowserWindowInterface* browser = SharedBrowser();
+  if (!contents || !browser) {
+    return;
+  }
+  [contents->GetNativeView().GetNativeNSView() removeFromSuperview];
+  TabStripModel* tabs = browser->GetTabStripModel();
+  int index = tabs->GetIndexOfWebContents(contents);
+  if (index != TabStripModel::kNoTab) {
+    tabs->DetachAndDeleteWebContentsAt(index);
+  }
+}
