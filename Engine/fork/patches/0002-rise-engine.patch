+- (void)close {
+  if (_closed) {
+    return;
+  }
+  _closed = YES;
+  _observer.reset();
+  content::WebContents* contents = _contents;
+  _contents = nullptr;
+  [Views() removeObjectForKey:[NSValue valueWithPointer:contents]];
+  if (_popupContents) {
+    [_popupContents->GetNativeView().GetNativeNSView() removeFromSuperview];
+    _popupContents->SetDelegate(nullptr);
+    _popupDelegate.reset();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(_popupContents));
+    return;
+  }
+  BrowserWindowInterface* browser = BrowserOf(contents);
+  if (!contents || !browser) {
+    return;
+  }
+  [contents->GetNativeView().GetNativeNSView() removeFromSuperview];
+  // Deleted on the next turn: Rise may close a page from what the page is
+  // telling it, while Chrome is still telling everyone else.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents) {
+            BrowserWindowInterface* browser =
+                contents ? BrowserOf(contents.get()) : nullptr;
+            if (!browser) {
+              return;
+            }
+            TabStripModel* tabs = browser->GetTabStripModel();
+            int index = tabs->GetIndexOfWebContents(contents.get());
+            if (index != TabStripModel::kNoTab) {
+              tabs->DetachAndDeleteWebContentsAt(index);
+            }
+          },
+          contents->GetWeakPtr()));
+}
