+- (instancetype)initWithFrame:(NSRect)frame URL:(NSURL*)url {
+  if (!(self = [super initWithFrame:frame])) {
+    return nil;
+  }
+  _pendingURL = url;
+  _scripts = [NSMutableArray array];
+  _handlers = [NSMutableDictionary dictionary];
+  _zoom = 1;
+  _pageBackgroundColor = NSColor.whiteColor;
+  self.wantsLayer = YES;
+  // Made on the next turn, so what Rise sets on the new view first, such as
+  // its theme's colour for before the page draws, is what Chromium starts with.
+  __weak RCBrowserView* weakSelf = self;
+  void (^make)(void) = ^{
+    [weakSelf browserStarted];
+  };
+  if (g_started) {
+    dispatch_async(dispatch_get_main_queue(), make);
+  } else {
+    if (!g_waiting_for_start) {
+      g_waiting_for_start = [NSMutableArray array];
+    }
+    [g_waiting_for_start addObject:make];
+  }
+  return self;
+}
