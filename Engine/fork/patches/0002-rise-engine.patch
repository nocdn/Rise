+- (void)evaluateFunctionBody:(NSString*)functionBody
+                   arguments:(NSDictionary<NSString*, id>*)arguments
+                       world:(NSString*)world
+                  completion:(void (^)(id))completion {
+  [self evaluateFunctionBody:functionBody
+                   arguments:arguments
+                       frame:nil
+                       world:world
+                  completion:^(id result, NSString* error) {
+                    completion(result);
+                  }];
+}
+
+- (void)evaluateFunctionBody:(NSString*)functionBody
+                   arguments:(NSDictionary<NSString*, id>*)arguments
+                       frame:(RCFrame*)frame
+                       world:(NSString*)world
+                  completion:(void (^)(id, NSString*))completion {
+  content::RenderFrameHost* host =
+      !_contents ? nullptr
+      : frame    ? content::RenderFrameHost::FromID([frame frameID])
+                 : _contents->GetPrimaryMainFrame();
+  if (!host || !host->IsRenderFrameLive() ||
+      content::WebContents::FromRenderFrameHost(host) != _contents) {
+    completion(nil, frame ? @"The frame isn't there" : @"The page isn't there");
+    return;
+  }
+  NSMutableArray* names = [NSMutableArray array];
+  NSMutableArray* values = [NSMutableArray array];
+  [arguments enumerateKeysAndObjectsUsingBlock:^(NSString* name, id value, BOOL*) {
+    [names addObject:name];
+    [values addObject:ToJSON(value)];
+  }];
+  // The body of an async function; its result, as JSON gives it back.
+  NSString* script = [NSString
+      stringWithFormat:@"(async function(%@) {\n%@\n})(%@)",
+                       [names componentsJoinedByString:@", "], functionBody,
+                       [values componentsJoinedByString:@", "]];
+  static_cast<content::RenderFrameHostImpl*>(host)->ExecuteJavaScriptForTests(
+      // Rise runs these for the user, as a button of its own does: media
+      // plays and windows open as they would from a click.
+      base::SysNSStringToUTF16(script), /*has_user_gesture=*/true,
+      /*resolve_promises=*/true, /*honor_js_content_settings=*/false,
+      WorldID(world),
+      // Answered even if the frame goes away first, as when it navigates.
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(
+          [](void (^completion)(id, NSString*),
+             blink::mojom::JavaScriptExecutionResultType type,
+             base::Value value) {
+            if (type == blink::mojom::JavaScriptExecutionResultType::kSuccess) {
+              completion(ToObject(value), nil);
+            } else {
+              completion(nil, value.is_string()
+                                  ? base::SysUTF8ToNSString(value.GetString())
+                                  : @"The script threw");
+            }
+          },
+          completion),
+          blink::mojom::JavaScriptExecutionResultType::kException,
+          base::Value("The frame went away")));
+}
+
+// MARK: Rise's scripts
+
+- (rise::mojom::ScriptPtr)frameScript:(NSDictionary*)script {
+  auto result = rise::mojom::Script::New();
+  NSString* world = script[@"world"];
+  result->source = base::SysNSStringToUTF8(script[@"source"]);
+  result->world_id = WorldID(world);
+  result->world_name = world ? base::SysNSStringToUTF8(world) : "";
+  result->main_frame_only = [script[@"mainFrameOnly"] boolValue];
+  for (NSArray* handler in script[@"handlers"]) {
+    result->handlers.push_back(rise::mojom::Handler::New(
+        base::SysNSStringToUTF8(handler[0]), [handler[1] boolValue]));
+  }
+  return result;
+}
+
+- (std::vector<rise::mojom::ScriptPtr>)frameScripts {
+  std::vector<rise::mojom::ScriptPtr> scripts;
+  for (NSDictionary* script in _scripts) {
+    scripts.push_back([self frameScript:script]);
+  }
+  return scripts;
+}
+
+// Tells every frame of the page: a new script runs in documents already
+// started as well as those to come; otherwise, the whole list again, for
+// documents to come.
+- (void)sendScripts:(NSDictionary*)added {
+  if (!_contents) {
+    return;
+  }
+  _contents->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+    if (!frame->IsRenderFrameLive()) {
+      return;
+    }
+    if (added && frame->IsActive()) {
+      AgentOf(frame)->AddScript([self frameScript:added]);
+    } else {
+      AgentOf(frame)->SetScripts([self frameScripts], mojo::NullAssociatedRemote());
+    }
+  });
+}
+
+- (void)addScript:(NSString*)source
+            world:(NSString*)world
+    mainFrameOnly:(BOOL)mainFrameOnly
+         handlers:(NSArray<NSString*>*)handlers {
+  NSMutableArray* given = [NSMutableArray array];
+  for (NSString* name in handlers) {
+    NSDictionary* handler = _handlers[name];
+    // A handler is for scripts in its own world.
+    if (handler && WorldID(handler[@"world"]) == WorldID(world)) {
+      [given addObject:@[ name, handler[@"replies"] ]];
+    }
+  }
+  NSMutableDictionary* script = [@{
+    @"source" : source ?: @"",
+    @"mainFrameOnly" : @(mainFrameOnly),
+    @"handlers" : given
+  } mutableCopy];
+  if (world.length) {
+    script[@"world"] = world;
+  }
+  [_scripts addObject:script];
+  [self sendScripts:script];
+}
+
+- (void)addScriptToEveryDocument:(NSString*)source world:(NSString*)world {
+  [self addScript:source world:world mainFrameOnly:NO handlers:@[]];
+}
+- (void)addMessageHandler:(NSString*)name
+                    world:(NSString*)world
+                  replies:(BOOL)replies {
+  NSMutableDictionary* handler = [@{@"replies" : @(replies)} mutableCopy];
+  if (world.length) {
+    handler[@"world"] = world;
+  }
+  _handlers[name] = handler;
+}
+- (void)addUserScript:(NSString*)source
+                world:(NSString*)world
+        mainFrameOnly:(BOOL)mainFrameOnly
+             handlers:(NSArray<NSString*>*)handlers {
+  [self addScript:source
+            world:world
+    mainFrameOnly:mainFrameOnly
+         handlers:handlers];
+}
+
+- (void)receivedMessage:(base::Value)body
+                handler:(const std::string&)handler
+                  world:(int32_t)world
+                  frame:(content::GlobalRenderFrameHostId)frameID
+                  reply:(void (^)(id, NSString*))reply {
+  NSString* name = base::SysUTF8ToNSString(handler);
+  NSDictionary* registered = _handlers[name];
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frameID);
+  // Only from scripts the handler was given to: in its world, and asking for
+  // a reply only if it replies.
+  if (!registered || !frame ||
+      content::WebContents::FromRenderFrameHost(frame) != _contents ||
+      WorldID(registered[@"world"]) != world ||
+      [registered[@"replies"] boolValue] != (reply != nil) ||
+      ![_delegate respondsToSelector:@selector
+                  (browserView:didReceiveMessage:handler:frame:reply:)]) {
+    if (reply) {
+      reply(nil, @"No handler");
+    }
+    return;
+  }
+  [_delegate browserView:self
+       didReceiveMessage:ToObject(body) ?: NSNull.null
+                 handler:name
+                   frame:[[RCFrame alloc] initWithFrame:frame world:world]
+                   reply:reply];
+}
+// Sends a DevTools protocol command to the page; nil result if it failed.
+- (void)devTools:(NSString*)method
+          params:(NSDictionary*)params
+           reply:(void (^)(NSDictionary*, NSDictionary*))reply {
+  if (!_contents) {
+    reply(nil, @{@"message" : @"The page isn't there"});
+    return;
+  }
+  if (!_devTools) {
+    _devTools = std::make_unique<DevToolsSession>(_contents);
+  }
+  _devTools->Send(method, params, reply);
+}
+- (void)devTools:(NSString*)method
+          params:(NSDictionary*)params
+      completion:(void (^)(NSDictionary*))completion {
+  [self devTools:method
+          params:params
+           reply:^(NSDictionary* result, NSDictionary*) {
+             completion(result);
+           }];
+}
+
+- (void)evaluateConsoleExpression:(NSString*)expression
+                       completion:(void (^)(id, NSString*))completion {
+  // As DevTools' console runs it: statements, let and await included.
+  NSDictionary* params = @{
+    @"expression" : expression,
+    @"replMode" : @YES,
+    @"awaitPromise" : @YES,
+    @"returnByValue" : @YES,
+    @"userGesture" : @YES
+  };
+  [self devTools:@"Runtime.evaluate"
+          params:params
+           reply:^(NSDictionary* result, NSDictionary* error) {
+             if (!result) {
+               completion(nil, error[@"message"] ?: @"The page went away");
+               return;
+             }
+             if (NSDictionary* exception = result[@"exceptionDetails"]) {
+               completion(nil, exception[@"exception"][@"description"]
+                                   ?: exception[@"text"]
+                                   ?: @"The script threw");
+               return;
+             }
+             NSDictionary* value = result[@"result"];
+             id shown = value[@"value"] ?: value[@"description"] ?: value[@"type"];
+             completion(shown == NSNull.null ? nil : shown, nil);
+           }];
+}
