+NSImage* ToNSImage(const gfx::ImageSkia& image) {
+  if (image.isNull()) {
+    return nil;
+  }
+  // Asking for each scale loads it, if it isn't yet.
+  image.GetRepresentation(1.0f);
+  image.GetRepresentation(2.0f);
+  return gfx::Image(image).ToNSImage();
+}
