+- (void)contentsGone {
+  _observer.reset();
+  [Views() removeObjectForKey:[NSValue valueWithPointer:_contents]];
+  _contents = nullptr;
+  // Chrome closing everything to quit leaves Rise's tabs as they were saved.
+  if (_closed || browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  _closed = YES;
+  if ([_delegate respondsToSelector:@selector(browserViewDidRequestClose:)]) {
+    [_delegate browserViewDidRequestClose:self];
+  }
+}
