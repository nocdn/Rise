+void BrowserStarted() {
+  g_started = true;
+  NSArray* waiting = g_waiting_for_start;
+  g_waiting_for_start = nil;
+  // On the next turn, with the main loop running, as AppKit would.
+  dispatch_async(dispatch_get_main_queue(), ^{
+    for (void (^block)(void) in waiting) {
+      block();
+    }
+    if ([g_rise_delegate respondsToSelector:@selector
+                         (applicationDidFinishLaunching:)]) {
+      [g_rise_delegate
+          applicationDidFinishLaunching:
+              [NSNotification
+                  notificationWithName:NSApplicationDidFinishLaunchingNotification
+                                object:NSApp]];
+    }
+  });
+}
