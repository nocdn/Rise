+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/common/rise/rise_frame.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/public/renderer/render_frame_observer_tracker.h"
+#include "mojo/public/cpp/bindings/associated_receiver_set.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "v8/include/v8-forward.h"
+#include "v8/include/v8-persistent-handle.h"
+#include "v8/include/v8-promise.h"
+
+namespace rise {
+
+// Rise's page scripts in one frame: run as each document starts, before the
+// page's own, each given the message handlers it may post to as
+// `riseHandlers`, which nothing else in the page can reach.
+class RiseFrameAgent
+    : public content::RenderFrameObserver,
+      public content::RenderFrameObserverTracker<RiseFrameAgent>,
+      public mojom::RiseFrame {
+ public:
+  explicit RiseFrameAgent(content::RenderFrame* render_frame);
+  RiseFrameAgent(const RiseFrameAgent&) = delete;
+  RiseFrameAgent& operator=(const RiseFrameAgent&) = delete;
+  ~RiseFrameAgent() override;
+
+  // Runs Rise's scripts as a document starts, its element there and before
+  // the page's own scripts; false if they closed the frame.
+  static bool RunScriptsAtDocumentStart(content::RenderFrame* render_frame);
+
+  // A script's riseHandlers.<handler>.postMessage(body); `reply` is set for
+  // handlers that reply.
+  void Post(const std::string& handler,
+            int32_t world_id,
+            base::Value body,
+            v8::Local<v8::Context> context,
+            v8::Local<v8::Promise::Resolver> reply);
+
+ private:
+  // content::RenderFrameObserver:
+  bool OnAssociatedInterfaceRequestForFrame(
+      const std::string& interface_name,
+      mojo::ScopedInterfaceEndpointHandle* handle) override;
+  void DidCreateNewDocument() override;
+  void OnDestruct() override;
+
+  // mojom::RiseFrame:
+  void SetScripts(
+      std::vector<mojom::ScriptPtr> scripts,
+      mojo::PendingAssociatedRemote<mojom::RiseFrameHost> host) override;
+  void AddScript(mojom::ScriptPtr script) override;
+
+  void DocumentStarted();
+  void Run(const mojom::Script& script);
+  void RunInPage(const mojom::Script& script);
+  void Replied(int id, base::Value reply, const std::optional<std::string>& error);
+
+  // Where a script in the page's own world finds its handlers, briefly.
+  const std::string handlers_key_;
+  // Rise's scripts for the frame's documents.
+  std::vector<mojom::ScriptPtr> scripts_;
+  // Whether the current document has started, running them.
+  bool started_ = false;
+  mojo::AssociatedRemote<mojom::RiseFrameHost> host_;
+  // What scripts post before the browser has said where to.
+  std::vector<base::OnceClosure> waiting_;
+  // Promises of replies, by the number their message went with.
+  struct Reply {
+    Reply();
+    Reply(Reply&&);
+    ~Reply();
+    v8::Global<v8::Context> context;
+    v8::Global<v8::Promise::Resolver> resolver;
+  };
+  std::map<int, Reply> replies_;
+  int next_reply_ = 0;
+  mojo::AssociatedReceiverSet<mojom::RiseFrame> receivers_;
+  base::WeakPtrFactory<RiseFrameAgent> weak_factory_{this};
+};
+
+}  // namespace rise
+
+#endif  // CHROME_RENDERER_RISE_RISE_FRAME_AGENT_H_
