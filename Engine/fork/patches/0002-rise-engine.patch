+- (void)parkTrackingAreasIn:(NSView*)view {
+  for (NSView* child in view.subviews) {
+    NSArray<NSTrackingArea*>* areas = child.trackingAreas;
+    if (areas.count) {
+      [_parkedAreas setObject:areas forKey:child];
+      for (NSTrackingArea* area in areas) {
+        [child removeTrackingArea:area];
+      }
+    }
+    [self parkTrackingAreasIn:child];
+  }
