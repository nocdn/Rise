+// What a tab does, told to its Rise view.
+class TabObserver : public content::WebContentsObserver {
+ public:
+  TabObserver(RCBrowserView* view, content::WebContents* contents)
+      : WebContentsObserver(contents), view_(view) {}
+
+  // Each frame has Rise's scripts before a document of a navigation in it
+  // starts: sent before the commit, they arrive before it.
+  void ReadyToCommitNavigation(content::NavigationHandle* navigation) override {
+    SendScripts(navigation->GetRenderFrameHost(), /*fresh=*/false);
+  }
+  // A frame made in its page's process, as by a script, or made again after
+  // a crash.
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    SendScripts(frame, /*fresh=*/true);
+  }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    hosts_.erase(frame->GetGlobalId());
+  }
+
+  void TitleWasSet(content::NavigationEntry* entry) override { Changed(); }
+  void DidStartLoading() override { Changed(); }
+  void DidStopLoading() override { Changed(); }
+  void LoadProgressChanged(double progress) override { Changed(); }
+  void NavigationEntryCommitted(
+      const content::LoadCommittedDetails& details) override {
+    Changed();
+  }
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame() ||
+        navigation->IsSameDocument()) {
+      return;
+    }
+    RCNavigationKind kind = RCNavigationKindNewPage;
+    if (navigation->GetReloadType() != content::ReloadType::NONE) {
+      kind = RCNavigationKindReload;
+    } else if (navigation->GetPageTransition() &
+               ui::PAGE_TRANSITION_FORWARD_BACK) {
+      kind = RCNavigationKindHistory;
+    }
+    [view_ willNavigate:kind];
+  }
+  void DidFinishLoad(content::RenderFrameHost* frame,
+                     const GURL& validated_url) override {
+    if (frame->IsInPrimaryMainFrame()) {
+      [view_ finishedLoad];
+    }
+  }
+  void OnAudioStateChanged(bool audible) override { Changed(); }
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame() || navigation->IsSameDocument()) {
+      return;
+    }
+    net::Error error = navigation->GetNetErrorCode();
+    if (error == net::OK || error == net::ERR_ABORTED) {
+      return;
+    }
+    [view_ loadFailed:error
+                 text:base::SysUTF8ToNSString(net::ErrorToString(error))
+                  url:ToNSURL(navigation->GetURL())];
+  }
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    // On the next turn: Rise loads the page again, starting a new process,
+    // which must wait until Chrome has done with the old one.
+    __weak RCBrowserView* view = view_;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [view crashed];
+    });
+  }
+  // Chrome closed the tab itself, as for an extension's tabs.remove.
+  void WebContentsDestroyed() override { [view_ contentsGone]; }
+
+ private:
+  void Changed() { [view_ contentsChanged]; }
+
+  void SendScripts(content::RenderFrameHost* frame, bool fresh) {
+    RCBrowserView* view = view_;
+    if (!view || !frame || !frame->IsRenderFrameLive()) {
+      return;
+    }
+    // Where its scripts post, once a frame (again for a frame made anew).
+    mojo::PendingAssociatedRemote<rise::mojom::RiseFrameHost> remote;
+    std::unique_ptr<FrameHost>& host = hosts_[frame->GetGlobalId()];
+    if (fresh || !host || !host->is_bound()) {
+      host = std::make_unique<FrameHost>(view, frame->GetGlobalId());
+      remote = host->Bind();
+    }
+    AgentOf(frame)->SetScripts([view frameScripts], std::move(remote));
+  }
+
+  __weak RCBrowserView* view_;
+  std::map<content::GlobalRenderFrameHostId, std::unique_ptr<FrameHost>>
+      hosts_;
+};
