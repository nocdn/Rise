+// What Rise's scripts in one frame post, for its Rise view.
+class FrameHost : public rise::mojom::RiseFrameHost {
+ public:
+  FrameHost(RCBrowserView* view, content::GlobalRenderFrameHostId frame)
+      : view_(view), frame_(frame) {}
+
+  mojo::PendingAssociatedRemote<rise::mojom::RiseFrameHost> Bind() {
+    return receiver_.BindNewEndpointAndPassRemote();
+  }
+  bool is_bound() const { return receiver_.is_bound(); }
+
+  void PostMessage(const std::string& handler,
+                   int32_t world_id,
+                   base::Value body) override {
+    [view_ receivedMessage:std::move(body)
+                   handler:handler
+                     world:world_id
+                     frame:frame_
+                     reply:nil];
+  }
+  void PostMessageWithReply(const std::string& handler,
+                            int32_t world_id,
+                            base::Value body,
+                            PostMessageWithReplyCallback callback) override {
+    auto waiting =
+        std::make_shared<PostMessageWithReplyCallback>(std::move(callback));
+    void (^reply)(id, NSString*) = ^(id value, NSString* error) {
+      if (!*waiting) {
+        return;
+      }
+      std::move(*waiting).Run(
+          error ? base::Value() : ToValue(value),
+          error ? std::optional<std::string>(base::SysNSStringToUTF8(error))
+                : std::nullopt);
+    };
+    RCBrowserView* view = view_;
+    if (!view) {
+      reply(nil, @"The page went away");
+      return;
+    }
+    [view receivedMessage:std::move(body)
+                  handler:handler
+                    world:world_id
+                    frame:frame_
+                    reply:reply];
+  }
+
+ private:
+  __weak RCBrowserView* view_;
+  content::GlobalRenderFrameHostId frame_;
+  mojo::AssociatedReceiver<rise::mojom::RiseFrameHost> receiver_{this};
+};
+
+// Rise's agent in a frame, in the page's process.
+mojo::AssociatedRemote<rise::mojom::RiseFrame> AgentOf(
+    content::RenderFrameHost* frame) {
+  mojo::AssociatedRemote<rise::mojom::RiseFrame> agent;
+  frame->GetRemoteAssociatedInterfaces()->GetInterface(&agent);
+  return agent;
+}
