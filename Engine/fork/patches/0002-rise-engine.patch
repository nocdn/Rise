+@interface RCTabStrip ()
+@property(nonatomic, weak, readonly) id<RCTabStripDelegate> delegate;
+- (BOOL)isApplying;
+- (NSWindow*)nativeWindow;
+@end
+
+namespace {
+
+// Rise's window, as its Browser asks about it.
+class StripWindow : public RiseBrowserWindow::Delegate {
+ public:
+  explicit StripWindow(RCTabStrip* strip) : strip_(strip) {}
+  bool IsActive() const override { return strip_.active; }
+  gfx::Rect GetBounds() const override {
+    // Chromium measures screens from the top left of the main one.
+    NSRect frame = strip_.frame;
+    CGFloat top = NSMaxY(NSScreen.screens.firstObject.frame);
+    return gfx::Rect(frame.origin.x, top - NSMaxY(frame), frame.size.width,
+                     frame.size.height);
+  }
+  gfx::NativeWindow GetNativeWindow() const override {
+    return gfx::NativeWindow([strip_ nativeWindow]);
+  }
+  void Activate() override { [strip_.delegate tabStripActivateWindow]; }
+
+ private:
+  __weak RCTabStrip* strip_;
+};
+
+// What Chrome does to the window's tabs itself (an extension switching,
+// moving, pinning or closing them), asked of Rise, which keeps the order.
+class StripObserver : public TabStripModelObserver {
+ public:
+  explicit StripObserver(RCTabStrip* strip) : strip_(strip) {}
+  void OnTabStripModelChanged(TabStripModel* model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override {
+    RCTabStrip* strip = strip_;
+    if (!strip || [strip isApplying]) {
+      return;
+    }
+    if (change.type() == TabStripModelChange::kMoved) {
+      const TabStripModelChange::Move* move = change.GetMove();
+      if (RCBrowserView* view = ViewOf(move->tab->GetContents())) {
+        [strip.delegate tabStripMoveTab:view toIndex:move->to_index];
+      }
+    }
+    if (selection.active_tab_changed() && selection.new_contents) {
+      if (RCBrowserView* view = ViewOf(selection.new_contents)) {
+        [strip.delegate tabStripActivateTab:view];
+      }
+    }
+  }
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override {
+    RCTabStrip* strip = strip_;
+    RCBrowserView* view = ViewOf(tab->GetContents());
+    if (strip && view && ![strip isApplying]) {
+      [strip.delegate tabStripSetTab:view pinned:tab->IsPinned()];
+    }
+  }
+
+ private:
+  __weak RCTabStrip* strip_;
+};
+
+}  // namespace
+
+@implementation RCTabStrip {
+  // Deleted when the window closes.
+  raw_ptr<BrowserWindowInterface> _browser;
+  std::unique_ptr<StripWindow> _window;
+  std::unique_ptr<StripObserver> _observer;
+  NSArray<RCBrowserView*>* _tabs;
+  NSInteger _pinnedCount;
+  NSInteger _activeIndex;
+  BOOL _applying;
+}
+
+@synthesize active = _active;
+@synthesize frame = _frame;
+@synthesize delegate = _delegate;
+
+- (instancetype)initWithDelegate:(id<RCTabStripDelegate>)delegate {
+  if (!(self = [super init])) {
+    return nil;
+  }
+  _delegate = delegate;
+  _tabs = @[];
+  _activeIndex = -1;
+  _window = std::make_unique<StripWindow>(self);
+  _observer = std::make_unique<StripObserver>(self);
+  [Strips() addObject:self];
+  [NSNotificationCenter.defaultCenter addObserver:self
+                                         selector:@selector(pageMade:)
+                                             name:kPageMadeNotification
+                                           object:nil];
+  return self;
+}
+
+- (void)dealloc {
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+  [self close];
+}
+
+- (void)pageMade:(NSNotification*)notification {
+  if ([_tabs containsObject:notification.object]) {
+    [self apply];
+  }
+}
+
+- (BOOL)isApplying {
+  return _applying;
+}
+
+- (NSWindow*)nativeWindow {
+  for (RCBrowserView* view in _tabs) {
+    if (view.window) {
+      return view.window;
+    }
+  }
+  return nil;
+}
+
+// The window's Browser, made once Chrome has started.
+- (BrowserWindowInterface*)browser {
+  if (!_browser && g_started) {
+    _browser = MakeBrowser(_window.get());
+    if (_browser) {
+      _browser->GetTabStripModel()->AddObserver(_observer.get());
+    }
+  }
+  return _browser;
+}
+
+- (NSInteger)windowID {
+  BrowserWindowInterface* browser = [self browser];
+  return browser ? browser->GetSessionID().id() : -1;
+}
+
+- (void)setTabs:(NSArray<RCBrowserView*>*)tabs
+    pinnedCount:(NSInteger)pinnedCount
+    activeIndex:(NSInteger)activeIndex {
+  _tabs = tabs.copy;
+  _pinnedCount = pinnedCount;
+  _activeIndex = activeIndex;
+  [self apply];
+}
+
+// Makes the Browser's tabs Rise's: the same pages in the same order, the
+// pinned ones first, the selected one active. Pages still being made join
+// once they are (RCBrowserView's browserStarted). Pages that leave go back to
+// the waiting Browser, unless they've closed.
+- (void)apply {
+  BrowserWindowInterface* browser = [self browser];
+  if (!browser) {
+    return;
+  }
+  _applying = YES;
+  TabStripModel* model = browser->GetTabStripModel();
+  int index = 0, active = TabStripModel::kNoTab;
+  for (NSUInteger i = 0; i < _tabs.count; i++) {
+    content::WebContents* contents = [_tabs[i] contents];
+    if (!contents) {
+      continue;
+    }
+    bool pinned = static_cast<NSInteger>(i) < _pinnedCount;
+    int at = MoveTab(contents, browser, index, pinned);
+    if (at == TabStripModel::kNoTab) {
+      continue;
+    }
+    if (model->IsTabPinned(at) != pinned) {
+      at = model->SetTabPinned(at, pinned);
+    }
+    if (at != index) {
+      at = model->MoveWebContentsAt(at, index, /*select_after_move=*/false);
+    }
+    if (static_cast<NSInteger>(i) == _activeIndex) {
+      active = at;
+    }
+    index++;
+  }
+  while (model->count() > index) {
+    content::WebContents* contents = model->GetWebContentsAt(model->count() - 1);
+    BrowserWindowInterface* waiting = WaitingBrowser();
+    if (!waiting || MoveTab(contents, waiting, -1, /*pinned=*/false) ==
+                        TabStripModel::kNoTab) {
+      break;
+    }
+  }
+  if (active != TabStripModel::kNoTab && model->active_index() != active) {
+    model->ActivateTabAt(active);
+  }
+  _applying = NO;
+}
+
+- (void)setActive:(BOOL)active {
+  if (active == _active) {
+    return;
+  }
+  _active = active;
+  BrowserWindowInterface* browser = [self browser];
+  BrowserActiveStateManager* state =
+      browser ? BrowserActiveStateManager::From(browser) : nullptr;
+  if (!state) {
+    return;
+  }
+  // Chrome's last active window is the one its extensions and the rest take
+  // as current, as when one of its own windows is brought forward.
+  if (active) {
+    state->DidBecomeActive();
+  } else {
+    state->DidBecomeInactive();
+  }
+}
+
+- (void)browserClosing:(BrowserWindowInterface*)browser {
+  if (_browser.get() != browser) {
+    return;
+  }
+  browser->GetTabStripModel()->RemoveObserver(_observer.get());
+  _browser = nullptr;
+}
+
+- (void)close {
+  BrowserWindowInterface* browser = _browser;
+  _browser = nullptr;
+  if (!browser) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  model->RemoveObserver(_observer.get());
+  // Pages still open go back to waiting; Rise closes them.
+  while (!model->empty()) {
+    if (!WaitingBrowser() ||
+        MoveTab(model->GetWebContentsAt(0), WaitingBrowser(), -1, false) ==
+            TabStripModel::kNoTab) {
+      break;
+    }
+  }
+  // Closed as Chrome's windows are: with no tabs, Chrome then deletes it.
+  UnloadController::From(browser)->OnWindowClosing();
+}
+
+@end
