+// MARK: The app
+
+// Chrome's application class (see RC_APPLICATION_SUPERCLASS), so Chrome takes it
+// as its own, run by Chrome's main from Rise's.
+@implementation RCApplication {
+  BOOL _running;
+}
+
+- (void)setDelegate:(id<NSApplicationDelegate>)delegate {
+  // Chrome's AppController is the app's delegate, as Chrome needs; it asks
+  // Rise's about Rise's windows, menus, Dock and links from other apps, and
+  // Rise's hears the rest it needs from the bridge.
+  if (delegate && ![(id)delegate isKindOfClass:[AppController class]]) {
+    g_rise_delegate = delegate;
+    return;
+  }
+  ((AppController*)delegate).embedderDelegate = g_rise_delegate;
+  [super setDelegate:delegate];
+}
+
+- (void)run {
+  if (_running) {
+    // Chrome's main loop, now that Chrome has read its command line: what the
+    // app class does first, when Chrome makes the app itself.
+    cocoa_l10n_util::ApplyForcedRTL();
+    [super run];
+    return;
+  }
+  if (!g_start_requested) {
+    [super run];
+    return;
+  }
+  _running = YES;
+  // Rise's windows aren't Chrome's, as tests' windows aren't; Chrome's code
+  // takes the same paths for them.
+  base::SetEmbedderTakesTestPaths();
+  // Rise swipes through history itself, with its own arrow.
+  [ChromeRenderWidgetHostViewMacDelegate setHistorySwipesDisabled:YES];
+  // Chrome closes its windows to quit: Rise saves first, keeping its pages
+  // as they are, then each closes as Chrome's do. (Closed otherwise, as by an
+  // extension, Rise's windows stay for now.)
+  RiseBrowserWindow::SetCloseHandler(
+      base::BindRepeating([](BrowserWindowInterface* browser) {
+        if (!browser_shutdown::IsTryingToQuit()) {
+          return;
+        }
+        RiseWillTerminate();
+        for (RCTabStrip* strip in Strips()) {
+          [strip browserClosing:browser];
+        }
+        if (browser == g_waiting_browser) {
+          g_waiting_browser = nullptr;
+        }
+        UnloadController::From(browser)->OnWindowClosing();
+      }));
+  // As AppKit tells an app's delegate; Chrome posts it as it quits.
+  [NSNotificationCenter.defaultCenter
+      addObserverForName:NSApplicationWillTerminateNotification
+                  object:nil
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                RiseWillTerminate();
+              }];
+  NSArray<NSString*>* processArguments = NSProcessInfo.processInfo.arguments;
+  std::vector<std::string>& arguments = Arguments();
+  arguments.insert(arguments.begin(), processArguments.firstObject.UTF8String);
+  for (NSUInteger i = 1; i < processArguments.count; i++) {
+    arguments.push_back(processArguments[i].UTF8String);
+  }
+  std::vector<const char*> argv;
+  for (const std::string& argument : arguments) {
+    argv.push_back(argument.c_str());
+  }
+  exit(ChromeMain(static_cast<int>(argv.size()), argv.data()));
+}
+
+@end
