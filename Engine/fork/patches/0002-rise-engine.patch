+// The window the person used last, of those Rise shows.
+BrowserWindowInterface* LastActiveShownBrowser() {
+  BrowserWindowInterface* last = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        const BrowserWindow* window =
+            BrowserWindow::FromBrowser(browser);
+        if (window && window->StaysOpenWhenEmpty() && !window->IsVisible()) {
+          return true;
+        }
+        last = browser;
+        return false;
+      });
+  return last;
+}
