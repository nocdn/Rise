+  return *arguments;
+}
+// Rise's app delegate, until Chrome's AppController is in place and the
+// browser has started; then it hears that the app finished launching.
+id<NSApplicationDelegate> g_rise_delegate = nil;
+NSMutableArray<void (^)(void)>* g_waiting_for_start = nil;
+
+Profile* RiseProfile() {
+  return g_started ? ProfileManager::GetLastUsedProfile() : nullptr;
+}
+
+// A Browser whose window is Rise's: Chrome makes the Browser, and no window of
+// its own. `delegate` answers for the Rise window; null for the one holding
+// pages that aren't tabs.
+BrowserWindowInterface* MakeBrowser(RiseBrowserWindow::Delegate* delegate) {
+  if (!RiseProfile()) {
+    return nullptr;
+  }
+  BrowserWindowCreateParams params(RiseProfile(), /*from_user_gesture=*/false);
+  auto* window = new RiseBrowserWindow();
+  window->set_delegate(delegate);
+  params.window = window;
+  params.embedder_window = true;
+  // Rise restores its own windows.
+  params.omit_from_session_restore = true;
+  return CreateBrowserWindow(std::move(params));
+}
+
+// Where Rise's pages wait while they aren't any window's tabs: new pages until
+// their window takes them, and a Peek, its standby page, DevTools and the like.
+BrowserWindowInterface* WaitingBrowser() {
+  static BrowserWindowInterface* browser = nullptr;
+  if (!browser) {
+    browser = MakeBrowser(nullptr);
+  }
+  return browser;
+}
+
+// The Browser a page is a tab of.
+BrowserWindowInterface* BrowserOf(content::WebContents* contents) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+// Moves `contents` into `to`'s tab strip at `index` (-1: the end), keeping its
+// page, as dragging a tab between Chrome's windows does. Returns where it went.
+int MoveTab(content::WebContents* contents,
+            BrowserWindowInterface* to,
+            int index,
+            bool pinned) {
+  TabStripModel* destination = to->GetTabStripModel();
+  int at = destination->GetIndexOfWebContents(contents);
+  if (at != TabStripModel::kNoTab) {
+    return at;
+  }
+  BrowserWindowInterface* from = BrowserOf(contents);
+  if (!from) {
+    return TabStripModel::kNoTab;
+  }
+  TabStripModel* source = from->GetTabStripModel();
+  std::unique_ptr<tabs::TabModel> tab =
+      source->DetachTabAtForInsertion(source->GetIndexOfWebContents(contents));
+  if (index < 0 || index > destination->count()) {
+    index = destination->count();
+  }
+  return destination->InsertDetachedTabAt(
+      index, std::move(tab),
+      pinned ? AddTabTypes::ADD_PINNED : AddTabTypes::ADD_NONE);
+}
+
+// Every page's Rise view, for what Chrome does to its tabs.
+NSMapTable<NSValue*, RCBrowserView*>* Views() {
+  static NSMapTable* views = [NSMapTable strongToWeakObjectsMapTable];
+  return views;
+}
+// A page's view has its page now, so its window can take it as a tab.
+NSString* const kPageMadeNotification = @"RisePageMade";
+
+RCBrowserView* ViewOf(content::WebContents* contents) {
+  return contents ? [Views() objectForKey:[NSValue valueWithPointer:contents]]
+                  : nil;
+}
+
+NSURL* ToNSURL(const GURL& url) {
+  return url.is_valid() ? [NSURL URLWithString:base::SysUTF8ToNSString(url.spec())]
+                        : nil;
+}
+
+// Chromium's values, as Foundation's, through JSON.
+id ToObject(const base::Value& value) {
+  std::optional<std::string> json = base::WriteJson(value);
+  if (!json) {
+    return nil;
+  }
+  NSData* data = [base::SysUTF8ToNSString(*json) dataUsingEncoding:NSUTF8StringEncoding];
+  return [NSJSONSerialization JSONObjectWithData:data
+                                         options:NSJSONReadingFragmentsAllowed
+                                           error:nil];
+}
+
+NSString* ToJSON(id object) {
+  if (!object) {
+    return @"null";
+  }
+  NSData* data = [NSJSONSerialization dataWithJSONObject:object
+                                                 options:NSJSONWritingFragmentsAllowed
+                                                   error:nil];
+  return data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding]
+              : @"null";
+}
+
+base::Value ToValue(id object) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(base::SysNSStringToUTF8(ToJSON(object)),
+                             base::JSON_PARSE_RFC);
+  return value ? std::move(*value) : base::Value();
+}
+
+// A world of Rise's own for each name: the page's scripts can't see it.
+int32_t WorldID(NSString* world) {
+  static NSMutableDictionary<NSString*, NSNumber*>* ids =
+      [NSMutableDictionary dictionary];
+  if (!world.length) {
+    return content::ISOLATED_WORLD_ID_GLOBAL;
+  }
+  NSNumber* known = ids[world];
+  if (!known) {
+    // Above the worlds Chrome numbers for itself and extensions.
+    known = @((1 << 28) + (int)ids.count);
+    ids[world] = known;
+  }
+  return known.intValue;
+}
+
+// The layer Chromium shows its GPU process's frames through, in the page's
+// layers.
+CALayer* ContentHost(CALayer* layer) {
+  if ([NSStringFromClass(layer.class) isEqualToString:@"CALayerHost"]) {
+    return layer;
+  }
+  for (CALayer* sublayer in layer.sublayers) {
+    if (CALayer* host = ContentHost(sublayer)) {
+      return host;
+    }
+  }
+  return nil;
+}
