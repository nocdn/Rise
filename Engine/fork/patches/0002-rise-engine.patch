+// Chrome's DevTools protocol for a page, in process: for what only DevTools
+// does, such as a console's evaluation. Attached when first used.
+class DevToolsSession : public content::DevToolsAgentHostClient {
+ public:
+  using Reply = void (^)(NSDictionary* result, NSDictionary* error);
+
+  explicit DevToolsSession(content::WebContents* contents)
+      : host_(content::DevToolsAgentHost::GetOrCreateFor(contents)) {
+    host_->AttachClient(this);
+  }
+  ~DevToolsSession() override {
+    if (host_) {
+      host_->DetachClient(this);
+    }
+  }
+
+  void Send(NSString* method, NSDictionary* params, Reply reply) {
+    if (!host_) {
+      reply(nil, @{@"message" : @"The page went away"});
+      return;
+    }
+    NSNumber* sent = @(++next_);
+    replies_[sent] = reply;
+    NSData* json = [NSJSONSerialization
+        dataWithJSONObject:@{@"id" : sent, @"method" : method, @"params" : params ?: @{}}
+                   options:0
+                     error:nil];
+    std::string text(static_cast<const char*>(json.bytes), json.length);
+    host_->DispatchProtocolMessage(this, base::as_byte_span(text));
+  }
+
+  void DispatchProtocolMessage(content::DevToolsAgentHost* host,
+                               base::span<const uint8_t> message) override {
+    NSDictionary* parsed = [NSJSONSerialization
+        JSONObjectWithData:[NSData dataWithBytes:message.data() length:message.size()]
+                   options:0
+                     error:nil];
+    NSNumber* answered =
+        [parsed isKindOfClass:NSDictionary.class] ? parsed[@"id"] : nil;
+    Reply reply = nil;
+    if (answered) {
+      reply = replies_[answered];
+    }
+    if (reply) {
+      [replies_ removeObjectForKey:answered];
+      reply(parsed[@"result"], parsed[@"error"]);
+    }
+  }
+  void AgentHostClosed(content::DevToolsAgentHost* host) override {
+    host_ = nullptr;
+    NSDictionary* waiting = replies_;
+    replies_ = [NSMutableDictionary dictionary];
+    for (NSNumber* sent in waiting) {
+      ((Reply)waiting[sent])(nil, @{@"message" : @"The page went away"});
+    }
+  }
+
+ private:
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  NSMutableDictionary<NSNumber*, Reply>* replies_ = [NSMutableDictionary dictionary];
+  int next_ = 0;
+};
