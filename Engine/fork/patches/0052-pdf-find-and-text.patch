+}
+- (void)findText:(NSString*)text
+         forward:(BOOL)forward
+      completion:(void (^)(NSInteger, NSInteger, BOOL))completion {
+  find_in_page::FindTabHelper* helper = [self findHelper];
+  if (!helper) {
+    completion(0, 0, YES);
+    return;
+  }
+  if (!_findRelay || _findRelay->helper() != helper) {
+    _findRelay = std::make_unique<FindResultRelay>(helper);
+  }
+  if (text.length == 0) {
+    _findRelay->SetHandler(nil);
+    helper->StopFinding(find_in_page::SelectionAction::kClear);
+    completion(0, 0, YES);
+    return;
+  }
+  _findRelay->SetHandler(completion);
+  helper->StartFinding(base::SysNSStringToUTF16(text), forward,
+                       /*case_sensitive=*/false, /*find_match=*/true);
+}
+- (void)stopFindingSelectingMatch:(BOOL)select {
+  if (_findRelay) {
+    _findRelay->SetHandler(nil);
+  }
+  if (find_in_page::FindTabHelper* helper =
+          _contents ? find_in_page::FindTabHelper::FromWebContents(_contents)
+                    : nullptr) {
+    helper->StopFinding(select ? find_in_page::SelectionAction::kKeep
+                               : find_in_page::SelectionAction::kClear);
+  }
+}
