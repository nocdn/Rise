 // What a tab does, told to its Rise view.
+// Chrome's find results for a page, passed to the handler of Rise's latest find there.
+class FindResultRelay : public find_in_page::FindResultObserver {
+ public:
+  explicit FindResultRelay(find_in_page::FindTabHelper* helper) : helper_(helper) {
+    observation_.Observe(helper);
+  }
+  find_in_page::FindTabHelper* helper() const { return helper_; }
+  void SetHandler(void (^handler)(NSInteger, NSInteger, BOOL)) { handler_ = handler; }
+  void OnFindResultAvailable(content::WebContents* contents) override {
+    if (!handler_ || !helper_) {
+      return;
+    }
+    const find_in_page::FindNotificationDetails& result = helper_->find_result();
+    handler_(result.number_of_matches(), result.active_match_ordinal(),
+             result.final_update());
+  }
+  void OnFindTabHelperDestroyed(find_in_page::FindTabHelper* helper) override {
+    observation_.Reset();
+    helper_ = nullptr;
+  }
+
+ private:
+  raw_ptr<find_in_page::FindTabHelper> helper_;
+  void (^handler_)(NSInteger, NSInteger, BOOL) = nil;
+  base::ScopedObservation<find_in_page::FindTabHelper,
+                          find_in_page::FindResultObserver>
+      observation_{this};
+};
