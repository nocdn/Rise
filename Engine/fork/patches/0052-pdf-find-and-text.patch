+- (BOOL)showsPDF {
+  return _contents && _contents->GetContentsMimeType() == pdf::kPDFMimeType;
+}
+// Its pages' text, as Chrome's own features read a PDF: the page count first, then each page.
+- (void)PDFPageTextsWithCompletion:(void (^)(NSArray<NSString*>*))completion {
+  pdf::PDFDocumentHelper* helper =
+      _contents ? pdf::PDFDocumentHelper::MaybeGetForFullPagePdf(*_contents)
+                : nullptr;
+  if (!helper) {
+    completion(nil);
+    return;
+  }
+  __weak RCBrowserView* weak_view = self;
+  helper->RegisterForDocumentLoadComplete(base::BindOnce(
+      [](__weak RCBrowserView* view, void (^completion)(NSArray<NSString*>*)) {
+        RCBrowserView* shown = view;
+        if (!shown) {
+          completion(nil);
+          return;
+        }
+        [shown readPDFPagesWithCompletion:completion];
+      },
+      weak_view, completion));
+}
+- (void)whenPDFLoaded:(void (^)(BOOL))completion {
+  pdf::PDFDocumentHelper* helper = [self fullPagePDFHelper];
+  if (!helper) {
+    completion(NO);
+    return;
+  }
+  helper->RegisterForDocumentLoadComplete(base::BindOnce(
+      [](void (^completion)(BOOL)) { completion(YES); }, completion));
+}
+// The PDF's own frame holds its selection: the page's is the viewer's, around it.
+- (NSString*)PDFSelectedText {
+  if (![self showsPDF]) {
+    return @"";
+  }
+  content::RenderFrameHost* viewer =
+      pdf_frame_util::FindFullPagePdfExtensionHost(_contents);
+  content::RenderFrameHost* content =
+      viewer ? pdf_frame_util::FindPdfChildFrame(viewer) : nullptr;
+  content::RenderWidgetHostView* view = content ? content->GetView() : nullptr;
+  return view ? base::SysUTF16ToNSString(view->GetSelectedText()) : @"";
+}
+- (pdf::PDFDocumentHelper*)fullPagePDFHelper {
+  return _contents ? pdf::PDFDocumentHelper::MaybeGetForFullPagePdf(*_contents)
+                   : nullptr;
+}
+- (void)readPDFPagesWithCompletion:(void (^)(NSArray<NSString*>*))completion {
+  pdf::PDFDocumentHelper* helper = [self fullPagePDFHelper];
+  if (!helper) {
+    completion(nil);
+    return;
+  }
+  // A limit of nothing sends no bytes, only the page count.
+  __weak RCBrowserView* weak_view = self;
+  helper->GetPdfBytes(
+      0, base::BindOnce(
+             [](__weak RCBrowserView* view,
+                void (^completion)(NSArray<NSString*>*),
+                pdf::mojom::PdfListener::GetPdfBytesStatus status,
+                const std::vector<uint8_t>& bytes, uint32_t page_count) {
+               RCBrowserView* shown = view;
+               if (!shown) {
+                 completion(nil);
+                 return;
+               }
+               [shown readPDFPage:0
+                           count:std::min<uint32_t>(page_count, 5000)
+                            into:[NSMutableArray array]
+                      completion:completion];
+             },
+             weak_view, completion));
+}
+- (void)readPDFPage:(uint32_t)index
+              count:(uint32_t)count
+               into:(NSMutableArray<NSString*>*)pages
+         completion:(void (^)(NSArray<NSString*>*))completion {
+  pdf::PDFDocumentHelper* helper = [self fullPagePDFHelper];
+  if (index >= count || !helper) {
+    completion(helper ? pages : nil);
+    return;
+  }
+  __weak RCBrowserView* weak_view = self;
+  helper->GetPageText(
+      index, base::BindOnce(
+                 [](__weak RCBrowserView* view, uint32_t index, uint32_t count,
+                    NSMutableArray<NSString*>* pages,
+                    void (^completion)(NSArray<NSString*>*),
+                    const std::u16string& text) {
+                   [pages addObject:base::SysUTF16ToNSString(text)];
+                   RCBrowserView* shown = view;
+                   if (!shown) {
+                     completion(nil);
+                     return;
+                   }
+                   [shown readPDFPage:index + 1
+                                count:count
+                                 into:pages
+                           completion:completion];
+                 },
+                 weak_view, index, count, pages, completion));
+}
+- (find_in_page::FindTabHelper*)findHelper {
+  if (!_contents) {
+    return nullptr;
+  }
+  find_in_page::FindTabHelper::CreateForWebContents(_contents);
