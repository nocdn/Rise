+        <cr-dialog id="resetDialog" show-on-attach @close="${this.onDialogClose_}" @cancel="${this.onDialogCancel_}">
+          <div slot="title">Reset all to defaults</div>
+          <div slot="body">All keyboard shortcuts will be reset to their default values. Any custom shortcuts you've set will be lost.</div>
+          <div slot="button-container">
+            <cr-button class="cancel-button" @click="${this.onCancelDialogClick_}">Cancel</cr-button>
+            <cr-button id="confirmReset" class="action-button" @click="${this.onResetDialogConfirmClick_}">Reset</cr-button>
+          </div>
+        </cr-dialog>` : ''}
+    </settings-subpage>`;
 }
