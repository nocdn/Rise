+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview A section of Rise's own settings, such as Tabs, whose rows all
+ * come from Rise.
+ */
+import '../settings_page/settings_section.js';
+import './rise_settings_rows.js';
+
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getSearchManager} from '../search_settings.js';
+import {getCss as getSettingsSharedStyle} from '../settings_shared_lit.css.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getHtml} from './rise_page.html.js';
+
+export class SettingsRisePageElement extends CrLitElement implements
+    SettingsPlugin {
+  static get is() {
+    return 'settings-rise-page';
+  }
+
+  static override get styles() {
+    return [getCrSharedStyle(), getSettingsSharedStyle()];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      section: {type: String},
+      pageTitle: {type: String},
+    };
+  }
+
+  accessor section: string = '';
+  accessor pageTitle: string = '';
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-rise-page': SettingsRisePageElement;
+  }
+}
+
+customElements.define(SettingsRisePageElement.is, SettingsRisePageElement);
diff --git a/chrome/browser/resources/settings/rise_page/rise_settings_rows.html.ts b/chrome/browser/resources/settings/rise_page/rise_settings_rows.html.ts
new file mode 100644
index 0000000000..ba1bcb5e2b
--- /dev/null
+++ b/chrome/browser/resources/settings/rise_page/rise_settings_rows.html.ts
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {RiseSettingsRowsElement} from './rise_settings_rows.js';
+
+export function getHtml(this: RiseSettingsRowsElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+${this.rows_.map((row, index) => html`
+  <div class="cr-row ${index === 0 && !this.separated ? 'first' : ''}">
+    <div class="label cr-padded-text">
+      <div>${row.label}</div>
+      ${row.sublabel ? html`
+        <div class="cr-secondary-text">${row.sublabel}</div>
+      ` : ''}
+    </div>
+    ${row.type === 'toggle' ? html`
+      <cr-toggle ?checked="${row.value === true}" aria-label="${row.label}"
+          data-key="${row.key}" @change="${this.onToggleChange_}">
+      </cr-toggle>
+    ` : ''}
+    ${row.type === 'select' ? html`
+      <select class="md-select" aria-label="${row.label}"
+          data-key="${row.key}" @change="${this.onSelectChange_}">
+        ${(row.options || []).map(option => html`
+          <option value="${option.value}"
+              ?selected="${option.value === row.value}">
+            ${option.label}
+          </option>
+        `)}
+      </select>
+    ` : ''}
+    ${row.type === 'text' ? html`
+      <cr-input type="${row.secret ? 'password' : 'text'}" .value="${String(row.value ?? '')}"
+          placeholder="${row.placeholder || ''}" aria-label="${row.label}"
+          spellcheck="false" data-key="${row.key}"
+          @change="${this.onInputChange_}">
+      </cr-input>
+      ${row.button ? html`
+        <cr-button data-key="${row.buttonKey}" @click="${this.onButtonClick_}">
+          ${row.button}
+        </cr-button>
+      ` : ''}
+    ` : ''}
+    ${row.type === 'button' ? html`
+      <cr-button data-key="${row.key}" @click="${this.onButtonClick_}">
+        ${row.button}
+      </cr-button>
+    ` : ''}
+  </div>
+`)}
+<!--_html_template_end_-->`;
+  // clang-format on
+}
diff --git a/chrome/browser/resources/settings/rise_page/rise_settings_rows.ts b/chrome/browser/resources/settings/rise_page/rise_settings_rows.ts
new file mode 100644
index 0000000000..eb78412338
--- /dev/null
+++ b/chrome/browser/resources/settings/rise_page/rise_settings_rows.ts
@@ -0,0 +1,171 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview Rise's own settings, among Chrome's: the rows a section shows,
+ * described by Rise and changed through the `riseSettings` object Rise's script
+ * gives this page. Rows come from Rise, so a new Rise setting needs no change
+ * here.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {getCss as getMdSelectStyle} from 'chrome://resources/cr_elements/md_select_lit.css.js';
+import {CrLitElement, css} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getHtml} from './rise_settings_rows.html.js';
+
+interface RiseOption {
+  value: string;
+  label: string;
+}
+
+export interface RiseRow {
+  key: string;
+  type: 'toggle'|'select'|'button'|'text';
+  label: string;
+  sublabel: string;
+  value?: boolean|string;
+  options?: RiseOption[];
+  button?: string;
+  // For text: a button beside the field runs this instead of the row's key.
+  buttonKey?: string;
+  placeholder?: string;
+  secret?: boolean;
+}
+
+interface RiseSettings {
+  rows(section: string): Promise<RiseRow[]>;
+  set(key: string, value: boolean|string): Promise<unknown>;
+  run(key: string): Promise<unknown>;
+}
+
+declare global {
+  interface Window {
+    riseSettings?: RiseSettings;
+  }
+}
+
+export class RiseSettingsRowsElement extends CrLitElement {
+  static get is() {
+    return 'rise-settings-rows';
+  }
+
+  static override get styles() {
+    return [
+      getCrSharedStyle(),
+      getMdSelectStyle(),
+      css`
+        :host {
+          display: block;
+        }
+        .label {
+          flex: 1;
+        }
+        cr-toggle,
+        select,
+        cr-input,
+        cr-button {
+          margin-inline-start: 16px;
+        }
+        cr-input {
+          width: var(--md-select-width, 200px);
+        }
+      `,
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      section: {type: String},
+      separated: {type: Boolean},
+      rows_: {type: Array},
+    };
+  }
+
+  accessor section: string = '';
+  // Whether the first row is set apart from rows above it in the same card.
+  accessor separated: boolean = true;
+  protected accessor rows_: RiseRow[] = [];
+
+
+  private onRefresh_ = () => {
+    this.refresh_();
+  };
+
+  override connectedCallback() {
+    super.connectedCallback();
+    window.addEventListener('rise-settings-ready', this.onRefresh_);
+    window.addEventListener('focus', this.onRefresh_);
+    document.addEventListener('visibilitychange', this.onRefresh_);
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    window.removeEventListener('rise-settings-ready', this.onRefresh_);
+    window.removeEventListener('focus', this.onRefresh_);
+    document.removeEventListener('visibilitychange', this.onRefresh_);
+  }
+
+  override updated(changedProperties: PropertyValues<this>) {
+    super.updated(changedProperties);
+    if (changedProperties.has('section')) {
+      this.refresh_();
+    }
+  }
+
+  private async refresh_() {
+    if (!window.riseSettings || !this.section) {
+      return;
+    }
+    this.rows_ = await window.riseSettings.rows(this.section);
+  }
+
+  private async change_(key: string|undefined, value: boolean|string) {
+    if (!key) {
+      return;
+    }
+    await window.riseSettings?.set(key, value);
+    await this.refresh_();
+  }
+
+  protected onToggleChange_(e: CustomEvent<boolean>) {
+    this.change_((e.target as HTMLElement).dataset['key'], e.detail);
+  }
+
+  protected onSelectChange_(e: Event) {
+    const select = e.target as HTMLSelectElement;
+    this.change_(select.dataset['key'], select.value);
+  }
+
+  protected onInputChange_(e: Event) {
+    const input = e.target as HTMLElement & {value: string};
+    this.change_(input.dataset['key'], input.value);
+  }
+
+  protected async onButtonClick_(e: Event) {
+    const key = (e.currentTarget as HTMLElement).dataset['key'];
+    if (!key) {
+      return;
+    }
+    await window.riseSettings?.run(key);
+    await this.refresh_();
+  }
+
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'rise-settings-rows': RiseSettingsRowsElement;
+  }
+}
+
+customElements.define(RiseSettingsRowsElement.is, RiseSettingsRowsElement);
