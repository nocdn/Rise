+++ b/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
@@ -836,6 +836,10 @@ void BrowserWebContentsDelegate::ActivateContents(
 
 bool BrowserWebContentsDelegate::IsContentsActive(
     content::WebContents* contents) {
+  if (EmbedderTabHooks* hooks = EmbedderTabHooks::FromWebContents(contents);
+      hooks && hooks->IsContentsActive()) {
+    return true;
+  }
   return browser_->GetTabStripModel()->GetActiveWebContents() == contents;
 }
 
