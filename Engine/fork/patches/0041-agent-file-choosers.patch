diff --git a/chrome/browser/rise/rise_bridge.mm b/chrome/browser/rise/rise_bridge.mm
index a75aff82fe..0ec5b45515 100644
--- a/chrome/browser/rise/rise_bridge.mm
+++ b/chrome/browser/rise/rise_bridge.mm
@@ -932,6 +932,17 @@ explicit RiseTabHooks(RCBrowserView* view)
   // Rise loads a crashed page again itself.
   bool ShowsCrashedPages() override { return true; }
 
+  // In front as Rise has it: shown in a window (either half of a split, say),
+  // or used by Rise's agent, though Chrome's tab strip has another in front.
+  bool IsContentsActive() override {
+    RCBrowserView* view = view_;
+    if (!view) {
+      return false;
+    }
+    return view.keepsVisible ||
+           (view.window.visible && !view.hiddenOrHasHiddenAncestor);
+  }
+
   // The link under the pointer goes to Rise, which shows where it leads.
   bool UpdateTargetURL(const GURL& url) override {
     RCBrowserView* view = view_;
diff --git a/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc b/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
