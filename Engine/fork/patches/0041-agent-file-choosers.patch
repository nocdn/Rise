   // Rise loads a crashed page again itself.
   bool ShowsCrashedPages() override { return true; }
 
+  // In front as Rise has it: shown in a window (either half of a split, say),
+  // or used by Rise's agent, though Chrome's tab strip has another in front.
+  bool IsContentsActive() override {
+    RCBrowserView* view = view_;
+    if (!view) {
+      return false;
+    }
+    return view.keepsVisible ||
+           (view.window.visible && !view.hiddenOrHasHiddenAncestor);
+  }
+
