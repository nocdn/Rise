+void PipTopBarAnimationController::StartCameraSlide(float target) {
+  move_camera_button_to_left_animation_.Stop();
+  move_camera_button_to_right_animation_.Stop();
+  camera_from_ = camera_offset_;
+  camera_to_ = target;
+  if (camera_from_ == camera_to_) {
+    return;
+  }
+  if (!gfx::Animation::ShouldRenderRichAnimation()) {
+    camera_offset_ = camera_to_;
+    AnimationProgressed(&move_camera_button_to_left_animation_);
+    return;
+  }
+  (target > 0 ? move_camera_button_to_right_animation_
+              : move_camera_button_to_left_animation_)
+      .Start();
+}
+
+float PipTopBarAnimationController::CameraOffsetAt(
+    const gfx::Animation* animation) const {
+  const auto& linear = *static_cast<const gfx::LinearAnimation*>(animation);
+  const double progress = linear.GetCurrentValue();
+  if (progress >= 1) {
+    return camera_to_;
+  }
+  const base::TimeDelta delay = animation == &move_camera_button_to_right_animation_
+                                    ? kCameraSlideRightDelay
+                                    : base::TimeDelta();
+  const double t = progress * (delay + kCameraSpringDuration).InSecondsF() -
+                   delay.InSecondsF();
+  if (t <= 0) {
+    return camera_from_;
+  }
+  // The step response of an underdamped spring starting at rest.
+  const double omega = std::sqrt(kCameraSpringStiffness);
+  const double decay = kCameraSpringDampingRatio * omega;
+  const double damped =
+      omega * std::sqrt(1 - kCameraSpringDampingRatio * kCameraSpringDampingRatio);
+  const double remaining =
+      std::exp(-decay * t) *
+      (std::cos(damped * t) + decay / damped * std::sin(damped * t));
+  return camera_to_ + (camera_from_ - camera_to_) * remaining;
+}
