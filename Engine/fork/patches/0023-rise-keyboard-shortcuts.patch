new file mode 100644
index 0000000000..6dbb1af18c
--- /dev/null
+++ b/chrome/browser/resources/settings/rise_page/rise_keyboard_shortcuts.html.ts
@@ -0,0 +1,47 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import type {SettingsRiseKeyboardShortcutsElement} from './rise_keyboard_shortcuts.js';
+
+export function getHtml(this: SettingsRiseKeyboardShortcutsElement) {
+    return html`
+      <settings-section page-title="Keyboard shortcuts" class="cr-centered-card-container">
+        <div class="intro">
+          <div class="secondary">Choose a shortcut to edit it, then press the keys you want.
+            Escape cancels recording. Changes are saved automatically.</div>
+          <cr-button id="resetAll" ?disabled="${!this.hasModified_()}"
+              @click="${this.onResetAllClick_}">Reset all</cr-button>
+        </div>
+        <div class="search"><cr-input id="filter" aria-label="Search keyboard shortcuts"
+            placeholder="Search keyboard shortcuts" .value="${this.query_}"
+            @value-changed="${this.onFilterValueChanged_}">
+        </cr-input></div>
+        ${this.error_ && !this.errorID_ ? html`<p class="error" role="alert">${this.error_}</p>` : ''}
+        ${this.filteredCommands_().map(command => html`
+          <div class="command" data-command="${command.id}">
+            <div class="label">${command.title}<div class="secondary group">${command.group}</div></div>
+            <div class="bindings">
+              ${this.inputs_(command).map((shortcut, index) => html`
+                <cr-shortcut-input data-command="${command.id}" data-index="${index}" .shortcut="${shortcut}" .allowCtrlAltShortcuts="${true}"
+                    .allowClearingEmpty="${command.bindings.length > 0 && index === command.bindings.length}"
+                    .inputAriaLabel="${`${command.title} shortcut ${index + 1}`}"
+                    .editButtonAriaLabel="${`Record ${command.title} shortcut ${index + 1}`}"
+                    .clearButtonAriaLabel="${`Remove ${command.title} shortcut ${index + 1}`}"
+                    @input-capture-change="${this.onInputCaptureChange_}"
+                    @shortcut-updated="${this.onShortcutUpdated_}">
+                </cr-shortcut-input>
+              `)}
+              ${command.bindings.length > 0 ? html`<cr-button class="add" data-command="${command.id}"
+                  @click="${this.onAddClick_}">Add shortcut</cr-button>` : ''}
+            </div>
+            <cr-button class="reset" data-command="${command.id}" ?disabled="${!command.modified}"
+                aria-label="${`Reset ${command.title} shortcuts`}"
+                @click="${this.onResetClick_}">Reset</cr-button>
+          </div>
+          ${this.error_ && this.errorID_ === command.id ? html`<p class="error" role="alert">${this.error_}</p>` : ''}
+        `)}
+        ${!this.filteredCommands_().length ? html`<div class="empty" role="status">${this.loading_ ? 'Loading shortcuts…' : 'No matching shortcuts'}</div>` : ''}
+      </settings-section>`;
+}
diff --git a/chrome/browser/resources/settings/rise_page/rise_keyboard_shortcuts.ts b/chrome/browser/resources/settings/rise_page/rise_keyboard_shortcuts.ts
new file mode 100644
index 0000000000..d582016b1e
--- /dev/null
+++ b/chrome/browser/resources/settings/rise_page/rise_keyboard_shortcuts.ts
@@ -0,0 +1,197 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/cr_components/cr_shortcut_input/cr_shortcut_input.js';
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import '../settings_page/settings_section.js';
+
+import type {CrShortcutInputElement} from 'chrome://resources/cr_components/cr_shortcut_input/cr_shortcut_input.js';
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {CrLitElement, css} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getSearchManager} from '../search_settings.js';
+import {getCss as getSettingsSharedStyle} from '../settings_shared_lit.css.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {getHtml} from './rise_keyboard_shortcuts.html.js';
+
+interface Command {
+  id: string;
+  title: string;
+  group: string;
+  bindings: string[];
+  defaults: string[];
+  modified: boolean;
+}
+interface Result { commands: Command[]; error: string; }
+interface Bridge { request(kind: string, body: object): Promise<unknown>; }
+interface Recorded {
+  id: string;
+  index: number;
+  shortcut?: string;
+  cancelled?: boolean;
+  error?: string;
+}
+
+export class SettingsRiseKeyboardShortcutsElement extends CrLitElement implements SettingsPlugin {
+  static get is() { return 'settings-rise-keyboard-shortcuts'; }
+  static override get styles() {
+    return [getCrSharedStyle(), getSettingsSharedStyle(), css`
+      :host { display: block; padding-bottom: 24px; }
+      .intro { display: flex; align-items: center; gap: 20px; padding: 16px 20px; }
+      .intro .secondary { flex: 1; line-height: 1.6; }
+      .search { padding: 0 20px 16px; }
+      .command { display: flex; align-items: flex-start; gap: 20px; padding: 16px 20px;
+        border-top: var(--cr-separator-line); min-height: 48px; }
+      .label { flex: 1; min-width: 120px; }
+      .group { margin-top: 6px; }
+      .bindings { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
+      cr-shortcut-input { width: 360px; max-width: 100%; --cr-shortcut-input-width: 100%; }
+      .add { --cr-button-height: 28px; align-self: flex-start; }
+      .reset { align-self: center; }
+      .error { color: var(--cr-error-color); margin: 0; padding: 0 20px 16px;
+        line-height: 1.5; }
+      .empty { padding: 24px 20px; color: var(--cr-secondary-text-color); }
+      @media (max-width: 740px) {
+        .command { flex-direction: column; align-items: stretch; }
+        .bindings { align-items: stretch; }
+        cr-shortcut-input { width: 100%; }
+        .reset { align-self: flex-end; }
+        .intro { flex-wrap: wrap; }
+      }
+    `];
+  }
+  override render() { return getHtml.bind(this)(); }
+  static override get properties() {
+    return {
+      commands_: {type: Array}, query_: {type: String}, error_: {type: String},
+      errorID_: {type: String}, extraID_: {type: String}, loading_: {type: Boolean},
+    };
+  }
+  protected accessor commands_: Command[] = [];
+  protected accessor query_: string = '';
+  protected accessor error_: string = '';
+  protected accessor errorID_: string = '';
+  private accessor extraID_: string = '';
+  protected accessor loading_: boolean = true;
+  private recorder_: {input: CrShortcutInputElement, id: string, index: number}|null = null;
+  private refresh_ = () => { void this.load_(); };
+  private recorded_ = (event: Event) => { void this.onRecorded_((event as CustomEvent<Recorded>).detail); };
+
+  override connectedCallback() {
+    super.connectedCallback();
+    window.addEventListener('rise-settings-ready', this.refresh_);
+    window.addEventListener('rise-shortcut-recorded', this.recorded_);
+    void this.load_();
+  }
+  override disconnectedCallback() {
+    this.stopRecording_();
+    window.removeEventListener('rise-settings-ready', this.refresh_);
+    window.removeEventListener('rise-shortcut-recorded', this.recorded_);
+    super.disconnectedCallback();
+  }
+  async searchContents(query: string) {
+    await this.load_();
+    return (await getSearchManager().search(query, this)).getSearchResult();
+  }
+  private async request_(body: object): Promise<Result|null> {
+    const bridge = window.riseSettings as unknown as Bridge|undefined;
+    if (!bridge) { return null; }
+    try { return await bridge.request('shortcuts', body) as Result; }
+    catch {
+      this.error_ = 'Could not save keyboard shortcuts. Please try again.';
+      this.errorID_ = '';
+      return null;
+    }
+  }
+  private async load_() {
+    const result = await this.request_({action: 'list'});
+    if (result) { this.commands_ = result.commands; this.loading_ = false; }
+  }
+  protected filteredCommands_(): Command[] {
+    const query = this.query_.trim().toLocaleLowerCase();
+    return this.commands_.filter(command => `${command.title} ${command.group}`.toLocaleLowerCase().includes(query));
+  }
+  protected hasModified_(): boolean { return this.commands_.some(command => command.modified); }
+  protected onFilterValueChanged_(event: CustomEvent<{value: string}>) { this.query_ = event.detail.value; }
+  protected onInputCaptureChange_(event: CustomEvent<boolean>) {
+    const input = event.currentTarget as CrShortcutInputElement;
+    void this.capture_(event, input.dataset['command']!, Number(input.dataset['index']));
+  }
+  protected onShortcutUpdated_(event: CustomEvent<string>) {
+    const input = event.currentTarget as CrShortcutInputElement;
+    const id = input.dataset['command']!;
+    const index = Number(input.dataset['index']);
+    const command = this.commands_.find(command => command.id === id);
+    if (!event.detail && this.extraID_ === id && index === command?.bindings.length) {
+      this.stopRecording_();
+      this.extraID_ = ''; this.error_ = ''; this.errorID_ = '';
+      return;
+    }
+    void this.save_(id, index, event.detail);
+  }
+  protected onAddClick_(event: Event) { void this.add_((event.currentTarget as HTMLElement).dataset['command']!); }
+  protected onResetClick_(event: Event) { void this.reset_((event.currentTarget as HTMLElement).dataset['command']!); }
+  protected inputs_(command: Command): string[] {
+    const bindings = command.bindings.length ? [...command.bindings] : [''];
+    if (this.extraID_ === command.id && command.bindings.length) { bindings.push(''); }
+    return bindings;
+  }
+  protected async add_(id: string) {
+    this.stopRecording_(); this.extraID_ = id;
+    await this.updateComplete;
+    const row = Array.from(this.shadowRoot.querySelectorAll<HTMLElement>('.command')).find(row => row.dataset['command'] === id);
+    const inputs = row?.querySelectorAll<CrShortcutInputElement>('cr-shortcut-input');
+    inputs?.[inputs.length - 1]?.shadowRoot?.querySelector<HTMLElement>('#edit')?.click();
+  }
+  protected async capture_(event: CustomEvent<boolean>, id: string, index: number) {
+    event.stopPropagation();
+    const input = event.target as CrShortcutInputElement;
+    if (event.detail) {
+      if (this.recorder_ && this.recorder_.input !== input) { this.stopRecording_(); }
+      this.recorder_ = {input, id, index}; this.error_ = ''; this.errorID_ = '';
+    } else if (this.recorder_?.input === input) { this.recorder_ = null; }
+    await this.request_({action: 'capture', id, index, capturing: event.detail});
+  }
+  private stopRecording_() {
+    const recorder = this.recorder_;
+    if (!recorder) { return; }
+    this.recorder_ = null;
+    recorder.input.$.input.blur();
+    void this.request_({action: 'capture', id: recorder.id, index: recorder.index, capturing: false});
+  }
+  private async onRecorded_(detail: Recorded) {
+    const recorder = this.recorder_;
+    if (!recorder || recorder.id !== detail.id || recorder.index !== detail.index) { return; }
+    if (detail.error) { this.error_ = detail.error; this.errorID_ = detail.id; return; }
+    if (detail.shortcut !== undefined) { recorder.input.shortcut = detail.shortcut; }
+    this.stopRecording_(); this.extraID_ = ''; this.error_ = ''; this.errorID_ = '';
+    await this.load_();
+  }
+  protected async save_(id: string, index: number, shortcut: string) {
+    const result = await this.request_({action: 'set', id, index, shortcut});
+    if (!result) { return; }
+    this.error_ = result.error; this.errorID_ = id;
+    this.commands_ = result.commands;
+    if (!result.error) { this.extraID_ = ''; }
+  }
+  protected async reset_(id: string) {
+    this.stopRecording_();
+    const result = await this.request_({action: 'reset', id});
+    if (!result) { return; }
+    this.commands_ = result.commands; this.error_ = result.error; this.errorID_ = id; this.extraID_ = '';
+  }
+  protected async onResetAllClick_() {
+    this.stopRecording_();
+    const result = await this.request_({action: 'resetAll'});
+    if (!result) { return; }
+    this.commands_ = result.commands; this.error_ = ''; this.errorID_ = ''; this.extraID_ = '';
+  }
+}
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-rise-keyboard-shortcuts': SettingsRiseKeyboardShortcutsElement;
+  }
+}
+customElements.define(SettingsRiseKeyboardShortcutsElement.is, SettingsRiseKeyboardShortcutsElement);
