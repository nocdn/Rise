+
+// The page's own entries for its right-click, as DevTools gives for every menu
+// it shows (its tabs' overflow, its toolbars' menus, a node's or a request's
+// right-click): Chrome shows these in place of its own entries and tells the
+// page which was chosen, then that its menu closed.
+class CustomEntries : public ui::SimpleMenuModel::Delegate {
+ public:
+  CustomEntries(content::RenderFrameHost* frame,
+                const content::ContextMenuParams& params)
+      : frame_(frame->GetGlobalId()),
+        link_followed_(params.link_followed),
+        model_(this) {
+    Add(params.custom_items, 0, &model_);
+  }
 
+  bool IsCommandIdChecked(int command_id) const override {
+    return checked_.contains(command_id);
+  }
+  bool IsCommandIdEnabled(int command_id) const override {
+    return enabled_.contains(command_id);
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (content::WebContents* contents = Contents()) {
+      contents->ExecuteCustomContextMenuCommand(command_id, link_followed_);
+    }
+  }
+  void Closed() {
+    if (content::WebContents* contents = Contents()) {
+      contents->NotifyContextMenuClosed(link_followed_);
+    }
+  }
+
+  ui::MenuModel* model() { return &model_; }
+
+ private:
+  content::WebContents* Contents() const {
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_);
+    return frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  }
+  // As Chrome adds them, no deeper than it goes.
+  void Add(const std::vector<blink::mojom::CustomContextMenuItemPtr>& items,
+           size_t depth,
+           ui::SimpleMenuModel* menu) {
+    if (depth > 5) {
+      return;
+    }
+    for (const auto& item : items) {
+      if (item->enabled) {
+        enabled_.insert(item->action);
+      }
+      if (item->checked) {
+        checked_.insert(item->action);
+      }
+      switch (item->type) {
+        case blink::mojom::CustomContextMenuItemType::kOption:
+          menu->AddItem(item->action, item->label);
+          break;
+        case blink::mojom::CustomContextMenuItemType::kCheckableOption:
+          menu->AddCheckItem(item->action, item->label);
+          break;
+        case blink::mojom::CustomContextMenuItemType::kSeparator:
+          menu->AddSeparator(ui::NORMAL_SEPARATOR);
+          break;
+        case blink::mojom::CustomContextMenuItemType::kSubMenu: {
+          auto submenu = std::make_unique<ui::SimpleMenuModel>(this);
+          Add(item->submenu, depth + 1, submenu.get());
+          menu->AddSubMenu(item->action, item->label, submenu.get());
+          submenus_.push_back(std::move(submenu));
+          break;
+        }
+        case blink::mojom::CustomContextMenuItemType::kGroup:
+          break;
+      }
+    }
+  }
+
+  content::GlobalRenderFrameHostId frame_;
+  GURL link_followed_;
+  ui::SimpleMenuModel model_;
+  std::vector<std::unique_ptr<ui::SimpleMenuModel>> submenus_;
+  base::flat_set<int> enabled_;
+  base::flat_set<int> checked_;
+};
+
