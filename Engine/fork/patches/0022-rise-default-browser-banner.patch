+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {RiseDefaultBrowserBannerElement} from './rise_default_browser_banner.js';
+
+export function getHtml(this: RiseDefaultBrowserBannerElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<div id="card" class="cr-centered-card-container" ?hidden="${!this.shown_}">
+  <div id="controlsColumn">
+    <h2 id="title">Make Rise your default browser</h2>
+    <div id="bodyText" class="cr-secondary-text">
+      Links you open from other apps, such as Mail and Messages, open in Rise.
+    </div>
+    <cr-button class="action-button" id="setDefault"
+        aria-describedby="title bodyText" ?disabled="${this.busy_}"
+        @click="${this.onSetDefaultClick_}">
+      Set as default
+    </cr-button>
+    <cr-button id="dismiss" ?disabled="${this.busy_}"
+        @click="${this.onDismissClick_}">
+      Dismiss
+    </cr-button>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
