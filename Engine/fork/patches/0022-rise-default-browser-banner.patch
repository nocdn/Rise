@@ -0,0 +1,140 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview Above every settings page while Rise isn't the default
+ * browser: making it the default, which macOS confirms, or dismissing the
+ * banner for good. It's laid out as Chrome's Privacy Guide promo was. Rise
+ * answers through `riseSettings.request('defaultBrowser', ...)`.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {CrLitElement, css} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getHtml} from './rise_default_browser_banner.html.js';
+
+interface RiseRequests {
+  request(kind: string, body: object): Promise<unknown>;
+}
+
+function bridge(): RiseRequests|undefined {
+  return window.riseSettings as unknown as RiseRequests | undefined;
+}
+
+export class RiseDefaultBrowserBannerElement extends CrLitElement {
+  static get is() {
+    return 'rise-default-browser-banner';
+  }
+
+  static override get styles() {
+    return [
+      getCrSharedStyle(),
+      css`
+        :host {
+          display: block;
+        }
+        #card[hidden] {
+          display: none;
+        }
+        #card {
+          background-color: var(--cr-card-background-color);
+          border-radius: var(--cr-card-border-radius);
+          box-shadow: var(--cr-card-shadow);
+          overflow: hidden;
+        }
+        #controlsColumn {
+          padding: 20px;
+        }
+        h2 {
+          color: var(--cr-primary-text-color);
+          font-size: 22px;
+          font-weight: 400;
+          margin: 0;
+          padding: 0 0 8px;
+        }
+        #bodyText {
+          padding-block-end: 16px;
+        }
+        #setDefault {
+          margin-inline-end: 16px;
+        }
+      `,
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      shown_: {type: Boolean},
+      busy_: {type: Boolean},
+    };
+  }
+
+  protected accessor shown_: boolean = false;
+  protected accessor busy_: boolean = false;
+
+  private onRefresh_ = () => {
+    this.refresh_();
+  };
+
+  override connectedCallback() {
+    super.connectedCallback();
+    window.addEventListener('rise-settings-ready', this.onRefresh_);
+    // Rise may have become the default in System Settings meanwhile.
+    window.addEventListener('focus', this.onRefresh_);
+    document.addEventListener('visibilitychange', this.onRefresh_);
+    this.refresh_();
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    window.removeEventListener('rise-settings-ready', this.onRefresh_);
+    window.removeEventListener('focus', this.onRefresh_);
+    document.removeEventListener('visibilitychange', this.onRefresh_);
+  }
+
+  private async ask_(action: string) {
+    const riseSettings = bridge();
+    if (!riseSettings) {
+      return;
+    }
+    const state = await riseSettings.request('defaultBrowser', {action}) as
+        {shown?: boolean} | null;
+    this.shown_ = !!state?.shown;
+  }
+
+  private refresh_() {
+    if (!this.busy_) {
+      this.ask_('state');
+    }
+  }
+
+  // macOS asks whether to use Rise; the banner stays if the answer is no.
+  protected async onSetDefaultClick_() {
+    this.busy_ = true;
+    try {
+      await this.ask_('set');
+    } finally {
+      this.busy_ = false;
+    }
+  }
+
+  protected onDismissClick_() {
+    this.shown_ = false;
+    this.ask_('dismiss');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'rise-default-browser-banner': RiseDefaultBrowserBannerElement;
+  }
+}
+
+customElements.define(
+    RiseDefaultBrowserBannerElement.is, RiseDefaultBrowserBannerElement);
