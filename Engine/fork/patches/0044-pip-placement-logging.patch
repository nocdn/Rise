diff --git a/chrome/browser/picture_in_picture/rise_pip_log.h b/chrome/browser/picture_in_picture/rise_pip_log.h
new file mode 100644
index 0000000..8a9cc8b
--- /dev/null
+++ b/chrome/browser/picture_in_picture/rise_pip_log.h
@@ -0,0 +1,38 @@
+// Copyright 2026 Rise
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PICTURE_IN_PICTURE_RISE_PIP_LOG_H_
+#define CHROME_BROWSER_PICTURE_IN_PICTURE_RISE_PIP_LOG_H_
+
+#include <string>
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_MAC)
+#include <os/log.h>
+#endif
+
+namespace rise_pip {
+
+// Rise's diagnostics for a page's floating window, in the system log beside
+// Rise's own (subsystem dev.bartosz.Rise, category FloatingPage): where Chrome
+// places and moves the window, and why. Never the page's address.
+inline void Log(const std::string& message) {
+#if BUILDFLAG(IS_MAC)
+  static os_log_t logger = os_log_create("dev.bartosz.Rise", "FloatingPage");
+  os_log(logger, "engine: %{public}s", message.c_str());
+#endif
+}
+
+// For what happens on every frame of a move, kept only while streaming.
+inline void LogDebug(const std::string& message) {
+#if BUILDFLAG(IS_MAC)
+  static os_log_t logger = os_log_create("dev.bartosz.Rise", "FloatingPage");
+  os_log_debug(logger, "engine: %{public}s", message.c_str());
+#endif
+}
+
+}  // namespace rise_pip
+
+#endif  // CHROME_BROWSER_PICTURE_IN_PICTURE_RISE_PIP_LOG_H_
