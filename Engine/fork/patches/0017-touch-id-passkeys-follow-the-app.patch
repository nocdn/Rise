@@ -58,6 +58,18 @@
   return [entitlement_value_nsarray
       containsObject:base::SysUTF8ToNSString(keychain_access_group)];
 }
+
+std::string ExecutableApplicationIdentifier() {
+  base::apple::ScopedCFTypeRef<SecTaskRef> task(SecTaskCreateFromSelf(nullptr));
+  if (!task) {
+    return std::string();
+  }
+  base::apple::ScopedCFTypeRef<CFTypeRef> value(
+      KeychainV2::GetInstance().TaskCopyValueForEntitlement(
+          task.get(), CFSTR("com.apple.application-identifier"), nullptr));
+  CFStringRef identifier = base::apple::CFCast<CFStringRef>(value.get());
+  return identifier ? base::SysCFStringRefToUTF8(identifier) : std::string();
+}
 #endif  // !BUILDFLAG(IS_IOS)
 
