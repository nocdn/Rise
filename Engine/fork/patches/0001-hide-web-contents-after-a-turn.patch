 - (void)updateWebContentsVisibility {
   using remote_cocoa::mojom::Visibility;
   if (!_host)
     return;
 
-  Visibility visibility = Visibility::kVisible;
-  if ([self isHiddenOrHasHiddenAncestor] || ![self window])
-    visibility = Visibility::kHidden;
-  else if ([[self window] isOccluded])
-    visibility = Visibility::kOccluded;
+  // Rise: an embedder moving this view to another superview takes it out of its
+  // window for an instant. Hiding the web contents then throws away the page's
+  // picture, which shows blank for several frames once the view is back. So a
+  // hide waits for the next turn of the run loop, after the frame is drawn, and
+  // only happens if the view is still out of sight.
+  Visibility visibility = [self currentVisibility];
+  [NSObject cancelPreviousPerformRequestsWithTarget:self
+                                           selector:@selector(updateWebContentsVisibilityAfterTurn)
+                                             object:nil];
+  if (visibility == Visibility::kHidden) {
+    [self performSelector:@selector(updateWebContentsVisibilityAfterTurn)
+               withObject:nil
+               afterDelay:0
+                  inModes:@[ NSRunLoopCommonModes ]];
+    return;
+  }
 
   [self updateWebContentsVisibility:visibility];
 }
 
+- (void)updateWebContentsVisibilityAfterTurn {
+  if (_host)
+    [self updateWebContentsVisibility:[self currentVisibility]];
+}
