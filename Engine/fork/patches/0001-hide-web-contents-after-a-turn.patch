+- (remote_cocoa::mojom::Visibility)currentVisibility {
+  using remote_cocoa::mojom::Visibility;
+  if ([self isHiddenOrHasHiddenAncestor] || ![self window])
+    return Visibility::kHidden;
+  if ([[self window] isOccluded])
+    return Visibility::kOccluded;
+  return Visibility::kVisible;
+}
