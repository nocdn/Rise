+gfx::ImageSkia SymbolImage(const char* name, float point_size, SkColor color) {
+  NSImage* symbol =
+      [NSImage imageWithSystemSymbolName:@(name) accessibilityDescription:nil];
+  NSImageSymbolConfiguration* configuration = [[NSImageSymbolConfiguration
+      configurationWithPointSize:point_size
+                          weight:NSFontWeightSemibold]
+      configurationByApplyingConfiguration:
+          [NSImageSymbolConfiguration configurationWithPaletteColors:@[
+            skia::SkColorToSRGBNSColor(color)
+          ]]];
+  NSImage* image = [symbol imageWithSymbolConfiguration:configuration];
+  return image ? gfx::ImageSkiaFromNSImage(image) : gfx::ImageSkia();
+}
+
+void AnnounceShowing(gfx::NativeWindow window) {
+  NSWindow* ns_window = window.GetNativeNSWindow();
+  if (!ns_window) {
+    return;
+  }
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:@"RisePictureInPictureWillShow"
+                    object:ns_window];
+}
+
+void AnnounceClosing(gfx::NativeWindow window) {
+  NSWindow* ns_window = window.GetNativeNSWindow();
+  if (!ns_window) {
+    return;
+  }
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:@"RisePictureInPictureWillClose"
+                    object:ns_window];
+}
