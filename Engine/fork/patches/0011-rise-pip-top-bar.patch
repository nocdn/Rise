+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_RISE_PIP_TOP_BAR_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_RISE_PIP_TOP_BAR_H_
+
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "chrome/browser/ui/views/location_bar/location_icon_view.h"
+#include "ui/gfx/animation/animation_delegate.h"
+#include "ui/gfx/animation/linear_animation.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/controls/button/button.h"
+
+// Rise's look for the bar along the top of a page's picture-in-picture window
+// (Document Picture-in-Picture, such as Meet's call): buttons with rounded
+// square backgrounds that show the moment the pointer is over them, shrink a
+// touch while pressed, and in the window's corners follow its curve. The
+// return and close buttons carry the glyphs of Rise's own floating video.
+namespace rise_pip {
+
+inline constexpr int kTopBarHeight = 36;
+inline constexpr int kButtonSize = 28;
+// The window's fade in, as Rise's floating video's (FloatingEntrance).
+inline constexpr int kFadeInDurationMs = 160;
+// From the window's top and side edges to the buttons in its corners.
+inline constexpr int kEdgeInset = (kTopBarHeight - kButtonSize) / 2;
+
+// A button's corners: concentric with the window's in a corner it sits in, and
+// Rise's usual radius elsewhere.
+gfx::RoundedCornersF ButtonCorners(bool top_left, bool top_right);
+
+// A value moving to its target the way Rise's buttons move: an underdamped
+// spring (stiffness 520, damping ratio 0.6), or a quick ease-out.
+class Motion : public gfx::AnimationDelegate {
+ public:
+  Motion(float value, base::RepeatingClosure on_step);
+  ~Motion() override;
+
+  void SpringTo(float target);
+  void EaseTo(float target, base::TimeDelta duration);
+  float value() const { return value_; }
+
+ private:
+  void Start(float target, bool spring, base::TimeDelta duration);
+  void AnimationProgressed(const gfx::Animation* animation) override;
+
+  gfx::LinearAnimation animation_{this};
+  base::RepeatingClosure on_step_;
+  float from_ = 0, to_ = 0, value_ = 0;
+  bool spring_ = false;
+};
+
+// Rise's background and press for one of the bar's buttons: the background
+// shows at once under the pointer and deepens while pressed, and the button
+// shrinks a touch while pressed and springs back on release.
+class ButtonStyle {
+ public:
+  ButtonStyle(views::Button& button, const gfx::RoundedCornersF& corners);
+  ~ButtonStyle();
+
+  void PaintBackground(gfx::Canvas* canvas) const;
+
+ private:
+  void StateChanged();
+  void ApplyScale();
+
+  const raw_ref<views::Button> button_;
+  const gfx::RoundedCornersF corners_;
+  bool pressed_ = false;
+  Motion scale_;
+  base::CallbackListSubscription state_subscription_;
+};
+
+// The page's info button: Chrome's location icon, in Rise's style.
+class LocationButton : public LocationIconView {
+  METADATA_HEADER(LocationButton, LocationIconView)
+
+ public:
+  LocationButton(const gfx::FontList& font_list,
+                 IconLabelBubbleView::Delegate* parent_delegate,
+                 LocationIconView::Delegate* delegate);
+  ~LocationButton() override;
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  gfx::Size GetMinimumSize() const override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+
+ private:
+  void UpdateBackground() override;
+  void UpdateBorder() override;
+
+  ButtonStyle style_;
+};
+
+// The return and close buttons, with the floating video's arrows and cross.
+class GlyphButton : public views::Button {
+  METADATA_HEADER(GlyphButton, views::Button)
+
+ public:
+  enum class Glyph { kArrows, kCross };
+  GlyphButton(Glyph glyph,
+              const gfx::RoundedCornersF& corners,
+              const std::u16string& title,
+              PressedCallback callback);
+  ~GlyphButton() override;
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+  void StateChanged(ButtonState old_state) override;
+  void OnThemeChanged() override;
+
+ private:
+  const Glyph glyph_;
+  ButtonStyle style_;
+  // The arrows spread apart under the pointer.
+  Motion spread_;
+  gfx::ImageSkia arrows_;
+};
+
+// Tells Rise the window is about to show and fade in, so Rise can spring it in
+// from its first frame ("RisePictureInPictureWillShow", posted with the
+// NSWindow).
+void AnnounceShowing(gfx::NativeWindow window);
+
+// Tells Rise the window is about to close from its own buttons, while it still
+// shows, so Rise can play its close over where it was
+// ("RisePictureInPictureWillClose", posted with the NSWindow).
+void AnnounceClosing(gfx::NativeWindow window);
+
+// The system symbol `name` at `point_size`, semibold, in `color`.
+gfx::ImageSkia SymbolImage(const char* name, float point_size, SkColor color);
+
+}  // namespace rise_pip
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_RISE_PIP_TOP_BAR_H_
