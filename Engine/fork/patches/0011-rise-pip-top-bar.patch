@@ -0,0 +1,308 @@
+// Copyright 2026 Rise
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/rise_pip_top_bar.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/rrect_f.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/highlight_path_generator.h"
+
+namespace rise_pip {
+
+namespace {
+
+// macOS rounds the window's corners to 16 points.
+constexpr float kWindowRadius = 16;
+constexpr float kButtonRadius = 6;
+constexpr float kPressedScale = 0.88f;
+// The glyphs of the floating video's 30-point buttons, at this size.
+constexpr float kGlyphPointSize = 11.5f;
+constexpr float kGlyphScale = kGlyphPointSize / 13;
+// Half the cross's ink, and its strokes: the 13-point semibold xmark.
+constexpr float kCrossArmX = 4.05f * kGlyphScale, kCrossArmY = 4.36f * kGlyphScale;
+constexpr float kCrossWidth = 1.9f * kGlyphScale;
+constexpr float kArrowsSpread = 1.5f * kGlyphScale;
+
+constexpr double kSpringStiffness = 520, kSpringDampingRatio = 0.6;
+constexpr base::TimeDelta kSpringDuration = base::Milliseconds(500);
+
+SkColor Foreground(const views::View& view) {
+  return view.GetColorProvider()->GetColor(kColorPipWindowForeground);
+}
+
+}  // namespace
+
+gfx::RoundedCornersF ButtonCorners(bool top_left, bool top_right) {
+  const float corner = kWindowRadius - kEdgeInset;
+  return gfx::RoundedCornersF(top_left ? corner : kButtonRadius,
+                              top_right ? corner : kButtonRadius, kButtonRadius,
+                              kButtonRadius);
+}
+
+Motion::Motion(float value, base::RepeatingClosure on_step)
+    : on_step_(std::move(on_step)), from_(value), to_(value), value_(value) {}
+
+Motion::~Motion() = default;
+
+void Motion::SpringTo(float target) {
+  Start(target, /*spring=*/true, kSpringDuration);
+}
+
+void Motion::EaseTo(float target, base::TimeDelta duration) {
+  Start(target, /*spring=*/false, duration);
+}
+
+void Motion::Start(float target, bool spring, base::TimeDelta duration) {
+  animation_.Stop();
+  from_ = value_;
+  to_ = target;
+  spring_ = spring;
+  if (gfx::Animation::PrefersReducedMotion() || from_ == to_) {
+    value_ = to_;
+    on_step_.Run();
+    return;
+  }
+  animation_.SetDuration(duration);
+  animation_.Start();
+}
+
+void Motion::AnimationProgressed(const gfx::Animation* animation) {
+  const double progress = animation_.GetCurrentValue();
+  if (progress >= 1) {
+    value_ = to_;
+  } else if (spring_) {
+    // The step response of an underdamped spring starting at rest.
+    const double t = progress * kSpringDuration.InSecondsF();
+    const double omega = std::sqrt(kSpringStiffness);
+    const double decay = kSpringDampingRatio * omega;
+    const double damped =
+        omega * std::sqrt(1 - kSpringDampingRatio * kSpringDampingRatio);
+    const double remaining =
+        std::exp(-decay * t) *
+        (std::cos(damped * t) + decay / damped * std::sin(damped * t));
+    value_ = to_ + (from_ - to_) * remaining;
+  } else {
+    value_ = gfx::Tween::FloatValueBetween(
+        gfx::Tween::CalculateValue(gfx::Tween::EASE_OUT, progress), from_, to_);
+  }
+  on_step_.Run();
+}
+
+ButtonStyle::ButtonStyle(views::Button& button,
+                         const gfx::RoundedCornersF& corners)
+    : button_(button),
+      corners_(corners),
+      scale_(1, base::BindRepeating(&ButtonStyle::ApplyScale,
+                                    base::Unretained(this))) {
+  // The background replaces the ink drop, which fades in.
+  views::InkDrop::Get(&button)->SetMode(views::InkDropHost::InkDropMode::OFF);
+  views::HighlightPathGenerator::Install(
+      &button, std::make_unique<views::RoundRectHighlightPathGenerator>(
+                   gfx::Insets(), corners));
+  if (!button.layer()) {
+    button.SetPaintToLayer();
+    button.layer()->SetFillsBoundsOpaquely(false);
+  }
+  state_subscription_ = button.AddStateChangedCallback(base::BindRepeating(
+      &ButtonStyle::StateChanged, base::Unretained(this)));
+}
+
+ButtonStyle::~ButtonStyle() = default;
+
+void ButtonStyle::PaintBackground(gfx::Canvas* canvas) const {
+  const views::Button::ButtonState state = button_->GetState();
+  if (state != views::Button::STATE_HOVERED &&
+      state != views::Button::STATE_PRESSED) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(Foreground(*button_),
+                             state == views::Button::STATE_PRESSED ? 0x33 : 0x1F));
+  const gfx::RRectF shape(gfx::RectF(button_->GetLocalBounds()), corners_);
+  canvas->DrawPath(SkPath::RRect(SkRRect(shape)), flags);
+}
+
+void ButtonStyle::StateChanged() {
+  const bool pressed = button_->GetState() == views::Button::STATE_PRESSED;
+  if (pressed == pressed_) {
+    return;
+  }
+  pressed_ = pressed;
+  if (pressed) {
+    scale_.EaseTo(kPressedScale, base::Milliseconds(80));
+  } else {
+    scale_.SpringTo(1);
+  }
+}
+
+void ButtonStyle::ApplyScale() {
+  if (!button_->layer()) {
+    return;
+  }
+  const gfx::PointF center = gfx::RectF(button_->GetLocalBounds()).CenterPoint();
+  gfx::Transform transform;
+  transform.Translate(center.x(), center.y());
+  transform.Scale(scale_.value(), scale_.value());
+  transform.Translate(-center.x(), -center.y());
+  button_->layer()->SetTransform(transform);
+}
+
+LocationButton::LocationButton(const gfx::FontList& font_list,
+                               IconLabelBubbleView::Delegate* parent_delegate,
+                               LocationIconView::Delegate* delegate)
+    : LocationIconView(font_list, parent_delegate, delegate),
+      style_(*this, ButtonCorners(/*top_left=*/true, /*top_right=*/false)) {
+  UpdateBorder();
+}
+
+LocationButton::~LocationButton() = default;
+
+gfx::Size LocationButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Chrome's chip is as tall as the omnibox's text; this is the bar's other
+  // buttons' square, wider only for a label such as "Not secure".
+  const int width =
+      ShouldShowLabel()
+          ? LocationIconView::CalculatePreferredSize(available_size).width()
+          : kButtonSize;
+  return gfx::Size(std::max(width, kButtonSize), kButtonSize);
+}
+
+gfx::Size LocationButton::GetMinimumSize() const {
+  return gfx::Size(kButtonSize, kButtonSize);
+}
+
+void LocationButton::OnPaintBackground(gfx::Canvas* canvas) {
+  style_.PaintBackground(canvas);
+}
+
+void LocationButton::UpdateBackground() {
+  // Chrome's chip background and its fading highlight give way to Rise's.
+  SetBackground(nullptr);
+  views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+}
+
+void LocationButton::UpdateBorder() {
+  // The 16-point icon in a square the size of the bar's other buttons.
+  SetBorder(views::CreateEmptyBorder(gfx::Insets((kButtonSize - 16) / 2)));
+}
+
+BEGIN_METADATA(LocationButton)
+END_METADATA
+
+GlyphButton::GlyphButton(Glyph glyph,
+                         const gfx::RoundedCornersF& corners,
+                         const std::u16string& title,
+                         PressedCallback callback)
+    : views::Button(std::move(callback)),
+      glyph_(glyph),
+      style_(*this, corners),
+      spread_(0, base::BindRepeating(&views::View::SchedulePaint,
+                                     base::Unretained(this))) {
+  SetTooltipText(title);
+  GetViewAccessibility().SetName(title);
+  SetInstallFocusRingOnFocus(true);
+}
+
+GlyphButton::~GlyphButton() = default;
+
+gfx::Size GlyphButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kButtonSize, kButtonSize);
+}
+
+void GlyphButton::OnPaintBackground(gfx::Canvas* canvas) {
+  style_.PaintBackground(canvas);
+}
+
+void GlyphButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const gfx::PointF center = gfx::RectF(GetLocalBounds()).CenterPoint();
+  if (glyph_ == Glyph::kCross) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeWidth(kCrossWidth);
+    flags.setColor(Foreground(*this));
+    for (const float direction : {1.f, -1.f}) {
+      canvas->DrawLine(
+          gfx::PointF(center.x() - kCrossArmX, center.y() - direction * kCrossArmY),
+          gfx::PointF(center.x() + kCrossArmX, center.y() + direction * kCrossArmY),
+          flags);
+    }
+    return;
+  }
+  if (arrows_.isNull()) {
+    return;
+  }
+  // Each arrow is the symbol cut along its bottom-left to top-right diagonal,
+  // and moves out along the other diagonal.
+  const float width = arrows_.width(), height = arrows_.height();
+  const gfx::PointF origin(center.x() - width / 2, center.y() - height / 2);
+  const float distance = spread_.value() * kArrowsSpread;
+  for (const float direction : {-1.f, 1.f}) {
+    gfx::ScopedCanvas scoped(canvas);
+    canvas->sk_canvas()->translate(origin.x() + direction * distance,
+                                   origin.y() + direction * distance);
+    SkPathBuilder half;
+    if (direction < 0) {
+      half.moveTo(0, 0).lineTo(width, 0).lineTo(0, height).close();
+    } else {
+      half.moveTo(width, 0).lineTo(width, height).lineTo(0, height).close();
+    }
+    canvas->ClipPath(half.detach(), /*do_anti_alias=*/true);
+    canvas->DrawImageInt(arrows_, 0, 0);
+  }
+}
+
+void GlyphButton::StateChanged(ButtonState old_state) {
+  views::Button::StateChanged(old_state);
+  if (glyph_ != Glyph::kArrows) {
+    return;
+  }
+  const bool hovered = GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  const bool was_hovered = old_state == STATE_HOVERED || old_state == STATE_PRESSED;
+  if (hovered == was_hovered) {
+    return;
+  }
+  // Springs out under the pointer, and back quickly when it leaves.
+  if (hovered) {
+    spread_.SpringTo(1);
+  } else {
+    spread_.EaseTo(0, base::Milliseconds(100));
+  }
+}
+
+void GlyphButton::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  if (glyph_ == Glyph::kArrows) {
+    arrows_ = SymbolImage("arrow.up.left.and.arrow.down.right", kGlyphPointSize,
+                          Foreground(*this));
+  }
+  SchedulePaint();
+}
