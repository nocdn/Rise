 // What Rise shows itself for a page, in its own interface.
+// Tells Rise whether the page used a key press it asked about: Rise gives a
+// page the shortcuts it might want first, and offers its own command if the
+// page kept the key. Watches one press in the widget that has the keyboard.
+class PageKeyWatcher : public content::RenderWidgetHost::InputEventObserver {
+ public:
+  explicit PageKeyWatcher(RCBrowserView* view) : view_(view) {}
+  ~PageKeyWatcher() override { Stop(); }
+
+  void Watch(content::RenderWidgetHost* host) {
+    Stop();
+    process_id_ = host->GetProcess()->GetDeprecatedID();
+    routing_id_ = host->GetRoutingID();
+    host->AddInputEventObserver(this);
+  }
+
+  void OnInputEventAck(const content::RenderWidgetHost&,
+                       blink::mojom::InputEventResultSource,
+                       blink::mojom::InputEventResultState state,
+                       const blink::WebInputEvent& event) override {
+    if (event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+      return;
+    }
+    const int key_code =
+        static_cast<const blink::WebKeyboardEvent&>(event).native_key_code;
+    Stop();
+    RCBrowserView* view = view_;
+    id<RCBrowserViewDelegate> delegate = view.delegate;
+    if (state == blink::mojom::InputEventResultState::kConsumed &&
+        [delegate respondsToSelector:@selector(browserView:pageUsedKeyCode:)]) {
+      [delegate browserView:view
+            pageUsedKeyCode:static_cast<unsigned short>(key_code)];
+    }
+  }
+
+ private:
+  void Stop() {
+    if (content::RenderWidgetHost* host =
+            routing_id_ ? content::RenderWidgetHost::FromID(process_id_,
+                                                            routing_id_)
+                        : nullptr) {
+      host->RemoveInputEventObserver(this);
+    }
+    routing_id_ = 0;
+  }
+
+  __weak RCBrowserView* view_;
+  int process_id_ = 0;
+  int routing_id_ = 0;
+};
