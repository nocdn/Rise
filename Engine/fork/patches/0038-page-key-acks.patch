+- (void)watchNextKeyPress {
+  if (!_contents) {
+    return;
+  }
+  content::RenderFrameHost* frame = _contents->GetFocusedFrame();
+  if (!frame) {
+    frame = _contents->GetPrimaryMainFrame();
+  }
+  if (!frame || !frame->GetRenderWidgetHost()) {
+    return;
+  }
+  if (!_keyWatcher) {
+    _keyWatcher = std::make_unique<PageKeyWatcher>(self);
+  }
+  _keyWatcher->Watch(frame->GetRenderWidgetHost());
