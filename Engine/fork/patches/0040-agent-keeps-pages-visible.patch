 @synthesize extensionPopup = _extensionPopup;
 @synthesize covered = _covered;
+@synthesize keepsVisible = _keepsVisible;
+
+// Kept visible: Chromium runs the page as one on screen, drawing and taking
+// input, though it's out of sight or its window is covered, as it does a page
+// being captured. A page hidden or occluded otherwise stops drawing, and input
+// sent to it, as by DevTools, waits on a frame that never comes.
+- (void)setKeepsVisible:(BOOL)keepsVisible {
+  if (keepsVisible == _keepsVisible) {
+    return;
+  }
+  _keepsVisible = keepsVisible;
+  [self holdVisibleCapture];
+}
+- (void)holdVisibleCapture {
+  if (_keepsVisible && _contents) {
+    if (!_visibleCapture) {
+      _visibleCapture = _contents->IncrementCapturerCount(
+          gfx::Size(), /*stay_hidden=*/false, /*stay_awake=*/true,
+          /*is_activity=*/false);
+    }
+  } else {
+    _visibleCapture.RunAndReset();
+  }
+}
 
