+// Rise: its own item's names, given on the command line once Rise has moved its key
+// there; otherwise Chromium's, as for an older build or a test's throwaway profile.
+std::string RiseKeychainName(const char* name_switch, const char* fallback) {
+  if (!base::CommandLine::InitializedForCurrentProcess()) {
+    return fallback;
+  }
+  std::string name =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(name_switch);
+  return name.empty() ? std::string(fallback) : name;
+}
