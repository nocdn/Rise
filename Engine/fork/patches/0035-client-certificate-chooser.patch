+  // A site asking for a certificate to identify the person: Rise has them
+  // choose among the keychain's identities that suit it, in macOS's chooser.
+  bool SelectClientCertificate(
+      const net::SSLCertRequestInfo& request,
+      net::ClientCertIdentityList& certs,
+      std::unique_ptr<content::ClientCertificateDelegate>& delegate,
+      base::OnceClosure* cancel) override {
+    RCBrowserView* view = view_;
+    id<RCBrowserViewDelegate> rise = view.delegate;
+    if (!view || certs.empty() ||
+        ![rise respondsToSelector:@selector
+               (browserView:chooseClientCertificate:host:completion:)]) {
+      return false;
+    }
+    // The keychain's identities for the certificates, in Chrome's order.
+    NSMutableArray* identities = [NSMutableArray array];
+    auto choices = std::make_shared<net::ClientCertIdentityList>();
+    for (std::unique_ptr<net::ClientCertIdentity>& cert : certs) {
+      base::apple::ScopedCFTypeRef<SecCertificateRef> certificate =
+          net::x509_util::CreateSecCertificateFromX509Certificate(
+              cert->certificate());
+      SecIdentityRef identity = nullptr;
+      if (certificate &&
+          SecIdentityCreateWithCertificate(nullptr, certificate.get(),
+                                           &identity) == errSecSuccess) {
+        [identities addObject:(__bridge_transfer id)identity];
+        choices->push_back(std::move(cert));
+      }
+    }
+    if (!identities.count) {
+      return false;
+    }
+    // Answered once: with the identity chosen, or none (Cancel), which Chrome
+    // keeps for the site until it quits, as it does from its own chooser.
+    auto answer =
+        std::make_shared<std::unique_ptr<content::ClientCertificateDelegate>>(
+            std::move(delegate));
+    [rise browserView:view
+        chooseClientCertificate:identities
+                           host:base::SysUTF8ToNSString(
+                                    request.host_and_port.host())
+                     completion:^(NSInteger index) {
+                       if (!*answer) {
+                         return;
+                       }
+                       std::unique_ptr<content::ClientCertificateDelegate>
+                           chosen_delegate = std::move(*answer);
+                       if (index < 0 ||
+                           static_cast<size_t>(index) >= choices->size()) {
+                         chosen_delegate->ContinueWithCertificate(nullptr,
+                                                                  nullptr);
+                         return;
+                       }
+                       std::unique_ptr<net::ClientCertIdentity> chosen =
+                           std::move((*choices)[index]);
+                       scoped_refptr<net::X509Certificate> certificate =
+                           chosen->certificate();
+                       net::ClientCertIdentity::SelfOwningAcquirePrivateKey(
+                           std::move(chosen),
+                           base::BindOnce(&content::ClientCertificateDelegate::
+                                              ContinueWithCertificate,
+                                          std::move(chosen_delegate),
+                                          std::move(certificate)));
+                     }];
+    // The request went away first: the chooser closes, unanswered.
+    __weak RCBrowserView* weak_view = view;
+    *cancel = base::BindOnce(
+        [](std::shared_ptr<
+               std::unique_ptr<content::ClientCertificateDelegate>> answer,
+           __weak RCBrowserView* view) {
+          answer->reset();
+          RCBrowserView* shown = view;
+          if ([shown.delegate respondsToSelector:@selector
+                              (browserViewDidCancelClientCertificate:)]) {
+            [shown.delegate browserViewDidCancelClientCertificate:shown];
+          }
+        },
+        answer, weak_view);
+    return true;
+  }
