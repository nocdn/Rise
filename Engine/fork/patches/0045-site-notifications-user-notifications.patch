@@ -24,6 +24,12 @@ class MacNotificationProviderImpl : public mojom::MacNotificationProvider {
   explicit MacNotificationProviderImpl(
       mojo::PendingReceiver<mojom::MacNotificationProvider> binding);
 
+  // Rise's: banners shown from the browser's own process with the
+  // UserNotifications API. Rise uses that API itself, and once an app has,
+  // macOS refuses its NSUserNotificationCenter ones without a word.
+  struct UseUserNotifications {};
+  explicit MacNotificationProviderImpl(UseUserNotifications);
+
   MacNotificationProviderImpl(const MacNotificationProviderImpl&) = delete;
   MacNotificationProviderImpl& operator=(const MacNotificationProviderImpl&) =
       delete;
