--- a/chrome/browser/rise/RiseChromium.h
+++ b/chrome/browser/rise/RiseChromium.h
@@ -399,6 +399,10 @@
 - (nullable CALayer *)liveLayerShowing:(NSRect)rect;
 /// A picture of what the page shows now, the size of this view.
 - (void)snapshotWithCompletion:(void (^)(NSImage *_Nullable image))completion;
+/// What the page shows now in `rect` (points from its top left), scaled to `size` pixels as it's
+/// copied: cheap enough to look at a strip of the page several times a second. Nil while it isn't
+/// drawing, as when hidden. `completion` may come on any thread.
+- (void)snapshotRect:(NSRect)rect size:(NSSize)size completion:(void (^)(NSImage *_Nullable image))completion;
 /// Closes the page for good; the view shows nothing after.
 - (void)close;
 @end
--- a/chrome/browser/rise/rise_bridge.mm
+++ b/chrome/browser/rise/rise_bridge.mm
@@ -89,6 +89,8 @@
 #include "extensions/browser/install_prompt_data.h"
 #include "extensions/common/extension.h"
 #include "extensions/common/manifest.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
 #include "ui/gfx/image/image.h"
 #include "ui/gfx/image/image_skia.h"
 #include "chrome/browser/spellchecker/spellcheck_custom_dictionary.h"
@@ -2641,6 +2643,30 @@
             completion(image);
           },
           completion, size));
+}
+
+- (void)snapshotRect:(NSRect)rect
+                size:(NSSize)size
+          completion:(void (^)(NSImage*))completion {
+  content::RenderWidgetHostView* view =
+      _contents ? _contents->GetRenderWidgetHostView() : nullptr;
+  const gfx::Rect source = gfx::ToEnclosingRect(gfx::RectF(
+      rect.origin.x, rect.origin.y, rect.size.width, rect.size.height));
+  if (!view || source.IsEmpty() || size.width < 1 || size.height < 1 ||
+      !view->IsSurfaceAvailableForCopy()) {
+    completion(nil);
+    return;
+  }
+  view->CopyFromSurface(
+      source, gfx::Size(size.width, size.height), base::Seconds(1),
+      base::BindOnce(
+          [](void (^completion)(NSImage*),
+             const content::CopyFromSurfaceResult& result) {
+            completion(result.has_value() && !result->bitmap.drawsNothing()
+                           ? skia::SkBitmapToNSImage(result->bitmap)
+                           : nil);
+          },
+          completion));
 }
 
