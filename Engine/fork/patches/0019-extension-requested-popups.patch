+  // An extension can request its popup without clicking Rise's toolbar button.
+  bool ShowExtensionPopup(const std::string& extension_id,
+                          const GURL& url,
+                          base::OnceCallback<void(bool)> done) override {
+    RCBrowserView* view = view_;
+    id<RCBrowserViewDelegate> delegate = view.delegate;
+    if (![delegate respondsToSelector:
+                      @selector(browserView:showExtensionPopup:extensionID:completion:)]) {
+      return false;
+    }
+    auto answer = std::make_shared<base::OnceCallback<void(bool)>>(std::move(done));
+    [delegate browserView:view
+        showExtensionPopup:ToNSURL(url)
+               extensionID:base::SysUTF8ToNSString(extension_id)
+                completion:^(BOOL shown) {
+                  // Even an immediate refusal answers after the extension function's Run()
+                  // has returned RespondLater(). A closing popup must not answer twice.
+                  dispatch_async(dispatch_get_main_queue(), ^{
+                    if (*answer) {
+                      std::move(*answer).Run(shown);
+                    }
+                  });
+                }];
+    return true;
+  }
