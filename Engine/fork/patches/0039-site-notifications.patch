+// Waits for Chromium to start, then sets notifications as Rise's choices say.
++ (void)whenStarted:(void (^)(HostContentSettingsMap*))apply {
+  void (^run)(void) = ^{
+    if (Profile* profile = RiseProfile()) {
+      apply(HostContentSettingsMapFactory::GetForProfile(profile));
+    }
+  };
+  if (g_started) {
+    run();
+    return;
+  }
+  if (!g_waiting_for_start) {
+    g_waiting_for_start = [NSMutableArray array];
+  }
+  [g_waiting_for_start addObject:run];
+}
+
++ (void)setNotificationPermission:(NSInteger)permission
+                        forOrigin:(NSString*)origin {
+  GURL url(base::SysNSStringToUTF8(origin));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  ContentSetting setting = permission > 0   ? CONTENT_SETTING_ALLOW
+                           : permission < 0 ? CONTENT_SETTING_BLOCK
+                                            : CONTENT_SETTING_DEFAULT;
+  [self whenStarted:^(HostContentSettingsMap* settings) {
+    settings->SetContentSettingDefaultScope(
+        url, GURL(), ContentSettingsType::NOTIFICATIONS, setting);
+  }];
+}
+
++ (void)setNotificationsAsk:(BOOL)ask {
+  [self whenStarted:^(HostContentSettingsMap* settings) {
+    settings->SetDefaultContentSetting(
+        ContentSettingsType::NOTIFICATIONS,
+        ask ? CONTENT_SETTING_ASK : CONTENT_SETTING_BLOCK);
+  }];
+}
