+- (void)downloadURL:(NSURL*)url {
+  content::RenderFrameHost* frame =
+      _contents ? _contents->GetPrimaryMainFrame() : nullptr;
+  const GURL target(base::SysNSStringToUTF8(url.absoluteString));
+  if (!frame || !frame->IsActive() || !target.is_valid()) {
+    return;
+  }
+  // Save through Chromium, not a separate network session: its download target
+  // hook calls Rise's delegate, which supplies Downloads and starts the flight.
+  const content::Referrer referrer = content::Referrer::SanitizeForRequest(
+      target, content::Referrer(frame->GetLastCommittedURL().GetAsReferrer(),
+                               network::mojom::ReferrerPolicy::kDefault));
+  _contents->SaveFrameWithHeaders(target, referrer, std::string(),
+                                 std::u16string(), frame,
+                                 /*is_subresource=*/true);
+}
 
