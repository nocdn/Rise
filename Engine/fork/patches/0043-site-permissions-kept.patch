++ (void)setPermissions:(NSUInteger)permissions
+                 state:(NSInteger)state
+             forOrigin:(NSString*)origin {
+  GURL url(base::SysNSStringToUTF8(origin));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  std::vector<ContentSettingsType> types;
+  if (permissions & RCPermissionCamera) {
+    types.push_back(ContentSettingsType::MEDIASTREAM_CAMERA);
+  }
+  if (permissions & RCPermissionMicrophone) {
+    types.push_back(ContentSettingsType::MEDIASTREAM_MIC);
+  }
+  if (permissions & RCPermissionLocation) {
+    types.push_back(ContentSettingsType::GEOLOCATION);
+  }
+  if (permissions & RCPermissionNotifications) {
+    types.push_back(ContentSettingsType::NOTIFICATIONS);
+  }
+  ContentSetting setting = state > 0   ? CONTENT_SETTING_ALLOW
+                           : state < 0 ? CONTENT_SETTING_BLOCK
+                                       : CONTENT_SETTING_DEFAULT;
+  [self whenStarted:^(HostContentSettingsMap* settings) {
+    for (ContentSettingsType type : types) {
+      settings->SetContentSettingDefaultScope(url, GURL(), type, setting);
+    }
+  }];
+}
