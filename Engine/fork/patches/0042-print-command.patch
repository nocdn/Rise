+// As chrome::CanPrint and chrome::Print, for this page rather than the active tab of Chrome's
+// tab strip, which needn't be the one Rise shows.
+- (BOOL)canPrint {
+  if (!_contents || _contents->IsCrashed()) {
+    return NO;
+  }
+  PrefService* prefs =
+      Profile::FromBrowserContext(_contents->GetBrowserContext())->GetPrefs();
+  if (!prefs->GetBoolean(prefs::kPrintingEnabled)) {
+    return NO;
+  }
+  if (auto* dialogs =
+          web_modal::WebContentsModalDialogManager::FromWebContents(_contents);
+      dialogs && dialogs->IsDialogActive()) {
+    return NO;
+  }
+  CoreTabHelper* helper = CoreTabHelper::FromWebContents(_contents);
+  return !helper ||
+         !(helper->content_restrictions() & CONTENT_RESTRICTION_PRINT);
+}
+- (void)printPage {
+  if (![self canPrint]) {
+    return;
+  }
+  printing::StartPrint(
+      _contents,
+      Profile::FromBrowserContext(_contents->GetBrowserContext())
+          ->GetPrefs()
+          ->GetBoolean(prefs::kPrintPreviewDisabled),
+      /*has_selection=*/false);
+}
+- (void)printPageUsingSystemDialog {
+  if (!_contents || _contents->IsCrashed() ||
+      !Profile::FromBrowserContext(_contents->GetBrowserContext())
+           ->GetPrefs()
+           ->GetBoolean(prefs::kPrintingEnabled)) {
+    return;
+  }
+  // From the print preview too, as Chrome's command is, which hands its job to the system's.
+  printing::StartBasicPrint(_contents);
+}
