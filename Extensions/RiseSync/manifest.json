{
  "manifest_version": 3,
  "name": "Rise Tab Sync",
  "version": "1.0.0",
  "description": "Your Rise tabs, together on Mac, iPhone and this browser. Sync directly with your private iCloud account.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "identity",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.apple-cloudkit.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Rise Tab Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.apple-cloudkit.com"
  },
  "key": ""
}
