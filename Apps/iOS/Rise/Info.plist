<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSSupportsLiveActivities</key><true/>
    <key>CFBundleDisplayName</key><string>Rise</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array><dict>
                <key>UISceneConfigurationName</key><string>Default</string>
                <key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            </dict></array>
        </dict>
    </dict>
    <key>UIApplicationShortcutItems</key>
    <array>
        <dict>
            <key>UIApplicationShortcutItemType</key><string>dev.bartosz.Rise.iOS.downloads</string>
            <key>UIApplicationShortcutItemTitle</key><string>Downloads</string>
            <key>UIApplicationShortcutItemIconSymbolName</key><string>arrow.down</string>
        </dict>
        <dict>
            <key>UIApplicationShortcutItemType</key><string>dev.bartosz.Rise.iOS.history</string>
            <key>UIApplicationShortcutItemTitle</key><string>History</string>
            <key>UIApplicationShortcutItemIconSymbolName</key><string>clock.arrow.circlepath</string>
        </dict>
        <dict>
            <key>UIApplicationShortcutItemType</key><string>dev.bartosz.Rise.iOS.new-private-tab</string>
            <key>UIApplicationShortcutItemTitle</key><string>New Private Tab</string>
            <key>UIApplicationShortcutItemIconSymbolName</key><string>eye.slash</string>
        </dict>
    </array>
    <key>UILaunchScreen</key><dict/>
    <!-- Needed to be offered as the default browser, which also lets pages use passkeys. -->
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>Web site URL</string>
        <key>CFBundleURLSchemes</key><array><string>http</string><string>https</string><string>rise</string></array>
    </dict></array>
    <key>RiseCloudKitEnabled</key><true/>
    <key>UIBackgroundModes</key><array><string>remote-notification</string></array>
    <!-- Downloads land in Documents/Downloads, shown in Files under On My iPhone › Rise. -->
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <!-- Lets animations run at up to 120 Hz on ProMotion iPhones, rather than 60. -->
    <key>CADisableMinimumFrameDurationOnPhone</key><true/>
    <key>NSFaceIDUsageDescription</key><string>Face ID unlocks your incognito tabs.</string>
    <key>NSMicrophoneUsageDescription</key><string>Hold New Page to say what to search for.</string>
    <key>NSPhotoLibraryAddUsageDescription</key><string>Save images from websites to your photo library.</string>
    <key>NSRemindersFullAccessUsageDescription</key><string>Add a reminder for a date or time you selected on a web page.</string>
    <key>NSSpeechRecognitionUsageDescription</key><string>What you say while holding New Page is transcribed on your iPhone into a search.</string>
    <key>UIAppFonts</key>
    <array><string>OpenRunde-Medium.otf</string><string>OpenRunde-Semibold.otf</string></array>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
</dict>
</plist>
